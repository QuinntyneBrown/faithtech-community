    { "fg": "--color-fg-default", "bg": "--color-bg-surface-raised", "min": 4.5, "note": "body text in dialogs/menus" },
    { "fg": "--color-fg-default", "bg": "--color-bg-surface-sunken", "min": 4.5, "note": "body text in wells/table headers" },
    { "fg": "--color-fg-default", "bg": "--color-bg-subtle", "min": 4.5, "note": "text on hover rows/chips" },
    { "fg": "--color-fg-default", "bg": "--color-bg-subtle-hover", "min": 4.5, "note": "text on hovered chips" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-canvas", "min": 4.5, "note": "secondary text on page" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-surface", "min": 4.5, "note": "secondary text on cards" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-surface-raised", "min": 4.5, "note": "secondary text in dialogs" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-surface-sunken", "min": 4.5, "note": "secondary text in wells" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-subtle", "min": 4.5, "note": "secondary text on chips" },
    { "fg": "--color-fg-subtle", "bg": "--color-bg-canvas", "min": 4.5, "note": "placeholders/metadata on page" },
    { "fg": "--color-fg-subtle", "bg": "--color-bg-surface", "min": 4.5, "note": "placeholders inside inputs" },
    { "fg": "--color-fg-subtle", "bg": "--color-bg-surface-raised", "min": 4.5, "note": "metadata in dialogs" },
    { "fg": "--color-fg-inverse", "bg": "--color-bg-inverse", "min": 4.5, "note": "tooltip text" },
    { "fg": "--color-fg-link", "bg": "--color-bg-canvas", "min": 4.5, "note": "links on page" },
    { "fg": "--color-fg-link", "bg": "--color-bg-surface", "min": 4.5, "note": "links on cards" },
    { "fg": "--color-fg-link-hover", "bg": "--color-bg-surface", "min": 4.5, "note": "hovered links" },
    { "fg": "--color-fg-accent", "bg": "--color-bg-surface", "min": 4.5, "note": "accent text (selected tab label)" },
    { "fg": "--color-fg-accent", "bg": "--color-accent-subtle", "min": 4.5, "note": "accent text on selected row" },
    { "fg": "--color-fg-default", "bg": "--color-accent-subtle", "min": 4.5, "note": "body text on selected row" },
    { "fg": "--color-fg-on-accent", "bg": "--color-accent", "min": 4.5, "note": "primary button label" },
    { "fg": "--color-fg-on-accent", "bg": "--color-accent-hover", "min": 4.5, "note": "primary button label (hover)" },
    { "fg": "--color-fg-on-accent", "bg": "--color-accent-active", "min": 4.5, "note": "primary button label (active)" },
    { "fg": "--color-accent", "bg": "--color-bg-surface", "min": 3, "note": "primary button edge vs card" },
    { "fg": "--color-accent", "bg": "--color-bg-canvas", "min": 3, "note": "primary button edge vs page" },
    { "fg": "--color-border-strong", "bg": "--color-bg-surface", "min": 3, "note": "input borders (1.4.11)" },
    { "fg": "--color-border-strong", "bg": "--color-bg-canvas", "min": 3, "note": "input borders on page" },
    { "fg": "--color-focus-ring", "bg": "--color-bg-surface", "min": 3, "note": "focus ring vs card (2.4.11)" },
    { "fg": "--color-focus-ring", "bg": "--color-bg-canvas", "min": 3, "note": "focus ring vs page" },
    { "fg": "--color-fg-on-danger", "bg": "--color-danger-solid", "min": 4.5, "note": "destructive button label" },
    { "fg": "--color-fg-on-danger", "bg": "--color-danger-solid-hover", "min": 4.5, "note": "destructive button label (hover)" },
    { "fg": "--color-danger-solid", "bg": "--color-bg-surface", "min": 3, "note": "destructive button edge" },
