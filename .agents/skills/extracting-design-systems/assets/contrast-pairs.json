    { "fg": "--color-danger-fg", "bg": "--color-danger-bg", "min": 4.5, "note": "danger alert / field error text" },
    { "fg": "--color-danger-icon", "bg": "--color-danger-bg", "min": 3, "note": "danger alert icon" },
    { "fg": "--color-danger-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "field error text under input" },
    { "fg": "--color-danger-fg", "bg": "--color-bg-canvas", "min": 4.5, "note": "field error text on page" },
    { "fg": "--color-danger-solid", "bg": "--color-bg-surface", "min": 3, "note": "invalid input border" },
    { "fg": "--color-success-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "success text on cards" },
    { "fg": "--color-warning-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "warning text on cards" },
    { "fg": "--color-info-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "info text on cards" },
    { "fg": "--color-info-solid", "bg": "--color-bg-surface", "min": 3, "note": "solid info badge vs card" },
    { "fg": "--color-success-solid", "bg": "--color-bg-surface", "min": 3, "note": "solid success badge vs card" },
    { "fg": "--color-warning-solid", "bg": "--color-bg-surface", "min": 3, "note": "solid warning badge vs card" },
    { "fg": "--color-fg-inverse", "bg": "--color-info-solid", "min": 4.5, "note": "label on solid info badge", "themes": ["light"] },
    { "fg": "--color-fg-inverse", "bg": "--color-success-solid", "min": 4.5, "note": "label on solid success badge", "themes": ["light"] },
    { "fg": "--color-fg-inverse", "bg": "--color-warning-solid", "min": 4.5, "note": "label on solid warning badge", "themes": ["light"] },
    { "fg": "--color-fg-on-accent", "bg": "--color-info-solid", "min": 4.5, "note": "label on solid info badge", "themes": ["dark"] },
    { "fg": "--color-fg-on-danger", "bg": "--color-success-solid", "min": 4.5, "note": "dark label on solid success badge", "themes": ["dark"] },
    { "fg": "--color-fg-on-danger", "bg": "--color-warning-solid", "min": 4.5, "note": "dark label on solid warning badge", "themes": ["dark"] }
  ]
}
