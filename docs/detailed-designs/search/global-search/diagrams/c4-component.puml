@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Global search

Container_Boundary(spa, "Web app") {
  Component(page, "SearchPage", "Angular page (search library)", "Search box, hint, grouped results, empty state")
  Component(svc, "SearchService / SEARCH_SERVICE", "TypeScript contract and injection token (api library)", "Contract the page depends on")
  Component(http, "HttpSearchService", "Angular service (api library)", "HTTP implementation")
}
Container_Boundary(api, "Community API") {
  Component(ep, "SearchEndpoints", "ASP.NET Core minimal API", "Maps /api/search; no business logic")
  Component(h, "GlobalSearchHandler", "Application handler", "Validates 2 to 200 characters; groups results")
  Component(src, "ISearchSource x5", "Application services", "People, events, partners, contacts, work items; each starts from the organisation-scoped query and applies the caller's capabilities")
  Component(fts, "PostgresFullTextSearch", "Infrastructure IFullTextSearch", "Prefix to_tsquery over GIN-indexed tsvector, ts_rank")
  Component(ctx, "CommunityDbContext", "EF Core DbContext", "Searchable tables, scoped by the global filter on ICurrentOrganisation")
}
ContainerDb(db, "Community database", "PostgreSQL", "Profiles, events, partners, contacts, work items and full-text indexes")
Rel(page, svc, "Calls search")
Rel(svc, http, "Implemented by")
Rel(http, ep, "GET /api/search (JSON/HTTPS)")
Rel(ep, h, "SearchAsync(q)")
Rel(h, src, "SearchAsync(term, caller, 10) per source")
Rel(src, fts, "Match(permission-filtered query, term)")
Rel(src, ctx, "Queries")
Rel(ctx, db, "SQL")
@enduml
