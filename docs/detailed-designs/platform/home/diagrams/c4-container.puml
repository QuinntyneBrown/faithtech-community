@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Home
Person(member, "Member", "Signed-in profile holder")
System_Boundary(community, "FaithTech Community") {
  Container(web, "Web app", "Angular", "App shell with the home route; feature libraries lazy-loaded")
  Container(api, "Community API", "ASP.NET Core", "Events, partners and activity endpoints")
  ContainerDb(db, "Community database", "PostgreSQL", "Events, partners, notifications")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "GET /api/events, /api/partners, /api/activity", "JSON/HTTPS, OAuth2 bearer")
Rel(api, db, "Reads", "EF Core")
@enduml
