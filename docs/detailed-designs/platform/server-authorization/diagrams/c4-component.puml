@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Server authorization
Container_Boundary(api, "Community API") {
  Component(org, "OrganisationResolutionMiddleware", "ASP.NET Core middleware", "Host to ICurrentOrganisation; neutral page for unknown or suspended hosts")
  Component(auth, "Authentication and fallback policy", "ASP.NET Core middleware", "OpenIddict validation; 401 by default")
  Component(roles, "CurrentRolesMiddleware", "ASP.NET Core middleware", "Computes the caller's capabilities from current roles in the organisation")
  Component(ep, "Feature endpoints", "Minimal API", "Explicit AllowAnonymous only where listed")
  Component(cu, "ICurrentUser", "Application abstraction", "Caller id, roles and capabilities; Has(capability)")
  Component(h, "Feature handlers", "Application handlers", "Apply rules and filters")
  Component(pf, "IPermissionFilters", "Application service", "IQueryable predicates per capability")
  Component(rules, "AuthorizationRules", "Application helpers", "CanWrite and IsOverride")
  Component(map, "ResultMapper", "Api helper", "Result to 400/403/404")
  ComponentDb(db, "CommunityDbContext", "EF Core", "Filtered SQL queries under the ICurrentOrganisation global filter")
}
Rel(org, auth, "Passes resolved requests to")
Rel(auth, roles, "Admits authenticated callers to")
Rel(roles, cu, "Fills")
Rel(roles, ep, "Dispatches to")
Rel(ep, h, "Dispatches to")
Rel(h, cu, "Reads caller")
Rel(h, rules, "Checks")
Rel(h, pf, "Applies")
Rel(pf, db, "Composes WHERE clauses for")
Rel(ep, map, "Maps result with")
@enduml
