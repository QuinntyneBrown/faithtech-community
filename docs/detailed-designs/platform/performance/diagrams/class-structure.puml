@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Performance
class PageRequest {
  +int Page
  +int PageSize
  +const int MaxPageSize = 100
  +Normalize(): PageRequest
}
class "PagedResult<T>" as PagedResult {
  +IReadOnlyList<T> Items
  +int Page
  +int PageSize
  +int TotalCount
}
class QueryableExtensions {
  +ToPagedResultAsync(q: IQueryable<T>, r: PageRequest): Task<PagedResult<T>>
}
QueryableExtensions ..> PageRequest : reads
QueryableExtensions ..> PagedResult : returns
@enduml
