@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Private preview wall and deployment
Person(owner, "Owner", "Holds the passphrase; unlocks both hosts")
Person(visitor, "Any other visitor", "Sees only the wall page")
System(ftc, "FaithTech Community", "app.faithtech.community and www.faithtech.community behind the wall")
System_Ext(dns, "DNS for faithtech.community", "CNAME and asuid TXT records the owner creates")
