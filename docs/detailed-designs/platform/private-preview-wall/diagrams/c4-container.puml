@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Private preview wall and deployment
Person(owner, "Owner", "Browser holding the __Secure-unlock cookie")
System_Boundary(ftc, "Community platform on Azure Container Apps") {
  Container(api, "API container app", "ASP.NET Core, image backend/deploy/api.Dockerfile", "Private preview gate, API, identity server, SignalR hub, community app and marketing builds served by host")
  Container(cli, "Cli job", "Container Apps job, image backend/deploy/cli.Dockerfile", "migrate and seed before each rollout")
  ContainerDb(db, "Community database", "Azure Database for PostgreSQL", "Persistent community data")
  ContainerDb(blobs, "Blob storage", "Azure Storage", "Photos and resource files")
  Container(kv, "Key Vault", "Azure Key Vault", "Connection strings, certificates, SMTP, Google, passphrase hash, signing key")
}
Container_Ext(acr, "Container registry", "Azure Container Registry", "API and Cli images")
Rel(owner, api, "Each organisation's community and public host", "HTTPS, managed certificates")
Rel(api, db, "Reads and writes", "EF Core, TLS")
Rel(api, blobs, "Stores and signs URLs for")
Rel(cli, db, "Migrates and seeds", "EF Core, TLS")
Rel(api, kv, "Reads secrets", "managed identity")
Rel(cli, kv, "Reads secrets", "managed identity")
Rel(api, acr, "Pulled from", "AcrPull")
@enduml
