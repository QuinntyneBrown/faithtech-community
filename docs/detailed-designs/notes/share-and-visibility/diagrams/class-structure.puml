@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Page visibility and sharing
enum NoteVisibility {
  Private
  Shared
  Global
}
class NotePage {
  +Guid Id
  +Guid OrganisationId
  +Guid OwnerId
  +NoteVisibility Visibility
  +IReadOnlyList<NoteShareMember> SharedMembers
  +IReadOnlyList<NoteShareRole> SharedRoles
  +SetAudience(visibility, members, roles): void
}
class NoteShareMember {
  -int Id (generated key)
  +Guid PageId
  +Guid ProfileId
}
class NoteShareRole {
  -int Id (generated key)
  +Guid PageId
  +Guid RoleDefinitionId
}
class RoleDefinition {
  +Guid Id
  +Guid OrganisationId
  +string Name
  +bool IsArchived
}
NoteShareRole --> RoleDefinition
NotePage "1" *-- "*" NoteShareMember
NotePage "1" *-- "*" NoteShareRole
NotePage --> NoteVisibility
class NoteAccess {
  +ShareableRolesAsync(): Task<IReadOnlyList<RoleDefinition>>
  +bool IsAdministrator
  +Visible(pages, caller): IQueryable<NotePage>
  +FindAsync(id, caller): Task<NotePage?>
  +CanChange(page, caller): bool
  +IsOverride(page, caller): bool
  +VerifiedAsync(caller): Task<Result?>
}
interface ICurrentUser {
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface ICurrentOrganisation {
  +Guid Id
}
NoteAccess ..> ICurrentUser : Has(AdministerOrganisation), held roles
NoteAccess ..> ICurrentOrganisation : query filter
class ShareNoteCommand <<record>> {
  +string? Visibility
  +IReadOnlyList<Guid>? MemberIds
  +IReadOnlyList<Guid>? RoleIds
}
class ShareNoteHandler {
  +AudienceMessage = "Choose at least one person or role, or pick another visibility."
  +HandleAsync(id, command): Task<(Result, NotePageDto?)>
}
class NoteShareNotifier {
  +RecipientsAsync(page): Task<IReadOnlyCollection<Guid>>
  +NotifyAsync(page, actor, alreadyReached): Task
}
interface INotificationPublisher {
  +PublishAsync(recipientIds, kind, title, linkPath, actorId, email): Task<int>
}
enum NotificationKind {
  ...
  ResourceShared
  ResourceOwnershipTransferred
  NotePageShared
}
class NoteMembersHandler {
  +Limit = 10
  +HandleAsync(q): Task<IReadOnlyList<NoteMemberDto>>
}
class NoteAudienceDto <<record>> {
  +IReadOnlyList<NoteAudienceMemberDto> Members
  +IReadOnlyList<NoteAudienceRoleDto> Roles (role, count)
}
class NoteMemberDto <<record>> {
  +Guid Id
  +string Name
  +string? Chapter
  +IReadOnlyList<string> Roles
}
class NotePageDto <<record>> {
  +string Visibility
  +string? SharedVia
  +NoteAudienceDto Audience
  +bool IsAdminView
}
NotePageDto *-- NoteAudienceDto
NoteMembersHandler ..> NoteMemberDto
ShareNoteHandler ..> ShareNoteCommand
ShareNoteHandler --> NoteAccess
ShareNoteHandler --> NotePage : SetAudience
ShareNoteHandler --> NoteShareNotifier
ShareNoteHandler ..> NotePageDto
NoteShareNotifier --> INotificationPublisher
NoteShareNotifier ..> NotificationKind : NotePageShared
interface IAuditLog {
  +Record(actorId, action, targetType, targetId, before, after): void
}
ShareNoteHandler --> IAuditLog : note.shared on override
@enduml
