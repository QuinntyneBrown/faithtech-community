@startuml
title UML sequence behaviour — Share a page and notify new recipients
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — FaithTech Community web app (notes library)" #E0F2FE
  participant "ShareNoteDialog" as dlg
  participant "HttpNotesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ShareNoteHandler" as h
  participant "NoteShareNotifier" as n
  participant "INotificationPublisher" as pub
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> dlg : Share → Shared; pick Hannah Kim; tick Volunteer; Save
dlg -> svc : share(id, { visibility: Shared, memberIds, roles })
svc -> ep : PUT /api/notes/{id}/visibility
ep -> h : HandleAsync(id, request)
h -> db : NoteAccess.FindAsync
alt not visible
  ep --> svc : 404
else visible, caller is not owner or System Admin (re-share)
  ep --> svc : 403 (L2-093)
else Shared with no member and no role, unknown member or role not offered
  ep --> svc : 400 "Choose at least one person or role, or pick another visibility."
else may change
  h -> n : before = RecipientsAsync(page)
  h -> h : page.SetAudience(Shared, members, roles)
  h -> n : NotifyAsync(page, actor, alreadyReached: before)
  n -> db : Named members + current holders of named roles,\nminus owner and suspended
  n -> pub : PublishAsync(new recipients, NotePageShared,\n"{Owner} shared {title} with you", /notes/{id}, owner, email)
  opt System Admin override (L2-098)
    h -> h : IAuditLog.Record(note.shared, before audience, after audience)
  end
  h -> db : One save: audience, notifications, outbox, audit
  ep --> svc : 200 NoteAudienceDto
  dlg --> actor : Close; toast "Shared"; page lists the audience
end
note over db
  Shared → Private or Global clears the audience and notifies nobody.
  The NotePageShared email is always sent (no opt-out).
end note
@enduml
