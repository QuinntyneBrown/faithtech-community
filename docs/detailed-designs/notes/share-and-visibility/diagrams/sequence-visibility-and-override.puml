@startuml
title UML sequence behaviour — Visibility on the server and the administrator override
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Caller" as actor
box "Frontend — Community web app (notes library)" #E0F2FE
  participant "NotePage" as page
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetNoteHandler / SaveNoteHandler" as h
  participant "NoteAccess" as acc
  participant "IAuditLog" as audit
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /notes/{id}
page -> ep : GET /api/notes/{id}
alt anonymous
  ep --> page : 401 (authentication required by default)
else signed in
  ep -> h : HandleAsync(id)
  h -> acc : FindAsync(id, caller)
  acc -> db : WHERE ArchivedAt IS NULL AND (Global OR OwnerId = caller\nOR member row for caller OR role row in caller's roles now)\n— Has(AdministerOrganisation) skips the predicate (L2-092)
  alt no row (no capability but AdministerOrganisation reads all, L2-092 AC10)
    ep --> page : 404
  else row
    opt AdministerOrganisation override: not owner, page Private, Shared or archived
      h -> audit : note.opened
    end
    ep --> page : 200 NotePageDto { canEdit = owner or Has(AdministerOrganisation), isAdminView }
  end
end
actor -> page : Edits (owner, or an administrator on someone else's page)
page -> ep : PUT /api/notes/{id}
ep -> h : SaveNoteHandler
h -> acc : CanChange(page, caller)
alt reader who is not the owner, whatever capabilities (L2-098 AC2)
  ep --> page : 403
else owner
  h -> db : Save
else AdministerOrganisation override (IsOverride, L2-135 AC5)
  h -> audit : note.edited { before version, after version, title }
  h -> db : Save with the audit entry
end
@enduml
