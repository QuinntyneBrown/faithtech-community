@startuml
title UML sequence behaviour — Add an image block
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — FaithTech Community web app (notes library)" #E0F2FE
  participant "AddImageDialog" as dlg
  participant "NotePage" as page
  participant "HttpNotesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "NoteImagesHandler" as h
  participant "NoteBlocksValidator" as val
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AzureBlobFileStorage" as fs
  database "Community database" as db
end box
actor -> dlg : "/image" → Add an image: choose file, "Describe this image"
alt no alt text
  dlg --> actor : "Describe this image" error (L2-097)
else wrong type or over 5 MB (checked in the browser first)
  dlg --> actor : "Choose a JPEG, PNG or WebP image of 5 MB or less."
else valid
  dlg -> svc : uploadImage(id, file)
  svc -> ep : POST /api/notes/{id}/images (multipart file)
  ep -> h : UploadAsync(id, file)
  alt not visible
    ep --> svc : 404
  else not owner or System Admin
    ep --> svc : 403
  else over 5 MB or magic bytes not JPEG / PNG / WebP
    ep --> svc : 400 ValidationProblem
  else ok
    h -> fs : SaveAsync("notes/{pageId}/{imageId}.{ext}", stream, contentType)
    alt storage fails
      ep --> svc : 503 "We couldn't upload the image. Try again."
    else stored
      h -> db : page.AddImage(NoteImage); save (Version unchanged)
      ep --> svc : 201 NoteImageDto
      dlg -> page : close({ imageId, alt })
      page -> page : editor.insertBlock(i, { type: image, imageId, alt })
      page -> ep : PUT /api/notes/{id} (autosave)
      ep -> val : ImageId in page.Images; alt 1..250 characters, else 400
    end
  end
end
@enduml
