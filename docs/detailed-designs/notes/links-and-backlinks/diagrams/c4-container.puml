@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Page links, backlinks and nesting
Person(member, "Member", "Owner or reader")
System_Boundary(community, "Community platform") {
  Container(web, "Web app", "Angular", "ft-slash-menu ([[), ft-page-links, ft-breadcrumb, move-note dialog")
  Container(api, "Community API", "ASP.NET Core", "GetNoteHandler, NoteRefs, LinkSuggestionsHandler, ParentOptionsHandler, MoveNoteHandler, SaveNoteHandler")
  ContainerDb(db, "Community database", "PostgreSQL", "NotePages.ParentId, NoteLinks (SourceId, TargetId)")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "GET /api/notes/links, GET /api/notes/{id}/parent-options, PUT /api/notes/{id}/parent, GET /api/notes/{id}", "JSON/HTTPS")
Rel(api, db, "Visible-only joins over links and parents", "EF Core")
@enduml
