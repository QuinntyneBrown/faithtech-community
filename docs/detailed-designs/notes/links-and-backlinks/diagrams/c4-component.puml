@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Page links, backlinks and nesting
Container_Boundary(web, "Web app") {
  Component(ed, "ft-block-editor + ft-slash-menu", "components library", "'[[' opens the Link to a page suggestions")
  Component(page, "NotePage", "Angular page (notes library)", "Breadcrumb, Pages inside and Linked from (ft-page-links)")
  Component(move, "MoveNoteDialog", "CDK dialog (notes library)", "Search your pages; choose a parent or Top level")
  Component(svc, "HttpNotesService", "api library", "linkSuggestions, parentOptions, move, get")
}
Container_Boundary(api, "Community API") {
  Component(ep, "NotesEndpoints", "ASP.NET Core minimal API", "/links, /{id}/parent-options, /{id}/parent")
  Component(sug, "LinkSuggestionsHandler", "Application handler", "Visible pages by title, at most 10")
  Component(opt, "ParentOptionsHandler", "Application handler", "Owner's active pages outside the subtree, at most 50")
  Component(get, "GetNoteHandler + NoteRefs", "Application handler and service", "Fills link text, breadcrumb, children, backlinks")
  Component(mv, "MoveNoteHandler", "Application handler", "Same owner, active, no cycle")
  Component(save, "SaveNoteHandler", "Application handler", "New links only to visible pages; rebuilds NoteLinks")
  Component(acc, "NoteAccess", "Application permission rule", "Visible")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "NotePages, NoteLinks")
}
Rel(ed, svc, "pageSearch(q) via NotePage")
Rel(move, svc, "parentOptions, move")
Rel(page, svc, "get")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, sug, "Calls")
Rel(ep, get, "Calls")
Rel(ep, mv, "Calls")
Rel(ep, opt, "Calls")
Rel(sug, acc, "Visible")
Rel(get, acc, "Visible (targets, ancestors, children, sources)")
Rel(save, acc, "Visible (new link targets)")
Rel(save, db, "Remove old, add new NoteLinks for the source")
Rel(mv, db, "ParentId")
@enduml
