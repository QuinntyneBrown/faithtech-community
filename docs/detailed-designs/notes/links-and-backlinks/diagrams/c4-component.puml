@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Page links, backlinks and nesting
Container_Boundary(web, "Web app") {
  Component(ed, "ft-block-editor + ft-page-link-menu", "components library", "'[[' opens visible-page autocomplete")
  Component(page, "NotePage", "Angular page (notes library)", "Breadcrumb, Pages inside, Linked from (ft-backlinks)")
  Component(move, "MoveNoteDialog", "CDK dialog (notes library)", "Choose a parent or Top level")
  Component(svc, "HttpNotesService", "api library", "linkSuggestions, parentOptions, move, get")
}
Container_Boundary(api, "Community API") {
  Component(ep, "NotesEndpoints", "ASP.NET Core minimal API", "/links, /{id}/parent-options, /{id}/parent")
  Component(sug, "NoteLinkSuggestionsHandler", "Application handler", "Visible pages by title, at most 8")
  Component(get, "GetNoteHandler", "Application handler", "Fills link text, breadcrumb, children, backlinks")
  Component(mv, "MoveNoteHandler", "Application handler", "Same owner, not archived, no cycle")
  Component(save, "SaveNoteHandler", "Application handler", "Rebuilds NoteLinks from page-link spans")
  Component(acc, "NoteAccess", "Application permission rule", "Visible")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "NotePages, NoteLinks")
}
Rel(ed, svc, "pageLinkSearch(q)")
Rel(move, svc, "parentOptions, move")
Rel(page, svc, "get")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, sug, "Calls")
Rel(ep, get, "Calls")
Rel(ep, mv, "Calls")
Rel(sug, acc, "Visible")
Rel(get, acc, "Visible (targets, ancestors, children, sources)")
Rel(save, db, "Delete + insert NoteLinks for the source")
Rel(mv, db, "ParentId")
@enduml
