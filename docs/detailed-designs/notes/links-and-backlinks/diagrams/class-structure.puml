@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Page links, backlinks and nesting
class NotePage {
  +Guid Id
  +Guid OwnerId
  +Guid? ParentId
  +string Title
  +MoveTo(parentId: Guid?, by, now): void
}
class NoteLink {
  +Guid SourceId
  +Guid TargetId
}
NotePage "1" o-- "0..*" NotePage : parent of
NoteLink --> NotePage : SourceId
NoteLink --> NotePage : TargetId
class NoteSpan <<record>> {
  +string Text
  +Guid? PageId
  +bool? CanOpen
}
class NoteCrumbDto <<record>> {
  +Guid? Id
  +string Title
  +bool CanOpen
}
class NoteRefDto <<record>> {
  +Guid Id
  +string Title
  +string? Icon
}
class NoteLinkOptionDto <<record>> {
  +Guid Id
  +string Title
  +string? Icon
  +string OwnerName
}
class NoteLinkResolver {
  +{static} PrivateTitle = "Private page"
  +FillAsync(blocks, caller): Task<IReadOnlyList<NoteBlock>>
  +BreadcrumbAsync(page, caller): Task<IReadOnlyList<NoteCrumbDto>>
  +ChildrenAsync(page, caller): Task<IReadOnlyList<NoteRefDto>>
  +BacklinksAsync(page, caller): Task<IReadOnlyList<NoteRefDto>>
}
class NoteLinkSuggestionsHandler {
  +MaxResults = 8
  +HandleAsync(q, exclude): Task<IReadOnlyList<NoteLinkOptionDto>>
}
class MoveNoteHandler {
  +OptionsAsync(id, q): Task<(Result, IReadOnlyList<NoteRefDto>?)>
  +HandleAsync(id, parentId): Task<(Result, NotePageDto?)>
  -IsDescendantAsync(candidate, page): Task<bool>
}
class NoteAccess {
  +Visible(pages, caller): IQueryable<NotePage>
}
NoteLinkResolver --> NoteAccess
NoteLinkResolver ..> NoteCrumbDto
NoteLinkResolver ..> NoteRefDto
NoteLinkResolver ..> NoteSpan : fills Text, CanOpen
NoteLinkSuggestionsHandler --> NoteAccess
NoteLinkSuggestionsHandler ..> NoteLinkOptionDto
MoveNoteHandler --> NotePage : MoveTo
class GetNoteHandler
GetNoteHandler --> NoteLinkResolver
class SaveNoteHandler
SaveNoteHandler ..> NoteLink : rebuilds
@enduml
