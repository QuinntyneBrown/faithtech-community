@startuml
title UML sequence behaviour — Insert a page link with [[
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — FaithTech Community web app (components library)" #E0F2FE
  participant "BlockEditorComponent" as ed
  participant "SlashMenuComponent\n(Link to a page)" as plm
end box
box "Frontend — FaithTech Community web app (notes library and api library)" #E0F2FE
  participant "NotePage" as page
  participant "HttpNotesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "LinkSuggestionsHandler" as h
  participant "SaveNoteHandler" as save
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> ed : Types "[[run"
ed -> page : pageSearch("run") (input function)
page -> svc : linkSuggestions("run", exclude: id)
svc -> ep : GET /api/notes/links?q=run&exclude={id}
ep -> h : HandleAsync("run", id)
h -> db : NoteAccess.Visible (active only), title contains "run",\nmost recently edited first, at most 10
ep --> svc : 200 [NotePageRefDto]
ed -> plm : options
plm --> actor : "📋 Builders Night run sheet"
actor -> plm : Enter
plm -> ed : chosen(pageId)
ed -> ed : Replace "[[run" with span { text: title, pageId } (L2-090)
ed -> page : blocksChange(blocks)
page -> ep : PUT /api/notes/{id} (autosave)
ep -> save : HandleAsync
alt new target the saver may not open, or no such page
  ep --> page : 400 "Link to a page you can open."
else allowed
  save -> save : Store pageId spans with text ""
  save -> db : Remove NoteLinks no longer linked;\nadd new existing targets, not self
end
@enduml
