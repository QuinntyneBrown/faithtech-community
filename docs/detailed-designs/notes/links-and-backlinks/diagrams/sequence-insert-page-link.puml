@startuml
title UML sequence behaviour — Insert a page link with [[
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — FaithTech Community web app (components library)" #E0F2FE
  participant "BlockEditorComponent" as ed
  participant "PageLinkMenuComponent" as plm
end box
box "Frontend — FaithTech Community web app (notes library and api library)" #E0F2FE
  participant "NotePage" as page
  participant "HttpNotesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "NoteLinkSuggestionsHandler" as h
  participant "SaveNoteHandler" as save
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> ed : Types "[[run"
ed -> page : pageLinkSearch("run") (input function)
page -> svc : linkSuggestions("run", exclude: id)
svc -> ep : GET /api/notes/links?q=run&exclude={id}
ep -> h : HandleAsync("run", id)
h -> db : NoteAccess.Visible, not archived, title contains "run", at most 8
ep --> svc : 200 [NoteLinkOptionDto]
ed -> plm : options
plm --> actor : "Builders Night run sheet · Ana Silva"
actor -> plm : Enter
plm -> ed : picked(option)
ed -> ed : Replace "[[run" with span { text: title, pageId } (L2-090)
ed -> page : changes(blocks)
page -> ep : PUT /api/notes/{id} (autosave)
ep -> save : HandleAsync
save -> save : Strip span text for pageId spans (stored as "")
save -> db : Delete NoteLinks where SourceId = id;\ninsert distinct existing targets, not self
@enduml
