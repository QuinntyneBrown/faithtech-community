@startuml
title UML sequence behaviour — Open a page (editor or read-only view)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member or administrator" as actor
box "Frontend — Community web app (notes library)" #E0F2FE
  participant "NotePage" as page
  participant "HttpNotesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetNoteHandler" as h
  participant "NoteAccess" as acc
  participant "IAuditLog" as audit
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /notes/{id}
page --> actor : "Notes › Loading" and a skeleton
page -> svc : get(id)
svc -> ep : GET /api/notes/{id}
ep -> h : HandleAsync(id)
h -> acc : FindAsync(id, caller)
acc -> db : Visible page, or archived for owner / AdministerOrganisation
alt missing, archived or not visible (L2-092)
  ep --> svc : 404
  page --> actor : "This page isn't available" and "Browse notes"
else found
  opt AdministerOrganisation override opens a Private, Shared or archived page they do not own (L2-098, L2-135 AC5)
    h -> audit : Record(note.opened, NotePage, id)
    h -> db : Save the audit entry
  end
  h -> db : NoteViews.DetailAsync: owner, audience, breadcrumb,\nchildren, backlinks, page-link titles (NoteRefs)
  h -> h : canEdit = owner or Has(AdministerOrganisation); isAdminView
  ep --> svc : 200 NotePageDto
  alt canEdit and not archived
    page --> actor : Editable title, icon and ft-block-editor
  else reader
    page --> actor : Read-only view (ft-block-editor readonly)\nand the banner that applies
  end
end
@enduml
