@startuml
title UML sequence behaviour — Open a page (editor or read-only view)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member or System Admin" as actor
box "Frontend — FaithTech Community web app (notes library)" #E0F2FE
  participant "NotePage" as page
  participant "HttpNotesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetNoteHandler" as h
  participant "NoteAccess" as acc
  participant "IAuditLog" as audit
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /notes/{id}
page --> actor : "Notes › Loading" and a skeleton
page -> svc : get(id)
svc -> ep : GET /api/notes/{id}
ep -> h : HandleAsync(id)
h -> acc : FindAsync(id, caller)
acc -> db : Visible page, or archived for owner / System Admin
alt missing, archived or not visible (L2-092)
  ep --> svc : 404
  page --> actor : "This page isn't available" and "Back to Notes"
else found
  opt System Admin opens a Private or Shared page they do not own (L2-098)
    h -> audit : Record(note.opened, NotePage, id)
    h -> db : Save the audit entry
  end
  h -> db : Owner, breadcrumb, children, backlinks, page-link titles
  h -> h : canEdit = owner or System Admin, and not archived
  ep --> svc : 200 NotePageDto
  alt canEdit
    page --> actor : Editable title, icon and ft-block-editor
  else reader
    page --> actor : Read-only view (ft-block-editor readonly)
  end
end
@enduml
