@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Notes pages and list
enum NoteVisibility {
  Private
  Shared
  Global
}
class NotePage {
  +{static} MaxTitle = 200
  +{static} MaxIcon = 16
  +Guid Id
  +Guid OrganisationId
  +string Title
  +string? Icon
  +Guid OwnerId
  +Guid? ParentId
  +NoteVisibility Visibility
  +string Content
  +string BodyText
  +int Version
  +DateTimeOffset CreatedAt
  +DateTimeOffset UpdatedAt
  +Guid UpdatedById
  +DateTimeOffset? ArchivedAt
  +NotePage(ownerId, title, parentId, now)
  +Save(title, icon, content, bodyText, by, now): void
  +Touch(by, now): void
}
NotePage --> NoteVisibility
class NoteAccess {
  +bool IsAdministrator
  +IReadOnlySet<Guid> HeldRoleIds
  +CallerAsync(): Task<Guid>
  +VerifiedAsync(caller): Task<Result?>
  +Visible(pages, caller): IQueryable<NotePage>
  +FindAsync(id, caller): Task<NotePage?>
  +CanChange(page, caller): bool
  +IsOverride(page, caller): bool
}
interface ICurrentUser {
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface ICurrentOrganisation {
  +Guid Id
}
NoteAccess ..> ICurrentUser : Has(AdministerOrganisation), held roles
NoteAccess ..> ICurrentOrganisation : query filter
class NoteViews {
  +DetailAsync(page, caller): Task<NotePageDto>
  +SummariesAsync(pages, caller): Task<IReadOnlyList<NotePageSummaryDto>>
}
class ListNotesHandler {
  +PageSize = 25
  +{static} Document: Expression<Func<NotePage, string>>
  +HandleAsync(query: ListNotesQuery): Task<(Result, PagedResult<NotePageSummaryDto>?)>
}
class ListNotesQuery <<record>> {
  +string? Q
  +string? Owner  (all | mine | shared)
  +int Page
}
class CreateNoteCommand <<record>> {
  +string? Title
  +Guid? ParentId
}
class CreateNoteHandler {
  +HandleAsync(command: CreateNoteCommand): Task<(Result, NotePageDto?)>
}
class GetNoteHandler {
  +HandleAsync(id: Guid): Task<NotePageDto?>
}
class SaveNoteHandler {
  +ConflictMessage = "This page changed somewhere else."
  +HandleAsync(id: Guid, command: SaveNoteCommand): Task<(Result, NoteSavedDto?)>
}
class SaveNoteCommand <<record>> {
  +string? Title
  +string? Icon
  +IReadOnlyList<NoteBlock>? Blocks
  +int Version
}
class NoteSavedDto <<record>> {
  +int Version
  +DateTimeOffset UpdatedAt
}
class NotePageSummaryDto <<record>> {
  +Guid Id
  +string Title
  +string? Icon
  +Guid OwnerId
  +string OwnerName
  +bool IsOwn
  +string Visibility
  +bool SharedWithYou
  +DateTimeOffset UpdatedAt
  +string UpdatedByName
  +string? ParentTitle
}
class NotePageDto <<record>> {
  +(every summary field)
  +Guid? ParentId
  +string? SharedVia
  +NoteAudienceDto Audience
  +IReadOnlyList<NoteBlock> Blocks
  +int Version
  +DateTimeOffset CreatedAt
  +DateTimeOffset? ArchivedAt
  +bool CanEdit
  +bool IsAdminView
  +IReadOnlyList<NotePageRefDto> Breadcrumb
  +IReadOnlyList<NotePageRefDto> Children
  +IReadOnlyList<NotePageRefDto> Backlinks
  +IReadOnlyList<NotePageRefDto> Links
}
class NoteBlocksValidator <<static>> {
  +Check(blocks, images): Dictionary<string, string[]>
  +BodyText(blocks): string
}
class "NoteAutosave (TypeScript)" as NoteAutosave {
  +state: signal<unsaved | saving | saved | failed>
  +stopped: signal<conflict | forbidden | missing | null>
  +changed(): void
  +retry(): void
  +reset(version): void
  +cancel(): void
}
ListNotesHandler ..> ListNotesQuery
ListNotesHandler --> NoteAccess : Visible
ListNotesHandler --> NoteViews : SummariesAsync
CreateNoteHandler ..> CreateNoteCommand
CreateNoteHandler --> NoteAccess : VerifiedAsync, FindAsync
GetNoteHandler --> NoteAccess : FindAsync
GetNoteHandler --> NoteViews : DetailAsync
NoteViews ..> NotePageDto
NoteViews ..> NotePageSummaryDto
SaveNoteHandler --> NoteAccess : CanChange, IsOverride
SaveNoteHandler --> NoteBlocksValidator
SaveNoteHandler ..> SaveNoteCommand
SaveNoteHandler ..> NoteSavedDto
SaveNoteHandler --> NotePage : Save
NoteAutosave ..> SaveNoteCommand : sends as JSON
@enduml
