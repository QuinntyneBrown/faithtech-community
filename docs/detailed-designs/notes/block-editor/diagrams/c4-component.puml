@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Block editor
Container_Boundary(web, "Web app") {
  Component(page, "NotePage", "Angular page (notes library)", "Hosts the editor, opens add-image, add-link and add-link-card dialogs")
  Component(ed, "BlockEditorComponent", "ft-block-editor (components)", "Blocks in, changes out; one contenteditable per text block")
  Component(ser, "RichTextSerializer", "TypeScript (components)", "DOM <-> NoteSpan[]")
  Component(md, "MarkdownShortcuts", "TypeScript (components)", "Turns '# ', '- ', '1. ', '[] ', '> ', '```', '---' into block types")
  Component(slash, "SlashMenuComponent", "ft-slash-menu (CDK Overlay)", "Filterable list of block types")
  Component(fmt, "FormatToolbarComponent", "ft-format-toolbar (CDK Overlay)", "Bold, Italic, Underline, Strike, Code, Link")
  Component(menu, "ft-menu (block menu)", "CDK Menu (components)", "Turn into, Move up, Move down, Duplicate, Delete")
  Component(dd, "CDK drag-drop", "@angular/cdk/drag-drop", "cdkDropList, cdkDrag, cdkDragHandle, placeholder as drop indicator")
  Component(live, "LiveAnnouncer", "@angular/cdk/a11y", "Moved {block} to position {n} of {total}")
}
Container_Boundary(api, "Community API") {
  Component(val, "NoteBlocksValidator", "Application service", "Types, limits, hrefs, alt text")
}
Rel(page, ed, "blocks, readonly, pageLinkSearch, imageSrc")
Rel(ed, page, "changes, linkRequested, imageRequested, linkCardRequested")
Rel(ed, ser, "Reads and writes spans")
Rel(ed, md, "On space or Enter at block start")
Rel(ed, slash, "Opens on '/'")
Rel(ed, fmt, "Opens on a selection")
Rel(ed, menu, "Opens from the handle")
Rel(ed, dd, "Reorders by handle")
Rel(ed, live, "Announces moves")
Rel(page, val, "Saved blocks checked by", "PUT /api/notes/{id}")
@enduml
