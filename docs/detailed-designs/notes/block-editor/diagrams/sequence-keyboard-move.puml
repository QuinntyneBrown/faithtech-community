@startuml
title UML sequence behaviour — Move a block with the keyboard (WCAG 2.5.7)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Keyboard or screen-reader user" as actor
box "Frontend — FaithTech Community web app (components library)" #E0F2FE
  participant "BlockEditorComponent" as ed
  participant "ft-menu (block menu)" as menu
  participant "LiveAnnouncer" as live
end box
box "Frontend — FaithTech Community web app (notes library)" #E0F2FE
  participant "NotePage" as page
end box
alt Alt+Shift+ArrowDown in a block
  actor -> ed : Alt+Shift+ArrowDown
  ed -> ed : moveBlock(i, i + 1); focus and caret follow the block
else block menu
  actor -> ed : Tab to the handle "Block options: Heading 2, 2 of 9"; Enter
  ed -> menu : Open (CDK Menu): Turn into, Move up, Move down, Duplicate, Delete
  actor -> menu : Move down
  menu -> ed : moveBlock(i, i + 1); focus returns to the handle
end
alt already last (or first for up)
  ed -> live : "Heading 2 is already at position 9 of 9"
else moved
  ed -> live : "Moved Heading 2 to position 3 of 9" (polite)
  ed -> page : changes(blocks)
end
@enduml
