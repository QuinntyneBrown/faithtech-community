@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send an invite

Person(lead, "Lead", "Holder of a lead role")
Person(admin, "System Admin", "Holder of the System Admin role")
System_Boundary(ftc, "FaithTech Community") {
  Container(spa, "Web app", "Angular", "Shell, invites feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Accounts, profiles, invites and audit log")
}
System_Ext(email, "Email provider", "SMTP or SendGrid")
Rel(lead, spa, "Uses", "HTTPS")
Rel(admin, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, email, "Sends email via", "SMTP/HTTPS")
@enduml
