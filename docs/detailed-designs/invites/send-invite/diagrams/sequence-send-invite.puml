@startuml
title UML sequence behaviour — send an invite
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead" as actor
box "Frontend — FaithTech Community web app (invites library)" #E0F2FE
  participant "SendInviteDialog" as dlg
end box
box "Frontend — FaithTech Community web app (api library)" #E0F2FE
  participant "HttpInvitesService" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "InvitesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "InviteSender" as h
  participant "RoleAssignmentPolicy" as rp
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
participant "Email provider" as mail
actor -> dlg : Enter email, optional role and note
dlg -> dlg : Offer only assignableRoles (L2-010 AC2, L2-009)
dlg -> client : sendInvite({ email, preassignedRole, note })
client -> ep : POST /api/invites (HANDLES_FORBIDDEN)
ep -> ep : SendInviteValidator (400 on a bad email or long note)
ep -> h : SendAsync(SendInviteCommand)
alt caller holds no lead role and is not System Admin
  h --> ep : Forbidden
  ep --> client : 403 (L2-010 AC3)
else sender's email not verified
  h -> db : Load sender profile and account
  h --> ep : Forbidden "Verify your email before sending invites."
  ep --> client : 403
else role not grantable by caller
  h -> rp : CanChange(role)
  rp --> h : false
  h --> ep : Forbidden "You can’t give that role."
  ep --> client : 403 (L2-010 AC2)
else 50 or more invites in 24 hours
  h -> db : Count sender's invites in the last 24 hours
  h --> ep : Too many requests
  ep --> client : 429 with rate-limit message (L2-010 AC6)
else permitted
  h -> h : InviteTokens.New() and Hash(token)
  h -> db : Save invite with token hash, expiry in 14 days (L2-010 AC1)
  h -> mail : Send single-use link /accept-invite/{token}
  h --> ep : InviteDto
  ep --> client : 201 Created
  client --> dlg : InviteDto
  dlg --> actor : Close; page shows pending invite and toast
end
note over client, dlg
  A 403 or 429 refusal shows "You can’t send this invite"
  with the server's detail in the dialog.
end note
@enduml
