@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send an invite

Container(spa, "Web app", "Angular", "InvitesPage and SendInviteDialog (invites library); HttpInvitesService (api library)")
Container_Boundary(api, "Community API") {
  Component(ep, "InvitesEndpoints", "Minimal API", "POST/GET /api/invites, POST /api/invites/{id}/resend and /revoke")
  Component(sh, "InviteSender", "Application service", "SendAsync, CreateAsync: authorizes, rate-limits, creates invite")
  Component(mh, "ManageInvitesHandler", "Application handler", "ListAsync, ResendAsync, RevokeAsync")
  Component(rp, "RoleAssignmentPolicy", "Application permission check", "CanChange(role) per L2-009")
  Component(tok, "InviteTokens", "Application helper", "New token, SHA-256 hash")
  Component(es, "IEmailSender", "Application abstraction", "Sends invite email")
  ComponentDb(db, "CommunityDbContext", "EF Core / PostgreSQL", "Invites")
}
System_Ext(email, "Email provider", "SMTP or SendGrid")
Rel(spa, ep, "Calls", "JSON/HTTPS")
Rel(ep, sh, "SendAsync(SendInviteCommand)")
Rel(ep, mh, "ListAsync / ResendAsync / RevokeAsync")
Rel(mh, sh, "CanInvite; CreateAsync on resend")
Rel(sh, rp, "Checks role")
Rel(sh, tok, "Creates token and hash")
Rel(sh, db, "Counts and saves invites")
Rel(sh, es, "Sends email")
Rel(mh, db, "Reads and updates invites")
Rel(es, email, "Delivers via")
@enduml
