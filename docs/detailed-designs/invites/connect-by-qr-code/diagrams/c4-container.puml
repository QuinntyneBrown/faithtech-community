@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Connect by QR code
Person(lead, "City Lead", "Shows the QR code")
Person(visitor, "New person", "Opens /meet/{token}")
System_Boundary(community, "FaithTech Community") {
  Container(web, "Web app", "Angular", "Invites feature library (MyQrCodeDialog, ConnectPage), api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "ConnectLinks, PendingConnections, profiles, contacts, notifications")
}
System_Ext(email, "Email provider", "SMTP/SendGrid")
Rel(lead, web, "Uses", "HTTPS")
Rel(visitor, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS; bearer token, or anonymous for lookup and sign-up")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, email, "Sends verification and notification email via", "SMTP/SendGrid")
@enduml
