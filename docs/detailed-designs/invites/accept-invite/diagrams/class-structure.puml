@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Accept an invite

class AcceptInviteCommand <<record>> {
  +string? Token
  +string? Name
  +string? Password
  +bool IsNewAccount
}
class AcceptInviteValidator {
}
class InviteLookupDto <<record>> {
  +string Status
  +string Email
  +string InviterName
  +string? InviterChapter
  +string? PreassignedRoleName
  +bool HasAccount
}
class AcceptInviteHandler {
  +LookUpAsync(token: string): Task<InviteLookupDto?>
  +AcceptAsync(command: AcceptInviteCommand): Task<Result>
}
class InviteTokens <<static>> {
  +Hash(token: string): string
}
class Invite {
  +string Email
  +string TokenHash
  +Guid OrganisationId
  +Guid? PreassignedRoleId
  +Guid InvitedBy
  +Guid? AcceptedBy
  +Status(now: DateTimeOffset): InviteStatus
  +MarkAccepted(by: Guid, now: DateTimeOffset): void
}
class CommunityUser {
  +Guid Id
  +string Email
  +bool EmailConfirmed
}
class Profile {
  +Guid Id
  +Guid OrganisationId
  +Guid UserId
  +string Name
  +HoldsRole(roleDefinitionId: Guid): bool
  +AddRole(roleDefinitionId: Guid, chapterId: Guid?, grantedBy: Guid, nowUtc: DateTime): void
}
class RoleDefinition {
  +Guid Id
  +string Name
  +IReadOnlySet<string> Capabilities
}
class Notification {
  +Guid RecipientId
  +NotificationKind Kind
  +string Title
  +string LinkPath
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
interface ICurrentUser {
  +Guid? UserId
  +bool IsAuthenticated
}
interface ICurrentOrganisation {
  +Guid Id
}
AcceptInviteValidator ..> AcceptInviteCommand : validates
AcceptInviteHandler ..> AcceptInviteCommand : handles
AcceptInviteHandler ..> InviteLookupDto : returns
AcceptInviteHandler ..> InviteTokens : hashes token
AcceptInviteHandler --> Invite : accepts
AcceptInviteHandler --> CommunityUser : creates or loads
AcceptInviteHandler --> Profile : creates in inviter's organisation; grants role
Profile --> RoleDefinition : holds
AcceptInviteHandler ..> IAuditLog : role.granted, inviter as actor
AcceptInviteHandler ..> Notification : InviteAccepted for inviter
AcceptInviteHandler ..> ICurrentUser
AcceptInviteHandler ..> ICurrentOrganisation
CommunityUser "1" --> "*" Profile : one per organisation
@enduml
