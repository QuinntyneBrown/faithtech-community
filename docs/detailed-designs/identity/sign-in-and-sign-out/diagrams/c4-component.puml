@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in and sign out

Container(spa, "Web app", "Angular", "faithtech-community feature library and api client")
Container_Boundary(api, "Community API") {
  Component(ep, "AuthorizationEndpoints", "Minimal API + OpenIddict", "/connect/authorize, /token, /revoke, /logout")
  Component(h, "SignInHandler", "Application handler", "Credentials, lockout, suspension, verification")
  Component(oi, "OpenIddict server", "OpenIddict", "Issues codes and tokens, validates PKCE")
  ComponentDb(db, "CommunityDbContext", "EF Core / PostgreSQL", "Users and OpenIddict token store")
}
Rel(spa, ep, "Authorizes and exchanges tokens")
Rel(ep, h, "Sends SignInCommand")
Rel(h, db, "Reads user, updates failed count")
Rel(ep, oi, "Delegates protocol handling")
Rel(oi, db, "Stores and revokes tokens")
@enduml
