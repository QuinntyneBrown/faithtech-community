@startuml
title UML sequence behaviour — sign in
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Account holder" as actor
box "Frontend — Community web app (faithtech-community library)" #E0F2FE
  participant "SignInPage" as page
  participant "OidcAuthClient" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AuthorizationEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "SignInHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> client : Open protected page on the organisation's host
client -> client : Create code verifier and challenge
client -> ep : GET /connect/authorize (code_challenge)
ep --> page : Redirect to sign-in page
actor -> page : Submit email and password
page -> ep : POST credentials
ep -> h : Send SignInCommand
h -> db : Load user, lockout, operator lock and the profile in ICurrentOrganisation
alt 5 failures in 15 minutes
  h --> ep : LockedOut (L2-003)
  ep --> page : Locked out for 15 minutes
else account locked by a platform operator
  h --> ep : AccountLocked (L2-003 #4, L2-132 #6)
  ep --> page : "Your account is suspended"
else membership suspended in this organisation
  h --> ep : MembershipSuspended (L2-003 #4, L2-132 #5)
  ep --> page : "Your membership of {organisation name} is suspended"
else wrong password
  h -> db : Increment failed count
  h --> ep : InvalidCredentials
  ep --> page : "Email or password is incorrect" (L2-003)
else succeeded
  h --> ep : Principal
  ep --> client : Redirect with authorization code
  client -> ep : POST /connect/token (code, code_verifier)
  ep -> ep : Validate PKCE verifier (L2-003)
  ep -> db : Store tokens
  ep --> client : Access and refresh tokens
  client -> ep : GET /api/me
  alt no profile in this organisation
    ep --> client : 403 reason not-a-member (L2-132 #3)
    client --> actor : Not-a-member page
  else member
    ep --> client : Organisation, profile, capabilities, memberships (L2-133)
    client --> actor : Land on requested page or home (L2-003)
  end
end
@enduml
