@startuml
title UML sequence behaviour — change the password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend — Community web app (notifications library and api)" #E0F2FE
  participant "SettingsPage" as page
  participant "AccountService" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AccountEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application" #ECFDF3
  participant "AccountSettingsHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "UserManager" as um
end box
actor -> page : Enters current and new password, Save settings
page -> client : updateAccount({ currentPassword, newPassword })
client -> ep : PUT /api/account
ep -> ep : UpdateAccountValidator (current required, L2-001 AC3 rules)
alt invalid
  ep --> page : 400, error summary and field errors
else valid
  ep -> h : UpdateAsync(command)
  h -> um : ChangePasswordAsync(user, current, new)
  alt current password wrong
    h --> ep : Invalid(CurrentPassword, "Your current password is incorrect.")
    ep --> page : 400, field error
  else changed
    h --> ep : AccountUpdated(PasswordChanged)
    ep --> page : 200, "Settings saved"
  end
end
@enduml
