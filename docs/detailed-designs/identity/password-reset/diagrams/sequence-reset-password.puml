@startuml
title UML sequence behaviour — set a new password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Account holder" as actor
box "Frontend — Community web app (faithtech-community library)" #E0F2FE
  participant "ResetPasswordPage" as page
  participant "AuthService" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AccountEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ResetPasswordHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "ITokenRevocation" as rv
  database "Community database" as db
end box
participant "Email provider" as mail
actor -> page : Submit new password
page -> client : resetPassword(email, token, password)
client -> ep : POST /api/account/reset-password
ep -> h : Send ResetPasswordCommand
h -> db : Validate reset token
alt valid and younger than 1 hour
  h -> db : Set new password hash and security stamp (L2-004)
  h -> rv : Revoke every session on every organisation host (L2-004, L2-132 #7)
  rv -> db : Mark tokens revoked
  h --> ep : Changed
  ep --> client : 204 No Content
  page --> actor : Navigate to sign in
else expired or already used
  h --> ep : Invalid token
  ep --> client : 400 ProblemDetails
  page --> actor : Error with request-new-link action (L2-004)
end
@enduml
