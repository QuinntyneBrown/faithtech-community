@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Sign up

class SignUpCommand {
  +string Name
  +string Email
  +string Password
}
class SignUpValidator {
  +Validate(command: SignUpCommand): ValidationResult
}
class SignUpHandler {
  +Handle(command: SignUpCommand): Task<SignUpResult>
}
interface IBreachedPasswordChecker {
  +IsBreachedAsync(password: string): Task<bool>
}
interface IEmailSender {
  +SendAsync(message: EmailMessage): Task
}
interface ICurrentOrganisation {
  +Guid Id
  +string Name
  +string Host
}
class CommunityUser {
  +Guid Id
  +string Email
  +bool EmailConfirmed
  +string PasswordHash
}
class Profile {
  +Guid Id
  +Guid OrganisationId
  +Guid UserId
  +string Name
  +IReadOnlyCollection<ProfileRole> Roles
}
SignUpHandler ..> SignUpCommand : handles
SignUpHandler ..> SignUpValidator : uses
SignUpHandler ..> IBreachedPasswordChecker : uses
SignUpHandler ..> IEmailSender : uses
SignUpHandler ..> ICurrentOrganisation : stamps profile with
SignUpHandler --> CommunityUser : creates
SignUpHandler --> Profile : creates in the organisation
CommunityUser "1" --> "0..*" Profile : one per organisation
@enduml
