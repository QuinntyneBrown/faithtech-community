@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Google sign-in

class GoogleSignInCommand {
  +string Code
  +string RedirectUri
  +string Nonce
}
class GoogleSignInHandler {
  +const LoginProvider = "Google"
  +HandleAsync(command): Task<GoogleSignInResult>
}
class GoogleSignInResult {
  +CommunityUser? User
  +GoogleSignInError? Error
}
enum GoogleSignInError {
  InvalidToken
  UnverifiedEmail
  MembershipSuspended
  AccountLocked
}
interface IGoogleIdentityProvider {
  +BuildAuthorizationUrl(state, nonce, redirectUri): string?
  +ExchangeCodeAsync(code, redirectUri, nonce): Task<GoogleIdentity?>
}
class GoogleIdentity <<record>> {
  +string Subject
  +string Email
  +bool EmailVerified
  +string? Name
}
class GoogleOptions {
  +string ClientId
  +string ClientSecret
}
class GoogleIdentityProvider
class GoogleIdTokenValidator {
  +ValidateAsync(idToken, nonce): Task<GoogleIdentity?>
}
class AccountStatus <<static>> {
  +IsLockedAsync(db, user): Task<bool>
  +IsSuspendedAsync(db, user, organisation): Task<bool>
}
interface ICurrentOrganisation {
  +Guid Id
  +string Name
  +string Host
}
class CommunityUser {
  +bool EmailConfirmed
  +string? PasswordHash
  +bool IsLockedByOperator
}
class "IdentityUserLogin<Guid>" as Login {
  +string LoginProvider = "Google"
  +string ProviderKey = sub
  +Guid UserId
}
class Profile {
  +Guid OrganisationId
  +Guid UserId
  +string Name
  +bool IsSuspended
}
GoogleSignInHandler ..> GoogleSignInCommand
GoogleSignInHandler ..> GoogleSignInResult
GoogleSignInResult --> GoogleSignInError
GoogleSignInHandler --> IGoogleIdentityProvider
GoogleSignInHandler ..> AccountStatus
GoogleSignInHandler ..> ICurrentOrganisation : profile created or checked in
IGoogleIdentityProvider <|.. GoogleIdentityProvider
GoogleIdentityProvider --> GoogleIdTokenValidator
GoogleIdentityProvider --> GoogleOptions
IGoogleIdentityProvider ..> GoogleIdentity
CommunityUser "1" --> "0..*" Login
CommunityUser "1" --> "0..*" Profile : one per organisation
@enduml
