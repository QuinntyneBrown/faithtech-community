@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — In-app notifications
Person(member, "Member", "Signed-in community member")
System_Boundary(ftc, "Community platform") {
  Container(web, "Web app", "Angular", "Shell, notifications feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Persistent community data")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
