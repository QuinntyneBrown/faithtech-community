@startuml
title UML sequence behaviour — Open a notification
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — FaithTech Community web app (notifications library)" #E0F2FE
  participant "NotificationBellComponent" as bell
  participant "HttpNotificationsService" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "NotificationsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "MarkNotificationReadHandler" as h
  participant "Notification" as n
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> bell : Open bell
bell -> client : list(page 1)
client -> ep : GET /notifications
ep -> ep : Require authenticated caller
ep -> db : Query by RecipientId, newest first (L2-027 #1)
db --> ep : Notification page
ep --> client : 200 NotificationPage
client --> bell : Items and unread count
actor -> bell : Open notification
bell -> client : markRead(id)
client -> ep : POST /notifications/{id}/read
ep -> h : Send MarkNotificationReadCommand
h -> db : Load notification where RecipientId = caller
alt found
  db --> h : Notification
  h -> n : MarkRead(now) (L2-027 #2)
  h -> db : Save changes
  h --> ep : Success
  ep --> client : 204
  client --> bell : Navigate to LinkPath
else not the caller's notification
  db --> h : none
  h --> ep : NotFound
  ep --> client : 404 ProblemDetails
end
bell --> actor : Related item shown
@enduml
