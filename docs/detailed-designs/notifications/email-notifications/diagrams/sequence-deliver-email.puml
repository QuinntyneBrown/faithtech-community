@startuml
title UML sequence behaviour — Deliver a notification email
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "Triggering endpoint" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "Triggering handler" as h
  participant "INotificationPublisher" as pub
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "OutboxEmailQueue" as q
  participant "EmailTemplateRenderer" as r
  database "Community database" as db
  participant "EmailOutboxWorker" as w
  participant "EmailOutboxDispatcher" as d
  participant "SmtpEmailTransport" as s
end box
participant "Email provider" as prov
actor -> ep : State-changing request (e.g. cancel event)
ep -> h : Send command
h -> pub : PublishAsync(recipients, kind, title, linkPath, actorId, email)
pub -> db : Add in-app Notification per recipient
loop each recipient with an email address
  alt kind is Announcement and recipient opted out (L2-028 #3)
    pub -> pub : Skip email
  else
    pub -> q : Enqueue(EmailMessage), link on the organisation's host,\nsender name and footer from the organisation (HTTPS, L2-028 #2, L2-134 AC5)
    q -> r : Render(subject, textBody)
    r --> q : HTML part
    q -> db : Add OutboxMessage (NextAttemptAt = now)
  end
end
h -> db : Save action, notifications and outbox in one unit of work
h --> ep : Success
ep --> actor : Response
loop every 10 seconds
  w -> d : DispatchPendingAsync()
  d -> db : Load due rows (SentAt and FailedAt null, NextAttemptAt <= now)
  d -> s : SendAsync(message)
  s -> prov : SMTP send (text + HTML alternative)
  alt delivered
    prov --> s : Accepted
    d -> db : Set SentAt (within 2 minutes, L2-028 #1)
  else failure
    prov --> s : Error
    d -> db : Attempts++, LastError, NextAttemptAt = now + 2^n min (max 1 h);\nFailedAt after 5 attempts
  end
end
@enduml
