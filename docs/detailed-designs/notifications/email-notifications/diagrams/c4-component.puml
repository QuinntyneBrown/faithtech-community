@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Email notifications
Container_Boundary(api, "Community API") {
  Component(src, "Triggering handler", "Application handler", "Any feature command that notifies, e.g. CancelEventHandler")
  Component(pub, "INotificationPublisher", "Application service", "PublishAsync: notification and email per recipient")
  Component(queue, "OutboxEmailQueue", "Infrastructure IEmailQueue", "Enqueue adds email to the outbox")
  Component(render, "EmailTemplateRenderer", "Infrastructure service", "HTML part from the plain-text body")
  Component(worker, "EmailOutboxWorker", "Hosted service", "Polls every 10 seconds")
  Component(disp, "EmailOutboxDispatcher", "Infrastructure service", "Sends due outbox rows with retry")
  Component(transport, "SmtpEmailTransport", "Infrastructure IEmailTransport", "SMTP/SendGrid client")
  ComponentDb(db, "CommunityDbContext", "EF Core", "OutboxMessages table")
}
System_Ext(email, "Email provider", "SMTP/SendGrid")
Rel(src, pub, "Publishes")
Rel(pub, queue, "Enqueues")
Rel(queue, render, "Renders with")
Rel(queue, db, "Adds OutboxMessage")
Rel(worker, disp, "DispatchPendingAsync")
Rel(disp, db, "Reads and updates due rows")
Rel(disp, transport, "Sends")
Rel(transport, email, "Delivers", "SMTP")
@enduml
