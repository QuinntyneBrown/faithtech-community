@startuml
title UML sequence behaviour — Browse people and change a role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member with ViewPeopleDirectory" as actor
box "Frontend — Community web app (profiles library)" #E0F2FE
  participant "PeoplePage" as page
  participant "HttpPeopleService" as svc
  participant "RoleDialogComponent" as dialog
  participant "HttpRolesService" as roles
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PeopleEndpoints" as ep
  participant "RolesEndpoints" as rep
end box
box "Backend — FaithTech.Community.Application" #ECFDF3
  participant "ListPeopleHandler" as h
  participant "ChangeRolesHandler" as ch
end box
database "Community database" as db
actor -> page : Open /people, optionally search by name or email or filter by {chapter}
page -> svc : search(term, chapter, page)
svc -> ep : GET /api/people?q=&chapter=&page=
ep -> h : HandleAsync(term, page) (401 anonymous)
h -> h : Caller holds ViewPeopleDirectory? (403 otherwise, L2-053 AC3, AC6)
h -> db : Organisation's profiles joined to accounts, name or email matches, chapter filter (L2-142 AC2), by name, 25 per page
db --> h : Rows
h --> ep : PagedResult<PersonSummary> (no email)
ep --> svc : 200 OK
svc --> page : Page of people
page --> actor : Table, or the no-results state offering an invite (L2-053 AC4)
opt holder of AssignRoles chooses Add role or Remove on a row
  page -> dialog : open(grantableRoleIds from /api/me, L2-137 AC5)
  dialog -> roles : addRole / removeRole
  roles -> rep : POST or DELETE /api/profiles/{id}/roles
  rep -> ch : RoleGrantPolicy enforces grant rules and chapter scoping (403, L2-138, L2-143)
  ch --> rep : New role set
  rep --> roles : 200 OK
  roles --> page : Roles
  page --> actor : The row's badges update without a reload (L2-009 AC5)
end
@enduml
