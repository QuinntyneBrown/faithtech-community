@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — People directory
class ListPeopleHandler {
  +{static} int PageSize = 25
  +HandleAsync(term: string?, chapterId: Guid?, page: int): Task<PagedResult<PersonSummary>?>
}
class PersonSummary {
  +Guid Id
  +string Name
  +string? Chapter
  +string? PhotoUrl
  +IReadOnlyList<HeldRole> Roles
}
class HeldRole {
  +Guid RoleDefinitionId
  +string Name
  +string? Chapter
}
class "PagedResult<T>" as PagedResult {
  +IReadOnlyList<T> Items
  +int Page
  +int PageSize
  +int TotalCount
}
interface ICurrentUser {
  +Has(capability: string): bool
}
interface ICurrentOrganisation {
  +Guid Id
}

interface IPhotoStorage {
  +GetReadUrl(blobName: string): string
}
class Profile {
  +Guid Id
  +Guid OrganisationId
  +Guid UserId
  +string Name
  +Guid? ChapterId
  +IReadOnlyCollection<ProfilePhoto> Photos
  +IReadOnlyCollection<ProfileRole> Roles
}
class ProfileRole {
  +Guid RoleDefinitionId
  +Guid? ChapterId
}
class CommunityUser {
  +Guid Id
  +string Email
}
ListPeopleHandler --> ICurrentUser : Has(ViewPeopleDirectory)
ListPeopleHandler --> ICurrentOrganisation : scopes
Profile "1" *-- "*" ProfileRole
ListPeopleHandler --> IPhotoStorage
ListPeopleHandler --> Profile : reads
ListPeopleHandler --> CommunityUser : matches email
ListPeopleHandler ..> PagedResult : returns
PagedResult *-- PersonSummary
PersonSummary *-- HeldRole
@enduml
