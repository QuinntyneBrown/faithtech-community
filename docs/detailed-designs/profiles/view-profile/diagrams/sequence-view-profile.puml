@startuml
title UML sequence behaviour — view a profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — FaithTech Community web app (profiles library)" #E0F2FE
  participant "ProfilePage" as page
  participant "ProfilesService" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ProfilesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetProfileHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /people/{id} or /people/me
alt anonymous visitor
  page --> actor : Redirect to sign in (L2-005)
else signed-in member
  page -> client : getProfile(id)
  client -> ep : GET /api/profiles/{id}
  ep -> ep : Require authenticated caller; 401 if none (L2-005)
  ep -> h : HandleAsync(id)
  h -> db : Load profile, photos and roles
  alt no such profile, including an unlinked private contact (ADR 0003)
    h --> ep : Not found (L2-005)
    ep --> client : 404
    page --> actor : "We can’t find that profile"
  else profile
    h --> ep : ProfileDto
    ep --> client : 200 ProfileDto
    page --> actor : Name, featured photo, photos and roles (L2-005)
  end
end
@enduml
