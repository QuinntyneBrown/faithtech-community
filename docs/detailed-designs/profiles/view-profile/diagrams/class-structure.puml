@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View a profile

class GetProfileQuery {
  +Guid ProfileId
}
class GetProfileHandler {
  +Handle(query: GetProfileQuery): Task<ProfileDto?>
}
class ProfileDto {
  +Guid Id
  +string Name
  +string? Chapter
  +PhotoDto? FeaturedPhoto
  +IReadOnlyList<PhotoDto> Photos
  +IReadOnlyList<HeldRole> Roles
}
class HeldRole {
  +Guid RoleDefinitionId
  +string Name
  +string? Chapter
}
class Profile {
  +Guid Id
  +Guid OrganisationId
  +string Name
  +Guid? ChapterId
}
class ProfilePhoto {
  +Guid Id
  +string BlobName
  +string AltText
  +bool IsFeatured
}
class ProfileRole {
  +Guid RoleDefinitionId
  +Guid? ChapterId
}
class RoleDefinition {
  +Guid Id
  +string Name
  +IReadOnlySet<string> Capabilities
}
interface ICurrentUser {
  +Guid UserId
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface ICurrentOrganisation {
  +Guid Id
}

GetProfileHandler ..> GetProfileQuery : handles
GetProfileHandler ..> ICurrentUser : uses
GetProfileHandler ..> ICurrentOrganisation : scopes
GetProfileHandler --> Profile : reads
GetProfileHandler ..> ProfileDto : returns
Profile "1" *-- "0..10" ProfilePhoto
Profile "1" *-- "*" ProfileRole
ProfileRole --> RoleDefinition : references
ProfileDto *-- HeldRole
@enduml
