@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Edit own profile

class UpdateProfileCommand {
  +Guid ProfileId
  +string Name
  +string? HomeCity
  +string? Bio
}
class UpdateProfileValidator {
  +int MaxNameLength = 100
  +int MaxBioLength = 400
  +Validate(command: UpdateProfileCommand): ValidationResult
}
class UpdateProfileHandler {
  +Handle(command: UpdateProfileCommand): Task<Result>
}
class Profile {
  +Guid Id
  +string Name
  +string? HomeCity
  +string? Bio
  +Update(name: string, homeCity: string?, bio: string?): void
}
interface ICurrentUser {
  +Guid ProfileId
  +bool IsSystemAdmin
}
interface IAuditLog {
  +RecordAsync(entry: AuditEntry): Task
}
UpdateProfileHandler ..> UpdateProfileCommand : handles
UpdateProfileHandler ..> UpdateProfileValidator : uses
UpdateProfileHandler ..> ICurrentUser : uses
UpdateProfileHandler ..> IAuditLog : uses
UpdateProfileHandler --> Profile : renames
@enduml
