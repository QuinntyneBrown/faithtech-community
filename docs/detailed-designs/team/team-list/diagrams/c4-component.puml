@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Team list
Container_Boundary(web, "Web app") {
  Component(page, "TeamPage", "Angular page", "Lists team members with role and {chapter} filters")
  Component(svc, "HttpTeamService", "Angular service", "Implements TeamService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "TeamEndpoints", "ASP.NET Core minimal API", "GET /api/team")
  Component(h, "ListTeamHandler", "Application handler", "Derives team from roles flagged ShowOnTeam")
  Component(roles, "RoleDefinition", "Domain entity (Organisations)", "ShowOnTeam flag on the organisation's roles")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, svc, "Calls")
Rel(svc, ep, "GET", "JSON/HTTPS")
Rel(ep, h, "Sends query")
Rel(h, roles, "Reads")
Rel(h, db, "Queries", "EF Core")
@enduml
