@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Team list
class RoleDefinition {
  +Guid Id
  +Guid OrganisationId
  +string Name
  +bool ShowOnTeam
  +bool IsArchived
}
class ProfileRole {
  +Guid RoleDefinitionId
  +Guid? ChapterId
}
interface ICurrentOrganisation {
  +Guid Id
}
class ListTeamQuery {
  +Guid? RoleId
  +Guid? ChapterId
}
class ListTeamHandler {
  +HandleAsync(query: ListTeamQuery): Task<TeamListDto>
}
class TeamListDto {
  +IReadOnlyList<TeamMemberDto> Members
}
class TeamMemberDto {
  +Guid ProfileId
  +string Name
  +string? Chapter
  +string? PhotoUrl
  +IReadOnlyList<HeldRole> Roles
}
class HeldRole {
  +Guid RoleDefinitionId
  +string Name
  +string? Chapter
}
class Profile {
  +Guid Id
  +Guid OrganisationId
  +string Name
  +Guid? ChapterId
  +IReadOnlyCollection<ProfilePhoto> Photos
  +IReadOnlyCollection<ProfileRole> Roles
}
ListTeamHandler ..> ListTeamQuery : handles
ListTeamHandler --> RoleDefinition : ShowOnTeam, not archived
ListTeamHandler --> ICurrentOrganisation : scopes
ListTeamHandler --> Profile : reads
ListTeamHandler ..> TeamListDto : returns
Profile "1" *-- "*" ProfileRole
ProfileRole --> RoleDefinition : references
TeamListDto *-- TeamMemberDto
TeamMemberDto *-- HeldRole
@enduml
