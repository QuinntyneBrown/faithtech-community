@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Team list
class TeamRoles {
  +{static} IReadOnlySet<Role> All
  +{static} IReadOnlySet<Role> Leads
  +{static} IsTeamMember(profile: Profile): bool
}
enum TeamRoleFilter {
  Leads
  Volunteers
}
class ListTeamQuery {
  +TeamRoleFilter? Role
  +string? City
}
class ListTeamHandler {
  +HandleAsync(query: ListTeamQuery): Task<TeamListDto>
}
class TeamListDto {
  +IReadOnlyList<TeamMemberDto> Members
  +IReadOnlyList<string> Cities
}
class TeamMemberDto {
  +Guid ProfileId
  +string Name
  +string? HomeCity
  +string? PhotoUrl
  +IReadOnlyList<string> Roles
}
class Profile {
  +Guid Id
  +string Name
  +string? HomeCity
  +IReadOnlyCollection<ProfilePhoto> Photos
  +IReadOnlyCollection<ProfileRole> Roles
}
ListTeamHandler ..> ListTeamQuery : handles
ListTeamHandler --> TeamRoles
ListTeamHandler --> Profile : reads
ListTeamHandler ..> TeamListDto : returns
ListTeamQuery --> TeamRoleFilter
TeamListDto *-- TeamMemberDto
@enduml
