@startuml
title UML sequence behaviour — View and filter the team
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Community web app (team library)" #E0F2FE
  participant "TeamPage" as page
  participant "HttpTeamService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "TeamEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ListTeamHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open team, optionally choose a role or {chapter} filter
page -> svc : list({ roleId?, chapterId? })
svc -> ep : GET /api/team?role=&chapter=
ep -> ep : Require signed-in member (401 anonymous)
ep -> h : Send ListTeamQuery
h -> db : Select the organisation's profiles holding a non-archived role flagged ShowOnTeam (L2-019 AC1, AC3)
db --> h : Profiles with roles and photos
opt role or {chapter} filter
  h -> h : Narrow to the chosen role and home {chapter} (L2-019 AC2, L2-142 AC2)
end
h --> ep : TeamListDto: members by name with photo and roles with {chapter} tags
ep --> svc : 200 OK
svc --> page : Team list
page --> actor : Team list rows, or the empty or no-results state
@enduml
