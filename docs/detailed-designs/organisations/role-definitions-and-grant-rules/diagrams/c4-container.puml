@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Role definitions and grant rules
Person(manager, "Holder of ManageRoles", "Defines roles and grant rules")
Person(grantor, "Holder of AssignRoles", "Assigns roles under the rules")
System_Boundary(platform, "Community platform") {
  Container(web, "Web app", "Angular", "Shell, organisations and profiles feature libraries, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "RoleDefinitions, RoleGrantRules, ProfileRoles, OrganisationAdminRosters, audit log")
}
System_Ext(email, "Email provider", "SMTP/SendGrid")
Rel(manager, web, "Uses", "HTTPS")
Rel(grantor, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/organisation/roles and /api/profiles/{id}/roles", "JSON/HTTPS, OAuth2 bearer token")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, email, "Sends role-change email via", "SMTP/SendGrid")
@enduml
