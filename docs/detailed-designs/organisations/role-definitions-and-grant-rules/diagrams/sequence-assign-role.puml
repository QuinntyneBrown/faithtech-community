@startuml
title UML sequence behaviour — Assign a role under grant rules
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Holder of AssignRoles or AdministerOrganisation" as actor
box "Frontend — Community web app (profiles and components libraries)" #E0F2FE
  participant "ProfilePage" as page
  participant "RoleDialogComponent" as dlg
end box
box "Frontend — Community web app (api library)" #E0F2FE
  participant "HttpRolesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "RolesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ChangeRolesHandler" as h
  participant "RoleGrantPolicy" as pol
  participant "LastAdministratorGuard" as guard
  participant "Profile" as prof
  participant "RoleChangeNotifier" as notify
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose "Add a role" or "Remove a role"
page -> dlg : Open with the organisation's roles filtered by grantableRoleIds, chapters and submit (L2-137 AC5)
actor -> dlg : Choose role, and a chapter for a scopable role (L2-138 AC6); confirm
dlg -> page : submit(roleId, chapterId)
page -> svc : addRole(profileId, roleId, chapterId) or removeRole(profileId, roleId, chapterId)
svc -> ep : POST /api/profiles/{id}/roles { roleId, chapterId } or DELETE .../roles/{roleId} (HANDLES_FORBIDDEN)
ep -> h : AssignAsync or RemoveAsync
h -> pol : CanChangeRoles?
alt caller lacks AssignRoles and AdministerOrganisation (L2-138 AC4)
  pol --> h : false
  h --> ep : Forbidden
  ep --> svc : 403
else
  h -> db : Definition by id in the current organisation, not archived
  alt unknown, archived or foreign role, or chapter on a non-scopable role (L2-138 AC6, AC7)
    h --> ep : Invalid "Choose a role."
    ep --> svc : 400 ProblemDetails
  else
    h -> pol : CanGrant(definition, chapterId) per grant rules and chapter scope (L2-138 AC2, L2-143)
    alt no rule and not an administrator
      pol --> h : false
      h --> ep : Forbidden
      ep --> svc : 403
    else permitted
      pol --> h : true
      h -> db : Load Profile with roles
      alt already held with the same chapter, or not held (L2-138 AC7)
        h --> ep : Conflict
        ep --> svc : 409
      else
        opt removal of a definition carrying AdministerOrganisation (L2-138 AC8)
          h -> guard : TakeLeaseAsync(); WouldLeaveNoneAsync(profileId)
          guard --> h : Refusal when none would remain, 409 "There must always be at least one administrator."
        end
        h -> prof : AddRole(definitionId, chapterId, actor, nowUtc) or RemoveRole(...)
        h -> audit : Record(actor, "role.granted" | "role.removed", "Profile", id, before, after) with role and chapter (L2-138 AC5)
        opt pol.NotifiesOwner and actor is not the owner (L2-138 AC1, AC3)
          h -> notify : Notify(owner, "{Actor} made you {role}" | "{Actor} removed {role}")
          h -> notify : QueueEmailAsync(owner, title)
        end
        h -> db : Save changes in one unit of work
        h --> ep : Held roles
        ep --> svc : 200 OK
      end
    end
  end
end
svc --> page : Roles or error
alt saved
  page -> page : Replace the profile's roles without reload (L2-138 AC1)
  page --> dlg : null
  dlg --> actor : Close; badges show "{role} · {chapter}"
else refused
  page --> dlg : Message
  dlg --> actor : Show the refusal; dialog stays open
end
@enduml
