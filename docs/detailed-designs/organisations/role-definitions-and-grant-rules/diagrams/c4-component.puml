@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Role definitions and grant rules
Container_Boundary(web, "Web app") {
  Component(roles, "RolesPage", "Angular page (organisations library)", "Lists definitions; opens the dialogs")
  Component(define, "DefineRoleDialogComponent", "CDK Dialog (components)", "Name, description, CapabilityChecklistComponent, flags")
  Component(grants, "EditGrantsDialogComponent", "CDK Dialog (components)", "Who may grant: checkbox per definition")
  Component(archive, "ArchiveRoleDialogComponent", "CDK Dialog (components)", "Confirms; shows the 409 reason")
  Component(profile, "ProfilePage", "Angular page (profiles library)", "Opens RoleDialogComponent with grantableRoleIds")
  Component(roledlg, "RoleDialogComponent", "CDK Dialog (components)", "Add or remove; chapter select for scopable roles")
  Component(defsvc, "HttpRoleDefinitionsService", "Angular service (api)", "Implements RoleDefinitionsService")
  Component(rolesvc, "HttpRolesService", "Angular service (api)", "addRole(roleId, chapterId) / removeRole")
}
Container_Boundary(api, "Community API") {
  Component(defep, "RoleDefinitionsEndpoints", "Minimal API", "/api/organisation/roles and /grants")
  Component(roleep, "RolesEndpoints", "Minimal API", "POST and DELETE /api/profiles/{id}/roles")
  Component(defh, "Role definition handlers", "Application", "Define, Update, Archive, SetGrantRules, List")
  Component(val, "RoleDefinitionValidator", "Application validator", "Name, description, capabilities, flags")
  Component(changeh, "ChangeRolesHandler", "Application handler", "AssignAsync and RemoveAsync by roleId and chapterId")
  Component(policy, "RoleGrantPolicy", "Application permission check", "Grant rules, implicit administrator, chapter scoping")
  Component(guard, "LastAdministratorGuard", "Application service", "Lease and count on OrganisationAdminRoster")
  Component(detect, "CapabilityLossDetector", "Application service", "Raises CapabilityLost")
  Component(def, "RoleDefinition", "Domain aggregate", "Capabilities, flags, RoleGrantRule rows")
  Component(prof, "Profile", "Domain entity", "ProfileRole rows by definition and chapter")
  Component(notify, "RoleChangeNotifier", "Application service", "Notifies the owner in-app and by email")
  Component(audit, "AuditLog", "Infrastructure service", "roles category entries; role.granted / role.removed")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(roles, define, "Opens")
Rel(roles, grants, "Opens")
Rel(roles, archive, "Opens")
Rel(roles, defsvc, "list / define / update / archive / setGrants")
Rel(profile, roledlg, "Opens with grantable options")
Rel(profile, rolesvc, "addRole / removeRole")
Rel(defsvc, defep, "Sends request", "JSON/HTTPS")
Rel(rolesvc, roleep, "Sends request", "JSON/HTTPS")
Rel(defep, defh, "Dispatches")
Rel(defh, val, "Validates")
Rel(defh, def, "Mutates")
Rel(defh, guard, "Guards AdministerOrganisation edits and archives")
Rel(defh, detect, "On capabilities removed")
Rel(defh, audit, "role.defined / role.updated / role.archived / role.grants.updated")
Rel(roleep, changeh, "AssignAsync / RemoveAsync")
Rel(changeh, policy, "CanChangeRoles, CanGrant, NotifiesOwner")
Rel(policy, def, "Reads grant rules")
Rel(changeh, guard, "On removal of AdministerOrganisation")
Rel(changeh, prof, "AddRole / RemoveRole")
Rel(changeh, detect, "On removal")
Rel(changeh, notify, "When acting under a rule")
Rel(changeh, audit, "role.granted / role.removed")
Rel(defh, db, "Persists", "EF Core")
Rel(changeh, db, "Persists", "EF Core")
@enduml
