@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Seed FaithTech
Person(operator, "Deployment operator", "Runs the Cli")
System_Boundary(platform, "FaithTech Community platform") {
  Container(cli, "Cli", ".NET console", "FaithTech.Community.Cli: migrate, seed, reset, grant-admin")
  Container(api, "Community API", "ASP.NET Core", "Reads the seeded organisation; never migrates or seeds")
  ContainerDb(db, "Community database", "PostgreSQL", "Organisations, RoleDefinitions, taxonomies, Chapters, OrganisationAdminRosters, OpenIddict tables")
}
Rel(operator, cli, "Runs", "shell")
Rel(cli, db, "Applies migrations; inserts seed records", "EF Core")
Rel(api, db, "Reads", "EF Core")
@enduml
