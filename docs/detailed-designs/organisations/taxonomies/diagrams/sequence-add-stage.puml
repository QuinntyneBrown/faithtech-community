@startuml
title UML sequence behaviour — Add a stage
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Settings holder" as actor
box "Frontend — Community web app (organisations library)" #E0F2FE
  participant "TaxonomiesPage" as page
  participant "AddListEntryDialog" as dlg
end box
box "Frontend — Community web app (api library)" #E0F2FE
  participant "HttpOrganisationService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "OrganisationEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ManagePartnerStagesHandler" as h
  participant "TaxonomyRules" as rules
  participant "PartnerStage" as ent
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose "Add a stage" under Partner stages
page -> dlg : Open with list "Partner stages"
actor -> dlg : Enter the name and save
dlg -> svc : addPartnerStage(name)
svc -> ep : POST /api/organisation/partner-stages { name }
ep -> h : AddAsync(AddEntryCommand)
alt caller lacks ManageOrganisationSettings
  h --> ep : Forbidden
  ep --> svc : 403 (L2-147 AC3)
  svc --> dlg : Error
  dlg --> actor : Forbidden message
else permitted
  h -> db : Load the organisation's stages
  db --> h : Stages, active and archived
  h -> rules : ValidateName(name, active names)
  alt empty, over 40 characters or a duplicate among active ignoring case
    rules --> h : Invalid("name")
    ep --> svc : 400 ValidationProblem (L2-144 AC2)
    svc --> dlg : Field error
    dlg --> actor : Inline error; nothing saved
  else valid
    h -> rules : DeriveKey(name, existing keys)
    rules --> h : Unique key
    h -> ent : new PartnerStage(organisationId, key, name, sortOrder = last + 1, Kind = Open, IsInitial = false)
    h -> audit : Record(actor, "taxonomy.updated", "PartnerStages", organisationId, { stages before }, { stages after }) (L2-152 AC1)
    h -> db : Save stage and audit entry in one unit of work
    db --> h : Committed
    h --> ep : TaxonomyEntryDto
    ep --> svc : 201 Created (L2-144 AC1)
    svc --> dlg : Entry
    dlg --> page : Close with the new stage
    page --> actor : Row appended with "0 partners", kind Open; toast "{name} added"
  end
end
note over page : The board, Home and Reports show the new column and count on their next load (L2-144 AC3, AC5)
@enduml
