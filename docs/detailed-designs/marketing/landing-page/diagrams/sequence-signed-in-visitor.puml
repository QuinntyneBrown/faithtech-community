@startuml
title UML sequence behaviour — a member with a kept session opens the marketing page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Marketing app" #FEF3C7
  participant "LandingPage" as page
  participant "HttpAuthService" as auth
end box
box "Community app" #E0F2FE
  participant "App initializer" as init
  participant "OidcAuthClient" as client
end box
actor -> page : Open www.faithtech.community
page -> auth : hasKeptSession()
auth --> page : ftc.signed-in cookie present
page -> init : location.replace(community origin + "/") (L2-055 AC6)
init -> client : restoreSession(): refresh token from localStorage
alt refresh succeeds
  client --> actor : Home
else refresh fails
  client -> client : Clear the hint cookie
  client --> actor : Sign-in page
end
@enduml
