@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage partners
Container_Boundary(web, "Web app") {
  Component(board, "PartnersPage", "Angular page (partners library)", "/partners: board with the Add partner action")
  Component(dlg, "AddPartnerDialog", "Angular CDK Dialog (partners library)", "Every L2-017 field and a stage, Lead by default")
  Component(page, "PartnerPage", "Angular page (partners library)", "/partners/:id: details and stage history")
  Component(form, "PartnerFormPage", "Angular page (partners library)", "/partners/:id/edit: details without the stage")
  Component(fields, "partner-fields.ts", "TypeScript module (partners library)", "Shared form, request mapping and error mapping")
  Component(svc, "HttpPartnersService", "Angular service (api library)", "Implements PartnersService (PARTNERS_SERVICE)")
}
Container_Boundary(api, "Community API") {
  Component(ep, "PartnersEndpoints", "ASP.NET Core minimal API", "POST /api/partners; GET, PUT /api/partners/{id}; GET /api/partners/owners")
  Component(val, "PartnerValidator", "FluentValidation", "Name, email, field lengths and stage")
  Component(h, "ManagePartnersHandler", "Application handler", "CreateAsync, GetAsync, UpdateAsync, OwnersAsync")
  Component(acc, "PartnerAccess", "Application permission check", "CanRead, CanWrite, AuditAdminWrite")
  Component(views, "PartnerViews", "Application service", "PartnerDto with owner and mover names")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "Partners and PartnerStageChanges tables")
}
Rel(board, dlg, "Opens with DialogService")
Rel(dlg, fields, "Uses")
Rel(form, fields, "Uses")
Rel(dlg, svc, "owners / create")
Rel(page, svc, "get(id)")
Rel(form, svc, "get / owners / update")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, val, "Validates body (400)")
Rel(ep, h, "Calls")
Rel(h, acc, "Checks L2-017 access")
Rel(h, views, "Builds PartnerDto")
Rel(acc, audit, "partner.created, partner.updated by admin right")
Rel(h, db, "Persists", "EF Core")
@enduml
