@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Manage partners
enum PartnerStage {
  Lead
  InFunnel
  Confirmed
}
class Partner {
  +Guid Id
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +PartnerStage Stage
  +Update(name, website, offering, ownerId, contactName, email, phone, notes): void
  +MoveTo(stage: PartnerStage, by: Guid, nowUtc: DateTime, note: string?): void
}
class PartnerStageChange {
  +Guid Id
  +Guid PartnerId
  +PartnerStage From
  +PartnerStage To
  +Guid MovedBy
  +DateTime MovedAtUtc
  +string? Note
}
class PartnerAccessPolicy {
  +CanRead(caller: ICurrentUser): bool
  +CanWrite(caller: ICurrentUser): bool
}
Partner --> PartnerStage
Partner "1" *-- "*" PartnerStageChange

class CreatePartnerCommand {
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string ContactName
  +string Email
  +string Phone
  +string Notes
}
class CreatePartnerHandler {
  +Handle(command: CreatePartnerCommand): Task<PartnerDto>
}
class PartnerValidator {
  +Validate(command: CreatePartnerCommand): ValidationResult
}
CreatePartnerHandler ..> CreatePartnerCommand : handles
CreatePartnerHandler --> PartnerAccessPolicy
CreatePartnerHandler --> Partner : creates
PartnerValidator ..> CreatePartnerCommand
@enduml
