@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Manage partners
enum PartnerStageKind {
  Open
  Confirmed
}
class PartnerStage {
  +Guid Id
  +Guid OrganisationId
  +string Key
  +string Name
  +int SortOrder
  +bool IsInitial
  +PartnerStageKind Kind
  +bool IsArchived
}
PartnerStage --> PartnerStageKind
class Partner {
  +Guid Id
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +string StageKey
  +IReadOnlyCollection<PartnerStageChange> StageChanges
  +Update(name, website, offering, ownerId, contactName, email, phone, notes): void
  +MoveTo(stageKey: string, by: Guid, nowUtc: DateTime, note: string?): void
}
class PartnerStageChange {
  +Guid Id
  +Guid PartnerId
  +string From
  +string To
  +Guid MovedBy
  +DateTime MovedAtUtc
  +string? Note
}
class PartnerAccess {
  +bool CanRead
  +bool CanWrite
  +CallerProfileIdAsync(): Task<Guid>
  +AuditAdminWrite(actor: Guid, partner: Partner, action: string, before: object?, after: object?): void
}
class PartnerViews {
  +ToDtoAsync(partner: Partner): Task<PartnerDto>
}
interface ICurrentUser {
  +Guid? UserId
  +IReadOnlyCollection<HeldRole> Roles
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface ICurrentOrganisation {
  +Guid Id
}
class Capability <<static>> {
  +{static} ViewPartners: string
  +{static} ManagePartners: string
  +{static} AdministerOrganisation: string
}
class AuthorizationRules <<static>> {
  +{static} IsOverride(actor: ICurrentUser, capability: string): bool
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
Partner --> PartnerStage : StageKey
Partner "1" *-- "*" PartnerStageChange
PartnerAccess ..> ICurrentUser
PartnerAccess ..> Capability
PartnerAccess ..> AuthorizationRules : IsOverride
PartnerAccess ..> IAuditLog : override by AdministerOrganisation
PartnerViews --> PartnerAccess : CanEdit
class PartnerDto <<record>> {
  +Guid Id
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? OwnerName
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +string Stage
  +int Version
  +DateOnly? LastActivityOn
  +string? NextStep
  +DateOnly? NextStepDue
  +bool CanEdit
  +bool CanLogActivity
}
PartnerViews ..> PartnerDto : builds

class PartnerCommand <<record>> {
  +string? Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +string? Stage
}
class PartnerRules <<static>> {
  +MaxField = 200
  +MaxNotes = 2000
  +{static} TryResolveStage(key: string?, stages: IReadOnlyList<PartnerStage>, out stage: PartnerStage): bool
}
class PartnerValidator
class ManagePartnersHandler {
  +CreateAsync(command: PartnerCommand): Task<(Result, PartnerDto?)>
  +GetAsync(id: Guid): Task<(Result, PartnerDto?)>
  +UpdateAsync(id: Guid, command: PartnerCommand): Task<(Result, PartnerDto?)>
  +BoardAsync(): Task<PartnerBoardDto?>
  +OwnersAsync(): Task<IReadOnlyList<PartnerOwnerDto>?>
}
class PartnerOwnerDto <<record>> {
  +Guid ProfileId
  +string Name
}
PartnerValidator ..> PartnerCommand
PartnerValidator ..> PartnerRules
ManagePartnersHandler ..> PartnerCommand : handles
ManagePartnersHandler --> PartnerAccess
ManagePartnersHandler --> PartnerViews
ManagePartnersHandler --> Partner : creates, updates
ManagePartnersHandler ..> Capability : owner holds ManagePartners
ManagePartnersHandler ..> ICurrentOrganisation : queries scoped by the global filter
ManagePartnersHandler ..> PartnerOwnerDto : lists
@enduml
