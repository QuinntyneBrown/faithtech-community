@startuml
title UML sequence behaviour — Add a partner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member with ManagePartners" as actor
box "Frontend — Community web app (partners library)" #E0F2FE
  participant "PartnersPage" as board
  participant "AddPartnerDialog" as dlg
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
  participant "PartnerValidator" as v
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ManagePartnersHandler" as h
  participant "PartnerAccess" as acc
  participant "PartnerViews" as views
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> board : Choose Add partner
board -> dlg : Open
dlg -> svc : owners()
svc -> ep : GET /api/partners/owners
ep --> svc : 200 members holding ManagePartners
actor -> dlg : Enter details, owner and stage, then save
dlg -> dlg : clientErrors: name required, email well formed
dlg -> svc : create({...details, stage})
svc -> ep : POST /api/partners
ep -> v : Validate
alt invalid
  ep --> svc : 400 ValidationProblem
  svc --> dlg : Errors
  dlg --> actor : Inline errors
else valid
  ep -> h : CreateAsync(command)
  h -> acc : CanWrite: Has(ManagePartners)
  alt lacks ManagePartners
    h --> ep : Forbidden (L2-017 AC3, AC4)
    ep --> svc : 403
    svc --> dlg : Error
    dlg --> actor : Failed alert
  else permitted
    h -> db : Owner, when given, holds ManagePartners?
    alt owner lacks ManagePartners
      h --> ep : Invalid OwnerId "Choose someone who can manage partners as the owner."
      ep --> svc : 400
    else
      h -> h : new Partner(..., stage or the initial stage) (L2-017 AC1, L2-144 AC3)
      h -> h : PartnerActivity.Added(partner, caller, nowUtc) (L2-110 AC6)
      h -> acc : AuditAdminWrite(actor, partner, "partner.created") when IsOverride (L2-135 AC5)
      h -> db : Insert Partner and its Added activity
      h -> views : ToDtoAsync(partner)
      h --> ep : PartnerDto
      ep --> svc : 201 Created
      svc --> dlg : Partner
      dlg --> board : Close with the partner
      board --> actor : Card in its stage column; toast "{name} added to the pipeline"
    end
  end
end
@enduml
