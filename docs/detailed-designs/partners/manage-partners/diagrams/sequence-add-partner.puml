@startuml
title UML sequence behaviour — Add a partner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead" as actor
box "Frontend — FaithTech Community web app (partners library)" #E0F2FE
  participant "AddPartnerDialog" as dlg
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "CreatePartnerHandler" as h
  participant "PartnerAccessPolicy" as pol
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> dlg : Enter details and save
dlg -> svc : create(partner)
svc -> ep : POST /api/partners
ep -> h : Send CreatePartnerCommand
h -> pol : CanWrite(caller)
alt Staff or non-lead
  h --> ep : Forbidden (L2-017 AC3, AC4)
  ep --> svc : 403 ProblemDetails
else permitted
  h -> h : Validate name and email
  h -> db : Insert Partner with Stage = Lead (L2-017 AC1)
  h --> ep : PartnerDto
  ep --> svc : 201 Created
  svc --> dlg : Partner
  dlg --> actor : Card appears in Lead column
end
@enduml
