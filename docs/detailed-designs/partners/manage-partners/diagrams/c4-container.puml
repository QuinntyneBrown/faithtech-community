@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage partners
Person(lead, "Member with ManagePartners", "Works the partner pipeline")
Person(staff, "Member with view capabilities", "Holds ViewPartners without ManagePartners; reads the pipeline")
System_Boundary(community, "Community platform") {
  Container(web, "Web app", "Angular", "Shell, partners feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Profiles, roles, contacts, partners and audit log")
}
Rel(lead, web, "Uses", "HTTPS")
Rel(staff, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS, OAuth2 bearer token")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
