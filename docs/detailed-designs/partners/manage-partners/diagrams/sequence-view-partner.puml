@startuml
title UML sequence behaviour — View a partner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead or Staff" as actor
box "Frontend — FaithTech Community web app (partners library)" #E0F2FE
  participant "PartnerPage" as page
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetPartnerHandler" as h
  participant "PartnerAccessPolicy" as pol
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open partner
page -> svc : get(id)
svc -> ep : GET /api/partners/{id}
ep -> h : Send GetPartnerQuery
h -> pol : CanRead(caller)
alt not lead, Staff or System Admin
  h --> ep : Forbidden (L2-017 AC4)
  ep --> svc : 403 ProblemDetails
else permitted
  h -> db : Load shared Partner record (L2-017 AC2)
  h --> ep : PartnerDto with canEdit flag
  ep --> svc : 200 OK
  svc --> page : Partner
  page --> actor : Show partner, edit hidden for Staff
end
@enduml
