@startuml
title UML sequence behaviour — View a partner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member with ViewPartners" as actor
box "Frontend — Community web app (partners library)" #E0F2FE
  participant "PartnerPage" as page
  participant "PartnerFormPage" as form
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ManagePartnersHandler" as h
  participant "PartnerAccess" as acc
  participant "PartnerViews" as views
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /partners/{id}
page -> svc : get(id)
svc -> ep : GET /api/partners/{id}
ep -> h : GetAsync(id)
h -> acc : CanRead: Has(ViewPartners) or Has(ManagePartners)
alt lacks ViewPartners
  h --> ep : Forbidden (L2-017 AC4)
  ep --> svc : 403
else permitted
  h -> db : Load the shared Partner (L2-017 AC2)
  alt unknown id
    h --> ep : NotFound
    ep --> svc : 404
    svc --> page : Error
    page --> actor : Not-found state
  else found
    h -> views : ToDtoAsync(partner)
    views -> db : Owner name, last activity and next step
    h --> ep : PartnerDto with Version, LastActivityOn, NextStep and CanEdit
    ep --> svc : 200 OK
    svc --> page : Partner
    page --> actor : Details and the activity timeline (partner-activity-timeline);\nEdit and Move hidden when CanEdit is false (no ManagePartners, archived)
  end
end
opt Edit (CanEdit)
  actor -> page : Choose Edit
  page -> form : Navigate to /partners/{id}/edit
  form -> svc : get(id) and owners()
  actor -> form : Change details and save
  form -> svc : update(id, request)
  svc -> ep : PUT /api/partners/{id}
  ep -> h : UpdateAsync(id, command)
  h -> acc : CanWrite, then AuditAdminWrite(..., "partner.updated") when IsOverride
  h -> db : Save Partner (stage unchanged)
  ep --> svc : 200 PartnerDto (400, 403 or 404 otherwise)
  form --> actor : Navigate back to /partners/{id}
end
@enduml
