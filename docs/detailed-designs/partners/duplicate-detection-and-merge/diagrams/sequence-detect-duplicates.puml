@startuml
title UML sequence behaviour — Detect and dismiss a possible duplicate
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead, Staff or System Admin" as actor
box "Frontend — FaithTech Community web app (partners library)" #E0F2FE
  participant "PartnerPage" as page
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "PartnerDuplicatesHandler" as h
  participant "PartnerDuplicateRules" as rules
  participant "PartnerAccess" as acc
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /partners/{id}
page -> svc : get(id)
svc --> page : PartnerDto (not archived)
page -> svc : duplicates(id)
svc -> ep : GET /api/partners/{id}/duplicates
ep -> h : ListAsync(id)
h -> acc : CanRead
alt not a lead, Staff or System Admin
  ep --> svc : 403
else permitted
  h -> db : (Id, Name, Website) of every partner where ArchivedAtUtc is null (L2-113 AC8)
  loop each other active partner
    h -> rules : Match(key(partner), key(other))
    rules --> h : Website when hosts equal (AC1), else Name when names equal (AC2), else none;\nemail domain never compared (AC3)
  end
  h -> db : Dismissals naming this partner; drop dismissed pairs
  h -> db : Added entry (who, when) of each match
  ep --> svc : 200 {matches} ordered by name
  alt at least one match
    page --> actor : Warning alert (role status, icon) naming the first match,\nwho added it and when, "and N more" (AC4, AC5);\nStaff see it without Compare and merge and Not the same
  end
end
opt Not the same (canEdit)
  actor -> page : Choose Not the same
  page -> svc : dismissDuplicate(id, otherId)
  svc -> ep : POST /api/partners/{id}/duplicates/{otherId}/dismissal
  ep -> h : DismissAsync(id, otherId)
  h -> acc : CanWrite
  alt Staff or no lead role
    ep --> svc : 403 (L2-113 AC7)
  else permitted
    h -> db : Insert PartnerDuplicateDismissal.For(id, otherId, caller, now)\nonce per ordered pair (L2-113 AC6)
    h -> acc : AuditAdminWrite(..., "partner.duplicate.dismissed")
    ep --> svc : 204
    page -> svc : duplicates(id)
    page --> actor : Alert gone for every lead on both partners; toast; focus to heading
  end
end
@enduml
