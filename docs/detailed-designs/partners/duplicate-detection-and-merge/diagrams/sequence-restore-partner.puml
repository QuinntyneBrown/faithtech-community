@startuml
title UML sequence behaviour — Restore a merged partner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "System Admin" as actor
box "Frontend — FaithTech Community web app (partners library)" #E0F2FE
  participant "PartnerPage" as page
  participant "RestorePartnerDialog" as dlg
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "RestorePartnerHandler" as h
  participant "PartnerAccess" as acc
  participant "Partner (archived, kept)" as ent
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Open /partners/{archivedId}
page -> svc : get(id)
svc --> page : PartnerDto with archived {mergedInto..., mergedBy..., mergedAtUtc} and canRestore
page --> actor : "{name} was merged into {kept}", who and when, Open {kept} (L2-089 AC7);\nRestore only when canRestore (L2-090 AC5)
actor -> page : Choose Restore
page -> dlg : Open with name, kept name, versions
actor -> dlg : Confirm Restore
dlg -> svc : restore(id, {version, mergedIntoVersion})
svc -> ep : POST /api/partners/{id}/restore
ep -> h : RestoreAsync(id, command)
h -> acc : CanRestore
alt not a System Admin (lead roles included)
  ep --> svc : 403, nothing changes (L2-090 AC5)
else System Admin
  h -> db : Load partner and its kept partner
  alt unknown
    ep --> svc : 404
  else not archived, kept partner archived, or a version differs
    ep --> svc : 409, nothing changes (L2-090 AC6)
  else ready
    h -> db : Activities and stage changes with MergedFromPartnerId = id
    h -> ent : MoveBack() on each (L2-090 AC4)
    h -> ent : partner.Restore(); kept.TouchForRestore(); both Version + 1
    h -> ent : PartnerActivity.Restored on both partners
    h -> acc : Audit(actor, partner, "partner.restored")
    acc -> audit : Record
    h -> db : One SaveChanges
    ep --> svc : 200 restored PartnerDto
    dlg --> page : Close with the partner
    page --> actor : Active partner with its own timeline; toast "{name} restored"
  end
end
@enduml
