@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Duplicate detection and merge
Person(lead, "Member with ManagePartners", "Dismisses and merges duplicates")
Person(staff, "Member with view capabilities", "Holds ViewPartners without ManagePartners; sees warnings read-only")
System_Boundary(community, "Community platform") {
  Container(web, "Web app", "Angular", "Shell, partners feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Partners with versions and archive fields, activities, stage changes, dismissals and audit log")
}
Rel(lead, web, "Uses", "HTTPS")
Rel(staff, web, "Uses", "HTTPS")
Rel(web, api, "duplicates, dismissal, merge, restore", "JSON/HTTPS, OAuth2 bearer token")
Rel(api, db, "Reads and writes in one transaction per request", "EF Core")
@enduml
