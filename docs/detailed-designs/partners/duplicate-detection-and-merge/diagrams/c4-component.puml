@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Duplicate detection and merge
Container_Boundary(web, "Web app") {
  Component(page, "PartnerPage", "Angular page (partners library)", "Duplicate warning, archived state")
  Component(merge, "MergePartnersDialog", "Angular CDK Dialog (partners library)", "Per-field choices, busy and failed states")
  Component(restore, "RestorePartnerDialog", "Angular CDK Dialog (partners library)", "System Admin confirm")
  Component(lib, "components library", "Angular library", "ft-alert, ft-radio-group, ft-dialog, ToastService")
  Component(svc, "HttpPartnersService", "Angular service (api library)", "duplicates, dismissDuplicate, merge, restore")
}
Container_Boundary(api, "Community API") {
  Component(ep, "PartnersEndpoints", "ASP.NET Core minimal API", "GET duplicates; POST dismissal, merge, restore")
  Component(val, "MergePartnersValidator", "FluentValidation", "OtherId, versions, choices")
  Component(dup, "PartnerDuplicatesHandler", "Application handler", "ListAsync, DismissAsync")
  Component(rules, "PartnerDuplicateRules", "Pure static class", "NormaliseHost, NormaliseName, Match (ADR 0027)")
  Component(mh, "MergePartnersHandler", "Application handler", "MergeAsync (ADR 0028)")
  Component(rh, "RestorePartnerHandler", "Application handler", "RestoreAsync (ADR 0028)")
  Component(acc, "PartnerAccess", "Application permission check", "CanRead, CanWrite, CanRestore, Audit")
  Component(views, "PartnerViews", "Application service", "PartnerDto with archived and canRestore")
  Component(search, "PartnersSearchSource", "Application search source", "Leaves archived partners out")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "Partners (Version token), PartnerActivities, PartnerStageChanges, PartnerDuplicateDismissals")
}
Rel(page, merge, "Opens with DialogService")
Rel(page, restore, "Opens with DialogService")
Rel(page, lib, "Composes")
Rel(merge, lib, "Composes")
Rel(restore, lib, "Composes")
Rel(page, svc, "duplicates, dismissDuplicate, get")
Rel(merge, svc, "merge")
Rel(restore, svc, "restore")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, val, "Validates merge body (400)")
Rel(ep, dup, "Calls")
Rel(ep, mh, "Calls")
Rel(ep, rh, "Calls")
Rel(dup, rules, "Match")
Rel(dup, acc, "CanRead, CanWrite (L2-113)")
Rel(mh, acc, "CanWrite, Audit (L2-115)")
Rel(rh, acc, "CanRestore, Audit (L2-115)")
Rel(mh, views, "Builds PartnerDto")
Rel(acc, audit, "partners.merged, partner.restored")
Rel(dup, db, "Queries and inserts", "EF Core")
Rel(mh, db, "One SaveChanges", "EF Core")
Rel(rh, db, "One SaveChanges", "EF Core")
Rel(search, db, "ArchivedAtUtc is null", "EF Core")
@enduml
