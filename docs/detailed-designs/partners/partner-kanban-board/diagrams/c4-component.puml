@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Partner Kanban board
Container_Boundary(web, "Web app") {
  Component(page, "PartnersPage", "Angular page", "Board of three stage columns")
  Component(kb, "Kanban column and card", "components library", "Accessible drag-and-drop columns")
  Component(dlg, "MovePartnerDialog", "Angular CDK Dialog", "Keyboard and pointer move")
  Component(svc, "HttpPartnersService", "Angular service", "Implements PartnersService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "PartnersEndpoints", "ASP.NET Core minimal API", "GET /api/partners, POST /api/partners/{id}/stage")
  Component(h, "ListPartnersHandler / MovePartnerHandler", "Application handler", "Lists and moves partners")
  Component(pol, "PartnerAccessPolicy", "Application permission check", "Read and write rules")
  Component(ent, "Partner", "Domain entity", "Records stage changes")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, kb, "Composes")
Rel(page, dlg, "Opens")
Rel(page, svc, "Calls")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "Sends command or query")
Rel(h, pol, "Checks access")
Rel(h, ent, "MoveTo")
Rel(h, db, "Persists", "EF Core")
@enduml
