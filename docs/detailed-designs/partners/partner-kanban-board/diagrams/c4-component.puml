@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Partner Kanban board
Container_Boundary(web, "Web app") {
  Component(page, "PartnersPage", "Angular page (partners library)", "One column per active stage in the board")
  Component(kb, "KanbanBoard / KanbanColumn / KanbanCard", "components library", "CDK drag and drop columns and cards with a Move button; column tabs below 640px")
  Component(bp, "BreakpointService", "components library", "Current breakpoint")
  Component(dlg, "MovePartnerDialog", "Angular CDK Dialog (partners library)", "Stage radio and optional note; keyboard path")
  Component(svc, "HttpPartnersService", "Angular service (api library)", "getBoard and move")
}
Container_Boundary(api, "Community API") {
  Component(ep, "PartnersEndpoints", "ASP.NET Core minimal API", "GET /api/partners, POST /api/partners/{id}/stage")
  Component(val, "MovePartnerValidator", "FluentValidation", "Active stage key; note at most 500 characters")
  Component(bh, "ManagePartnersHandler", "Application handler", "BoardAsync")
  Component(mh, "MovePartnerHandler", "Application handler", "MoveAsync")
  Component(acc, "PartnerAccess", "Application permission check", "CanRead, CanWrite, AuditAdminWrite")
  Component(ent, "Partner", "Domain entity", "MoveTo appends a PartnerStageChange")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "Partners and PartnerStageChanges tables")
}
Rel(page, kb, "Composes")
Rel(kb, bp, "Reads")
Rel(page, dlg, "Opens from the card's Move button")
Rel(dlg, svc, "move(id, to, note)")
Rel(page, svc, "getBoard / move on drop")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, val, "Validates move (400)")
Rel(ep, bh, "BoardAsync")
Rel(ep, mh, "MoveAsync")
Rel(bh, acc, "CanRead")
Rel(mh, acc, "CanWrite; audits override moves (L2-135 AC5)")
Rel(mh, ent, "MoveTo")
Rel(bh, db, "Reads partners", "EF Core")
Rel(mh, db, "Saves Partner and PartnerStageChange", "EF Core")
@enduml
