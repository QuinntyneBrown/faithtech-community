@startuml
title UML sequence behaviour — Load the board
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead or Staff" as actor
box "Frontend — FaithTech Community web app (partners library)" #E0F2FE
  participant "PartnersPage" as page
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ListPartnersHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open partners
page -> svc : list()
svc -> ep : GET /api/partners
ep -> h : Send ListPartnersQuery
h -> h : PartnerAccessPolicy.CanRead (L2-017 AC4)
h -> db : Select partners grouped by stage
h --> ep : Board with Lead, In Funnel, Confirmed and counts (L2-018 AC1)
ep --> svc : 200 OK
svc --> page : Board
alt XS viewport
  page --> actor : Stage tabs, one column visible (L2-018 AC4)
else larger
  page --> actor : Three columns side by side
end
@enduml
