@startuml
title UML sequence behaviour — Load the board
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead or Staff" as actor
box "Frontend — FaithTech Community web app (partners library)" #E0F2FE
  participant "PartnersPage" as page
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ManagePartnersHandler" as h
  participant "PartnerAccess" as acc
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /partners
page -> svc : getBoard()
svc -> ep : GET /api/partners
ep -> h : BoardAsync()
h -> acc : CanRead
alt not a lead, Staff or System Admin
  h --> ep : null
  ep --> svc : 403 (L2-017 AC4)
  svc --> page : Error
  page --> actor : Forbidden state
else permitted
  h -> db : Select Id, Name, ContactName, Offering, Stage of every partner
  h -> h : One PartnerColumnDto per stage in order, cards by name, with counts
  h --> ep : PartnerBoardDto with CanEdit = PartnerAccess.CanWrite (L2-018 AC1)
  ep --> svc : 200 OK
  svc --> page : Board
  alt BreakpointService.current() is base (below sm, 640px)
    page --> actor : Stage tabs, one KanbanColumn visible (L2-018 AC4)
  else larger
    page --> actor : Three KanbanColumns side by side; Add partner and Move hidden when CanEdit is false
  end
end
@enduml
