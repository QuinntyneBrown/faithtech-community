@startuml
title UML sequence behaviour — Move a partner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead" as actor
box "Frontend — FaithTech Community web app (partners library)" #E0F2FE
  participant "PartnersPage" as page
  participant "MovePartnerDialog" as dlg
  participant "HttpPartnersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PartnersEndpoints" as ep
  participant "MovePartnerValidator" as v
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "MovePartnerHandler" as h
  participant "PartnerAccess" as acc
  participant "Partner" as ent
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
alt pointer
  actor -> page : Drag card to another column (KanbanCardDrop)
  page -> svc : move(id, to)
else keyboard or Move button
  actor -> page : Focus card and choose Move (L2-018 AC3)
  page -> dlg : Open with {partnerId, name, stage}
  actor -> dlg : Choose another stage and an optional note
  dlg -> svc : move(id, to, note)
end
svc -> ep : POST /api/partners/{id}/stage
ep -> v : Validate To and Note
ep -> h : MoveAsync(id, command)
h -> acc : CanWrite
alt Staff or no lead role
  ep --> svc : 403 (L2-017 AC3)
else unknown partner
  ep --> svc : 404
else already at that stage
  ep --> svc : 409 "{name} is already at that stage."
else permitted
  h -> db : Load Partner with StageChanges
  h -> ent : MoveTo(to, caller, nowUtc, note) (L2-018 AC2)
  h -> acc : AuditAdminWrite(actor, partner, "partner.moved")
  h -> h : PartnerActivity.StageMoved(change) (L2-110 AC7)
  h -> db : Save Partner, new PartnerStageChange and StageMoved activity
  h --> ep : PartnerDto
  ep --> svc : 200 OK
  svc --> page : Moved partner (the dialog closes with it)
  page --> actor : Card in new column, counts updated, "{name} moved to {stage}" announced
end
note over page : A failed drag leaves the card where it was and shows a toast;\na failed dialog move shows an alert in the dialog
@enduml
