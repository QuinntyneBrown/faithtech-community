@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Partner Kanban board
enum PartnerStage {
  Lead
  InFunnel
  Confirmed
}
class Partner {
  +Guid Id
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +PartnerStage Stage
  +IReadOnlyCollection<PartnerStageChange> StageChanges
  +Update(name, website, offering, ownerId, contactName, email, phone, notes): void
  +MoveTo(stage: PartnerStage, by: Guid, nowUtc: DateTime, note: string?): void
}
class PartnerStageChange {
  +Guid Id
  +Guid PartnerId
  +PartnerStage From
  +PartnerStage To
  +Guid MovedBy
  +DateTime MovedAtUtc
  +string? Note
}
class PartnerAccess {
  +bool CanRead
  +bool CanWrite
  +CallerProfileIdAsync(): Task<Guid>
  +AuditAdminWrite(actor: Guid, partner: Partner, action: string, before: object?, after: object?): void
}
class PartnerViews {
  +ToDtoAsync(partner: Partner): Task<PartnerDto>
}
interface ICurrentUser {
  +Guid? UserId
  +IReadOnlyCollection<Role> Roles
  +HasRole(role: Role): bool
}
class LeadRoles <<static>> {
  +{static} All: IReadOnlyList<Role>
  +{static} HoldsLeadRole(current: ICurrentUser): bool
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
Partner --> PartnerStage
Partner "1" *-- "*" PartnerStageChange
PartnerAccess ..> ICurrentUser
PartnerAccess ..> LeadRoles
PartnerAccess ..> IAuditLog : System Admin without a lead role
PartnerViews --> PartnerAccess : CanEdit
class PartnerDto <<record>> {
  +Guid Id
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? OwnerName
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +string Stage
  +IReadOnlyList<PartnerStageChangeDto> History
  +bool CanEdit
}
class PartnerStageChangeDto <<record>> {
  +string From
  +string To
  +Guid MovedById
  +string MovedByName
  +DateTime MovedAtUtc
  +string? Note
}
PartnerViews ..> PartnerDto : builds
PartnerDto "1" *-- "*" PartnerStageChangeDto : newest first

class MovePartnerCommand <<record>> {
  +string? To
  +string? Note
}
class MovePartnerValidator {
  +MaxNote = 500
}
class MovePartnerHandler {
  +MoveAsync(id: Guid, command: MovePartnerCommand): Task<(Result, PartnerDto?)>
}
class ManagePartnersHandler {
  +BoardAsync(): Task<PartnerBoardDto?>
}
class PartnerBoardDto <<record>> {
  +IReadOnlyList<PartnerColumnDto> Columns
  +bool CanEdit
}
class PartnerColumnDto <<record>> {
  +string Stage
  +int Count
  +IReadOnlyList<PartnerCardDto> Cards
}
class PartnerCardDto <<record>> {
  +Guid Id
  +string Name
  +string? ContactName
  +string? Offering
}
MovePartnerValidator ..> MovePartnerCommand
MovePartnerHandler ..> MovePartnerCommand : handles
MovePartnerHandler --> Partner : MoveTo
MovePartnerHandler --> PartnerAccess
MovePartnerHandler --> PartnerViews
ManagePartnersHandler --> PartnerAccess
ManagePartnersHandler ..> PartnerBoardDto : returns
PartnerBoardDto "1" *-- "3" PartnerColumnDto
PartnerColumnDto "1" *-- "*" PartnerCardDto
@enduml
