@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Partner Kanban board
enum PartnerStageKind {
  Open
  Confirmed
}
class PartnerStage {
  +Guid Id
  +Guid OrganisationId
  +string Key
  +string Name
  +int SortOrder
  +bool IsInitial
  +PartnerStageKind Kind
  +bool IsArchived
}
PartnerStage --> PartnerStageKind
class Partner {
  +Guid Id
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +string StageKey
  +IReadOnlyCollection<PartnerStageChange> StageChanges
  +Update(name, website, offering, ownerId, contactName, email, phone, notes): void
  +MoveTo(stageKey: string, by: Guid, nowUtc: DateTime, note: string?): void
}
class PartnerStageChange {
  +Guid Id
  +Guid PartnerId
  +string From
  +string To
  +Guid MovedBy
  +DateTime MovedAtUtc
  +string? Note
}
class PartnerAccess {
  +bool CanRead
  +bool CanWrite
  +CallerProfileIdAsync(): Task<Guid>
  +AuditAdminWrite(actor: Guid, partner: Partner, action: string, before: object?, after: object?): void
}
class PartnerViews {
  +ToDtoAsync(partner: Partner): Task<PartnerDto>
}
interface ICurrentUser {
  +Guid? UserId
  +IReadOnlyCollection<HeldRole> Roles
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface ICurrentOrganisation {
  +Guid Id
}
class Capability <<static>> {
  +{static} ViewPartners: string
  +{static} ManagePartners: string
  +{static} AdministerOrganisation: string
}
class AuthorizationRules <<static>> {
  +{static} IsOverride(actor: ICurrentUser, capability: string): bool
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
Partner --> PartnerStage : StageKey
Partner "1" *-- "*" PartnerStageChange
PartnerAccess ..> ICurrentUser
PartnerAccess ..> Capability
PartnerAccess ..> AuthorizationRules : IsOverride
PartnerAccess ..> IAuditLog : override by AdministerOrganisation
PartnerViews --> PartnerAccess : CanEdit
class PartnerDto <<record>> {
  +Guid Id
  +string Name
  +string? Website
  +string? Offering
  +Guid? OwnerId
  +string? OwnerName
  +string? ContactName
  +string? Email
  +string? Phone
  +string? Notes
  +string Stage
  +IReadOnlyList<PartnerStageChangeDto> History
  +bool CanEdit
}
class PartnerStageChangeDto <<record>> {
  +string From
  +string To
  +Guid MovedById
  +string MovedByName
  +DateTime MovedAtUtc
  +string? Note
}
PartnerViews ..> PartnerDto : builds
PartnerDto "1" *-- "*" PartnerStageChangeDto : newest first

class MovePartnerCommand <<record>> {
  +string? To
  +string? Note
}
class MovePartnerValidator {
  +MaxNote = 500
}
class MovePartnerHandler {
  +MoveAsync(id: Guid, command: MovePartnerCommand): Task<(Result, PartnerDto?)>
}
class ManagePartnersHandler {
  +BoardAsync(): Task<PartnerBoardDto?>
}
class PartnerBoardDto <<record>> {
  +IReadOnlyList<PartnerColumnDto> Columns
  +bool CanEdit
}
class PartnerColumnDto <<record>> {
  +string StageKey
  +string StageName
  +bool ArchivedStage
  +int Count
  +IReadOnlyList<PartnerCardDto> Cards
}
class PartnerCardDto <<record>> {
  +Guid Id
  +string Name
  +string? ContactName
  +string? Offering
}
MovePartnerValidator ..> MovePartnerCommand
MovePartnerHandler ..> MovePartnerCommand : handles
MovePartnerHandler --> Partner : MoveTo
MovePartnerHandler --> PartnerAccess
MovePartnerHandler --> PartnerViews
ManagePartnersHandler --> PartnerAccess
ManagePartnersHandler ..> ICurrentOrganisation : stages and partners scoped by the global filter
ManagePartnersHandler ..> PartnerBoardDto : returns
PartnerBoardDto "1" *-- "*" PartnerColumnDto : one per stage in order
PartnerColumnDto "1" *-- "*" PartnerCardDto
@enduml
