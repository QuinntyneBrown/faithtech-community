@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Work items

Container_Boundary(web, "Web app") {
  Component(page, "BacklogPage / WorkItemPage", "Angular page", "Tree, filters and item detail")
  Component(dlg, "WorkItemDialog", "CDK Dialog", "Creates or edits an item")
  Component(svc, "AgileService", "api library", "AGILE_SERVICE token, HttpAgileService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "WorkItemsEndpoints", "Minimal API", "Item, backlog and comment routes")
  Component(val, "CreateWorkItemValidator / UpdateWorkItemValidator", "Application (FluentValidation)", "Kind, title, description, points, status; run by ValidationEndpointFilter")
  Component(h, "WorkItemsHandler", "Application", "Create, get, update, set done, comment, backlog")
  Component(pol, "WorkspaceAccessPolicy", "Application", "Owner, member, Reader, Admin (AdministerOrganisation), outsider")
  Component(ntf, "AgileNotifier", "Application", "In-app notification and email to the assignee")
  Component(ent, "WorkItem", "Domain entity", "Hierarchy and fields")
  Component(mail, "IEmailQueue", "Infrastructure (OutboxEmailQueue)", "Queues the email in the unit of work")
  ComponentDb(db, "Community database", "PostgreSQL", "Agile tables")
}

Rel(page, dlg, "Opens")
Rel(page, svc, "Calls")
Rel(dlg, svc, "Calls")
Rel(svc, ep, "Calls", "JSON/HTTPS")
Rel(ep, val, "Validates body with")
Rel(ep, h, "Calls")
Rel(h, pol, "Checks access")
Rel(h, ent, "Creates and mutates")
Rel(h, ntf, "Notifies assignee")
Rel(ntf, mail, "Enqueue")
Rel(h, db, "Persists", "EF Core")
@enduml
