@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Work items

enum WorkItemKind {
  Initiative
  Epic
  Story
  Task
}
enum WorkItemStatus {
  ToDo
  InProgress
  Done
}
class WorkItem {
  +Guid Id
  +Guid WorkspaceId
  +WorkItemKind Kind
  +string Title
  +string Description
  +WorkItemStatus Status
  +Guid? AssigneeId
  +Guid? ParentId
  +int? StoryPoints
  +bool IsDone
  +Guid? SprintId
  +bool IsArchived
  +Edit(title: string, description: string): void
  +SetParent(parent: WorkItem): void
  +Assign(profileId: Guid?, workspace: Workspace): void
  +SetStatus(status: WorkItemStatus): void
  +SetDone(done: bool): void
  +SetStoryPoints(points: int?): void
  +AddComment(authorId: Guid, body: string, now: DateTimeOffset): Comment
  +MoveToSprint(sprint: Sprint): void
}
class Comment {
  +Guid Id
  +Guid WorkItemId
  +Guid AuthorId
  +string Body
  +DateTimeOffset CreatedAt
}
class WorkItemHierarchy {
  +{static} CanParent(parent: WorkItemKind, child: WorkItemKind): bool
}
class CreateWorkItemCommand <<record>> {
  +string? Kind
  +string? Title
  +string? Description
  +Guid? ParentId
  +Guid? AssigneeId
  +int? StoryPoints
}
class UpdateWorkItemCommand <<record>> {
  +string? Title
  +string? Description
  +Guid? AssigneeId
  +int? StoryPoints
  +string? Status
}
class SetDoneCommand <<record>> {
  +bool Done
}
class AddCommentCommand <<record>> {
  +string? Body
}
class WorkItemsHandler {
  +CreateAsync(workspaceId: Guid, cmd: CreateWorkItemCommand): Task<(Result, WorkItemDto?)>
  +GetAsync(itemId: Guid): Task<WorkItemDto?>
  +UpdateAsync(itemId: Guid, cmd: UpdateWorkItemCommand): Task<Result>
  +SetDoneAsync(itemId: Guid, cmd: SetDoneCommand): Task<Result>
  +AddCommentAsync(itemId: Guid, cmd: AddCommentCommand): Task<(Result, CommentDto?)>
  +BacklogAsync(workspaceId: Guid, initiativeId: Guid?, epicId: Guid?, noEpic: bool): Task<IReadOnlyList<BacklogNodeDto>?>
}
class WorkItemRules <<static>> {
  +{static} NeedsManage(kind: WorkItemKind): bool
  +{static} ParentProblem(kind: WorkItemKind, parent: WorkItem?, workspaceId: Guid): string?
}
class CreateWorkItemValidator
class UpdateWorkItemValidator
class AddCommentValidator
class WorkspaceAccessPolicy
class AgileNotifier
WorkItem "1" *-- "*" Comment
WorkItem "0..1" o-- "*" WorkItem : parent / children
WorkItem --> WorkItemKind
WorkItem --> WorkItemStatus
WorkItem ..> WorkItemHierarchy
CreateWorkItemValidator ..> CreateWorkItemCommand : validates
UpdateWorkItemValidator ..> UpdateWorkItemCommand : validates
AddCommentValidator ..> AddCommentCommand : validates
WorkItemsHandler ..> CreateWorkItemCommand : handles
WorkItemsHandler ..> UpdateWorkItemCommand : handles
WorkItemsHandler ..> SetDoneCommand : handles
WorkItemsHandler ..> AddCommentCommand : handles
WorkItemsHandler ..> WorkItemRules
WorkItemsHandler --> WorkspaceAccessPolicy : authorizes with
WorkItemsHandler --> AgileNotifier : notifies assignee
WorkItemsHandler --> WorkItem : creates, mutates, reads
@enduml
