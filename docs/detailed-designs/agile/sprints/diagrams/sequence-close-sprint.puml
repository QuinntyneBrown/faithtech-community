@startuml
title UML sequence behaviour — Close a sprint
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace owner" as actor
box "Frontend — Community platform web app (agile library)" #E0F2FE
  participant "BoardPage" as page
  participant "CloseSprintDialog" as dlg
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "WorkspacesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "SprintsHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "Sprint" as ent
  participant "WorkItem (stories)" as wi
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Choose "Close sprint" on the board
page -> dlg : Open with the sprint and the cards not in Done
dlg --> actor : "N of M points completed"; unfinished stories that return to the backlog
actor -> dlg : Confirm "Close sprint"
dlg -> svc : closeSprint(workspaceId, sprintId)
svc -> ep : POST /api/workspaces/{id}/sprints/{sprintId}/close
ep -> h : CloseAsync(workspaceId, sprintId)
h -> pol : AuthorizeAsync(workspaceId, manage = true)
pol --> h : Workspace and caller (non-owner 403, outsider 404)
h -> ctx : Load sprint of this workspace
ctx -> db : SELECT
db --> ctx : Sprint or none
alt sprint missing
h --> ep : Result.NotFound
ep --> svc : 404 Not Found
else already closed
h --> ep : Result.Conflict("This sprint is already closed.")
ep --> svc : 409 Problem
else open
h -> ctx : Load the sprint's stories (IgnoreQueryFilters: archived ones count too)
ctx -> db : SELECT
db --> ctx : Rows
h -> ent : Close(stories)
ent -> ent : CompletedPoints = sum of Done points; CommittedPoints = sum of all points (L2-035 AC3)
loop each story not Done
ent -> wi : ReturnToBacklog(): SprintId = null
end
ent -> ent : State = Closed
h -> pol : AuditOverride(caller, "sprint.closed", ...) (AdministerOrganisation override only, L2-135 AC5)
h -> ctx : SaveChangesAsync
ctx -> db : UPDATE sprint and work items in one transaction
h --> ep : Result.Ok
ep --> svc : 204 No Content
svc --> dlg : Done
dlg --> page : Close with true
page --> actor : Toast "<sprint> closed"; board reloaded
note over page : BacklogPage history now lists "completed N of M points" and the average of the last three (L2-035 AC4)
end
@enduml
