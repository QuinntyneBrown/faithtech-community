@startuml
title UML sequence behaviour — Close a sprint
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace owner" as actor
box "Frontend — FaithTech Community web app (agile library)" #E0F2FE
  participant "BacklogPage" as page
  participant "CloseSprintDialog" as dlg
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "SprintsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "CloseSprintHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "Sprint" as ent
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Choose "Close sprint"
page -> dlg : Open confirmation with unfinished count
actor -> dlg : Confirm
dlg -> svc : closeSprint(sprintId)
svc -> ep : POST /sprints/{id}/close
ep -> h : Send CloseSprintCommand
h -> pol : EnsureOwner(workspaceId)
pol --> h : Allowed
h -> ctx : Load sprint and its stories
ctx -> db : SELECT
db --> ctx : Rows
h -> ent : Close(stories): clear SprintId where Status != Done, CompletedPoints = sum of Done points (L2-035 AC3)
h -> ctx : SaveChanges
ctx -> db : UPDATE sprint and work_items in one transaction
h --> ep : SprintDto
ep --> svc : 200 OK
svc --> page : Refresh backlog and history
page --> actor : Show history with completed points per sprint (L2-035 AC4)
@enduml