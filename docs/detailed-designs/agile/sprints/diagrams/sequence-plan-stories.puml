@startuml
title UML sequence behaviour — Move stories into a sprint
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace member" as actor
box "Frontend — FaithTech Community web app (agile library)" #E0F2FE
  participant "BacklogPage" as page
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "SprintsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "MoveStoriesToSprintHandler" as h
  participant "WorkspaceAccessPolicy" as pol
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Drag or move stories into sprint
page -> svc : moveStoriesToSprint(sprintId, storyIds)
svc -> ep : POST /sprints/{id}/stories
ep -> h : Send MoveStoriesToSprintCommand
h -> pol : EnsureMember(workspaceId)
pol --> h : Allowed
h -> ctx : Set SprintId on stories; sprint is Planned or Active (L2-035 AC2)
ctx -> db : UPDATE work_items
db --> ctx : Committed
h --> ep : Result
ep --> svc : 204 No Content
svc --> page : Refresh
page --> actor : Stories shown in sprint
@enduml