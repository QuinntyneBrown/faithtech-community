@startuml
title UML sequence behaviour — Start a sprint
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace owner" as actor
box "Frontend — FaithTech Community web app (agile library)" #E0F2FE
  participant "BacklogPage" as page
  participant "StartSprintDialog" as dlg
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "SprintsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "StartSprintHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "Sprint" as ent
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Choose "Start sprint"
page -> dlg : Open dialog
actor -> dlg : Enter name, goal, start and end date
dlg -> svc : startSprint(workspaceId, request)
svc -> ep : POST /workspaces/{id}/sprints
ep -> h : Send StartSprintCommand
h -> pol : EnsureOwner(workspaceId)
pol --> h : Allowed (non-owner 403)
h -> ctx : Any active sprint in workspace
ctx -> db : SELECT
db --> ctx : Result
alt end date not after start date, or a sprint is already active
h --> ep : Validation failure (L2-035 AC1)
ep --> svc : 400 / 409 ProblemDetails
svc --> dlg : Error
dlg --> actor : Show error
else valid
h -> ent : Start() sets State = Active (L2-035 AC1)
h -> ctx : SaveChanges
ctx -> db : INSERT or UPDATE sprint (unique active index)
h --> ep : SprintDto
ep --> svc : 201 Created
svc --> page : Sprint
page --> actor : Show active sprint
end
@enduml