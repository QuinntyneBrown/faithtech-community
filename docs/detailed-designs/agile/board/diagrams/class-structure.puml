@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Board

class BoardDto {
  +string Method
  +BoardSprintDto? Sprint
  +IReadOnlyList<BoardColumnDto> Columns
}
class BoardSprintDto {
  +Guid Id
  +string Name
  +string Goal
  +DateOnly StartDate
  +DateOnly EndDate
  +int CompletedPoints
  +int TotalPoints
}
class BoardColumnDto {
  +string Status
  +IReadOnlyList<BoardCardDto> Cards
}
class BoardCardDto {
  +Guid Id
  +string Title
  +Guid? AssigneeId
  +string? AssigneeName
  +int? StoryPoints
  +int TasksDone
  +int TasksTotal
}
class MoveCardCommand {
  +string? Status
}
class MoveCardValidator
class BoardHandler {
  +GetAsync(workspaceId: Guid, initiativeId: Guid?, epicId: Guid?, noEpic: bool): Task<BoardDto?>
  +MoveAsync(itemId: Guid, command: MoveCardCommand): Task<Result>
}
class WorkspaceAccessPolicy {
  +LoadAsync(workspaceId: Guid): Task<(Workspace?, WorkspaceCaller)>
  +AuthorizeAsync(workspaceId: Guid, manage: bool): Task<(Workspace, WorkspaceCaller, Result?)>
  +AuditOverride(caller: WorkspaceCaller, action: string, ...): void
}
interface IBoardNotifier {
  +CardMovedAsync(workspaceId: Guid, itemId: Guid, status: string): Task
}
class SignalRAgileNotifier {
  +CardMovedAsync(workspaceId: Guid, itemId: Guid, status: string): Task
  +PokerChangedAsync(sessionId: Guid): Task
}
class AgileHub {
  +WatchBoard(workspaceId: Guid): Task
  +WatchPokerSession(sessionId: Guid): Task
  {static} +BoardGroup(workspaceId: Guid): string
}
class WorkItemsEndpoints <<static>>
class WorkItem {
  +WorkItemStatus Status
  +SetStatus(status: WorkItemStatus): void
}
BoardDto "1" *-- "3" BoardColumnDto
BoardDto "1" o-- "0..1" BoardSprintDto
BoardColumnDto "1" *-- "*" BoardCardDto
MoveCardValidator ..> MoveCardCommand : validates
WorkItemsEndpoints ..> BoardHandler : dispatches
BoardHandler ..> BoardDto : returns
BoardHandler ..> WorkItem : reads
BoardHandler ..> MoveCardCommand : handles
BoardHandler --> WorkItem : sets Status
BoardHandler --> WorkspaceAccessPolicy
BoardHandler --> IBoardNotifier
SignalRAgileNotifier ..|> IBoardNotifier
SignalRAgileNotifier ..> AgileHub : IHubContext<AgileHub>
AgileHub --> WorkspaceAccessPolicy
@enduml
