@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Board

Container_Boundary(web, "Web app") {
  Component(page, "BoardPage", "Angular page (agile)", "Columns, cards, drag and keyboard moves, initiative/epic filter; reloads on CardMoved")
  Component(dlg, "MoveCardDialog", "CDK Dialog (agile)", "To Do / In Progress / Done radio group")
  Component(kanban, "KanbanBoardComponent", "components library", "ft-kanban-board; tabs below sm (640px)")
  Component(svc, "AgileService / HttpAgileService", "api library (AGILE_SERVICE)", "getBoard, moveCard")
  Component(live, "AgileLiveService / SignalRAgileLiveService", "api library (AGILE_LIVE_SERVICE)", "watchBoard; emits moved and resync")
}
Container_Boundary(api, "Community API") {
  Component(ep, "WorkItemsEndpoints", "Minimal API", "GET /api/workspaces/{id}/board, PUT /api/items/{id}/status")
  Component(hub, "AgileHub", "SignalR hub (/hubs/agile)", "WatchBoard joins board:{workspaceId}; no business logic")
  Component(bc, "SignalRAgileNotifier", "Api, IBoardNotifier", "Sends CardMoved(itemId, status) to the group")
  Component(h, "BoardHandler", "Application", "GetAsync (board query, filters) and MoveAsync")
  Component(wi, "WorkItemsHandler", "Application", "UpdateAsync broadcasts a status change too")
  Component(pol, "WorkspaceAccessPolicy", "Application", "Member, Staff, System Admin and outsider checks; audits overrides")
  Component(ent, "WorkItem", "Domain entity", "Story status")
  ComponentDb(db, "Community database", "PostgreSQL", "Agile tables")
}

Rel(page, kanban, "Composes")
Rel(page, dlg, "Opens (Move button)")
Rel(page, svc, "getBoard, moveCard")
Rel(dlg, svc, "moveCard")
Rel(page, live, "Subscribes")
Rel(svc, ep, "Calls", "JSON/HTTPS")
Rel(live, hub, "WatchBoard(workspaceId)", "SignalR")
Rel(ep, h, "Dispatches")
Rel(h, pol, "Checks access")
Rel(hub, pol, "Checks access")
Rel(h, ent, "Mutates")
Rel(h, db, "Persists", "EF Core")
Rel(h, bc, "CardMovedAsync via IBoardNotifier")
Rel(wi, bc, "CardMovedAsync on a status change")
Rel(bc, hub, "Sends to group", "IHubContext")
Rel(hub, live, "CardMoved(itemId, status)", "SignalR")
@enduml
