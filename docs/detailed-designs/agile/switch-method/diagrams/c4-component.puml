@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Switch method

Container_Boundary(web, "Web app") {
  Component(page, "WorkspaceSettingsPage", "Angular page", "Method control")
  Component(dlg, "SwitchMethodDialog", "CDK Dialog", "Confirms the switch")
  Component(svc, "AgileService", "api library", "AGILE_SERVICE token")
}
Container_Boundary(api, "Community API") {
  Component(ep, "WorkspacesEndpoints", "Minimal API", "PUT /workspaces/{id}/method")
  Component(h, "SwitchMethodHandler", "Application", "Applies the switch")
  Component(pol, "WorkspaceAccessPolicy", "Application", "Owner check")
  Component(ent, "Workspace", "Domain entity", "SwitchMethod rules")
  ComponentDb(db, "Community database", "PostgreSQL", "Agile tables")
}

Rel(page, dlg, "Opens")
Rel(dlg, svc, "Calls")
Rel(svc, ep, "Calls", "JSON/HTTPS")
Rel(ep, h, "Dispatches")
Rel(h, pol, "Checks owner")
Rel(h, ent, "Calls SwitchMethod")
Rel(h, db, "Persists", "EF Core")
@enduml