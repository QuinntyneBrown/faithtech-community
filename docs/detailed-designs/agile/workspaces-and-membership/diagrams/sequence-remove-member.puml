@startuml
title UML sequence behaviour — Remove a workspace member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace owner" as actor
box "Frontend — Community platform web app (agile library)" #E0F2FE
  participant "WorkspaceSettingsPage" as page
  participant "RemoveWorkspaceMemberDialog" as dlg
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "WorkspacesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "WorkspaceSettingsHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "Workspace" as ent
  participant "IAuditLog" as audit
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Choose "Remove" on a member
page -> dlg : Open confirmation
actor -> dlg : Confirm
dlg -> svc : removeMember(workspaceId, profileId)
svc -> ep : DELETE /api/workspaces/{id}/members/{profileId}
ep -> h : RemoveMemberAsync(id, profileId)
h -> pol : AuthorizeAsync(id, manage: true)
pol --> h : workspace, caller (owner or administrator; otherwise 404 or 403)
alt profileId is the owner
h --> ep : Conflict "The owner can’t be removed from their workspace."
ep --> svc : 409 ProblemDetails
else profile is not a member
h --> ep : NotFound
ep --> svc : 404
else member
h -> ctx : Load the member's assigned items (IgnoreQueryFilters)
ctx -> db : SELECT work_items WHERE assignee_id = profileId
db --> ctx : Rows
h -> ent : RemoveMember(profileId, items)
ent -> ent : Unassign() each item (L2-031 AC8)
opt caller is an AdministerOrganisation override (L2-031 AC7, L2-135 AC5)
h -> pol : AuditOverride("workspace.member.removed")
pol -> audit : Record
end
h -> ctx : SaveChanges
ctx -> db : DELETE workspace_member, UPDATE work_items in one transaction
db --> ctx : Committed
h --> ep : Ok
ep --> svc : 204 No Content
svc --> page : Refresh members
page --> actor : Member removed
end
@enduml
