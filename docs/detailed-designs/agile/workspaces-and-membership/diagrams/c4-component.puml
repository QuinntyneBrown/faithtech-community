@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Agile workspaces and membership

Container_Boundary(web, "Web app") {
  Component(page, "WorkspacesPage / WorkspaceSettingsPage", "Angular pages (agile library)", "List and create workspaces; name, method and members")
  Component(frame, "WorkspaceFrameComponent", "Angular component (agile library)", "Header, tabs and the Read-only for Staff alert")
  Component(dlg, "CreateWorkspaceDialog / AddWorkspaceMembersDialog / RemoveWorkspaceMemberDialog", "CDK Dialogs", "Create, add-members and remove forms")
  Component(svc, "AgileService", "api library", "AGILE_SERVICE token, HttpAgileService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "WorkspacesEndpoints", "Minimal API", "Maps /api/workspaces routes, validates request records")
  Component(h, "WorkspacesHandler / WorkspaceSettingsHandler", "Application", "Create, list, get; add and remove members, rename, switch method, candidates")
  Component(mem, "WorkspaceMembership", "Application", "Adds eligible profiles and notifies them")
  Component(pol, "WorkspaceAccessPolicy", "Application", "Owner → Admin → Member → Staff → Outsider; audits Admin overrides")
  Component(ent, "Workspace", "Domain entity", "Owner, method, members")
  Component(ntf, "AgileNotifier", "Application", "In-app notification plus queued email")
  Component(audit, "IAuditLog", "Application (Admin)", "Audit log abstraction")
  Component(email, "IEmailSender (OutboxEmailSender)", "Infrastructure", "Email outbox")
  ComponentDb(db, "Community database", "PostgreSQL", "Agile tables")
}

Rel(page, frame, "Renders inside")
Rel(page, dlg, "Opens")
Rel(page, svc, "Calls")
Rel(dlg, svc, "Calls")
Rel(svc, ep, "Calls", "JSON/HTTPS")
Rel(ep, h, "Dispatches request records")
Rel(h, pol, "Authorizes and audits overrides")
Rel(h, mem, "Adds members")
Rel(h, ent, "Loads and mutates")
Rel(mem, ent, "AddMember")
Rel(mem, ntf, "Notify")
Rel(h, ntf, "SendEmailsAsync after save")
Rel(pol, audit, "Record (Admin only)")
Rel(ntf, email, "SendAsync")
Rel(h, db, "Persists", "EF Core")
@enduml
