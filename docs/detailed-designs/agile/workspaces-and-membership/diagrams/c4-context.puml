@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Agile workspaces and membership

Person(lead, "Member with OwnWorkspaces", "Holds OwnWorkspaces; owns Agile workspaces")
Person(member, "Workspace member", "Member with JoinWorkspaces added to a workspace")
Person(staff, "Member with view capabilities", "Holds ReadAllWorkspaces; read-only across workspaces")
Person(admin, "Administrator", "Holds AdministerOrganisation; overrides any workspace, audited")
System(ftc, "Community platform", "Community site with Agile team workspaces")
System_Ext(email, "Email provider", "SMTP/SendGrid")

Rel(lead, ftc, "Creates and owns workspaces in")
Rel(member, ftc, "Works in workspaces of")
Rel(staff, ftc, "Views workspaces in")
Rel(admin, ftc, "Overrides any workspace in")
Rel(ftc, email, "Sends notification email via", "SMTP")
@enduml