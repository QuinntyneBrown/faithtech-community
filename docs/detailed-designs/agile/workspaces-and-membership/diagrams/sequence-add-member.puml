@startuml
title UML sequence behaviour — Add workspace members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace owner" as actor
box "Frontend — FaithTech Community web app (agile library)" #E0F2FE
  participant "WorkspaceSettingsPage" as page
  participant "AddWorkspaceMembersDialog" as dlg
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "WorkspacesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "WorkspaceSettingsHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "WorkspaceMembership" as mem
  participant "Workspace" as ent
  participant "AgileNotifier" as ntf
  participant "IAuditLog" as audit
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  participant "OutboxEmailSender" as email
  database "Community database" as db
end box
actor -> page : Choose "Add members"
page -> dlg : Open dialog
dlg -> svc : listMemberCandidates(workspaceId)
svc -> ep : GET /api/workspaces/{id}/candidates
ep -> h : CandidatesAsync(id)
h -> pol : AuthorizeAsync(id, manage: true)
pol --> h : workspace, caller
h --> ep : Non-suspended lead or volunteer profiles not yet in the workspace (L2-031 AC2)
ep --> dlg : 200 MemberCandidateDto[]
actor -> dlg : Select one or more profiles
dlg -> svc : addMembers(workspaceId, profileIds)
svc -> ep : POST /api/workspaces/{id}/members
ep -> ep : Validate AddWorkspaceMembersCommand
ep -> h : AddMembersAsync(id, command)
h -> pol : AuthorizeAsync(id, manage: true)
pol -> ctx : Load workspace with members
ctx -> db : SELECT
db --> ctx : Rows
pol -> pol : Classify: Owner → Admin → Member → Staff → Outsider
alt outsider or unknown workspace
pol --> h : NotFound (L2-031 AC6)
h --> ep : 404
else member who is not the owner, or Staff
pol --> h : Forbidden (L2-031 AC4, AC5)
h --> ep : 403
else owner or System Admin (CanManage)
pol --> h : workspace, caller
h -> mem : AddMembersAsync(workspace, caller.ProfileId, profileIds)
mem -> ctx : Load profiles
alt every profile holds a lead or volunteer role and is not suspended
mem -> ent : AddMember(profile, now) for each
mem -> ntf : Notify(WorkspaceMemberAdded, /workspaces/{id}) for each
mem --> h : added ids
opt caller is System Admin override (L2-031 AC7)
h -> pol : AuditOverride("workspace.member.added")
pol -> audit : Record
end
h -> ctx : SaveChanges
ctx -> db : INSERT workspace_members, notifications
h -> ntf : SendEmailsAsync()
ntf -> email : SendAsync per member (outbox)
h --> ep : Ok
ep --> svc : 204 No Content
svc --> page : Refresh members
page --> actor : Show members in list
else a profile is not eligible
mem --> h : null
h --> ep : Invalid (ProfileIds)
ep --> dlg : 400 ValidationProblem
end
end
@enduml
