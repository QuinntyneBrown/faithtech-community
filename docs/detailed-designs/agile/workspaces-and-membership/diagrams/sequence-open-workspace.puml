@startuml
title UML sequence behaviour — Open a workspace
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Signed-in user" as actor
box "Frontend — FaithTech Community web app (agile library)" #E0F2FE
  participant "Workspace page\n(backlog, board, settings or Planning Poker)" as page
  participant "WorkspaceFrameComponent" as frame
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "WorkspacesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "WorkspacesHandler" as h
  participant "WorkspaceAccessPolicy" as pol
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Open /workspaces/{id}/...
page -> svc : getWorkspace(id)
svc -> ep : GET /api/workspaces/{id}
ep -> h : GetAsync(id)
h -> pol : LoadAsync(id)
pol -> pol : CallerProfileIdAsync()
pol -> ctx : Workspaces.SingleOrDefault(id) (query filter hides archived)
ctx -> db : SELECT workspace, members
db --> ctx : Rows
pol -> pol : Classify: Owner → Admin → Member → Staff → Outsider
alt workspace missing, archived, or caller is Outsider
pol --> h : null or !CanRead
h --> ep : null (L2-031 AC6)
ep --> svc : 404
svc --> page : Not found
page -> frame : notFound
frame --> actor : Show not-found state
else owner, System Admin, member or Staff
pol --> h : workspace, WorkspaceCaller
h -> ctx : Load member profiles and assignment counts
h --> ep : WorkspaceDto(access, canEdit, canManage, needsNewOwner)
ep --> svc : 200 OK
svc --> page : Workspace
page -> frame : workspace
frame --> actor : Render tabs; "Read-only for Staff" alert when access is Staff (L2-031 AC5)
page --> actor : Owner controls only when canManage (owner or System Admin, L2-031 AC4)
end
@enduml
