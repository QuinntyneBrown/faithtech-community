@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Archive and transfer workspaces

class Workspace {
  +Guid OwnerId
  +bool IsArchived
  +Archive(): void
  +Restore(): void
  +ReassignOwner(newOwner: Profile, capabilities: IReadOnlySet<string>, now: DateTimeOffset): void
}
class WorkItem {
  +Guid? ParentId
  +bool IsArchived
  +Guid? ArchivedById
  +DateTimeOffset? ArchivedAt
  +Archive(items: IEnumerable<WorkItem>, archivedById: Guid, now: DateTimeOffset): void
  +Restore(items: IEnumerable<WorkItem>): void
}
class ArchivedItemDto <<record>> {
  +Guid Id
  +string Kind
  +string Title
  +DateTimeOffset ArchivedAt
  +string ArchivedByName
}
class ReassignOwnerCommand <<record>> {
  +Guid? OwnerId
}
class CapabilityLost <<record>> {
  +Guid ProfileId
  +string Capability
}
class ArchiveHandler {
  +ArchiveWorkspaceAsync(workspaceId: Guid): Task<Result>
  +RestoreWorkspaceAsync(workspaceId: Guid): Task<Result>
  +ArchiveItemAsync(itemId: Guid): Task<Result>
  +RestoreItemAsync(itemId: Guid): Task<Result>
  +ArchivedItemsAsync(workspaceId: Guid): Task<(Result, IReadOnlyList<ArchivedItemDto>?)>
  +OwnerCandidatesAsync(workspaceId: Guid): Task<(Result, IReadOnlyList<MemberCandidateDto>?)>
  +ReassignOwnerAsync(workspaceId: Guid, command: ReassignOwnerCommand): Task<Result>
}
class WorkspacesHandler {
  +ListAsync(): Task<IReadOnlyList<WorkspaceSummaryDto>>
  -NeedsNewOwner(owner: Profile?): bool
}
class ChangeRolesHandler <<Application/Admin>> {
  +RemoveAsync(profileId: Guid, roleId: Guid): Task
}
class CapabilityLostHandler {
  +HandleAsync(lost: CapabilityLost): Task
  +SendEmailsAsync(): Task
}
class WorkspaceAccessPolicy {
  +bool IsAdministrator
  +LoadAsync(workspaceId: Guid, includeArchived: bool): Task<(Workspace?, WorkspaceCaller)>
  +AuthorizeAsync(workspaceId: Guid, manage: bool, includeArchived: bool): Task<(Workspace, WorkspaceCaller, Result?)>
  +Audit(caller, action, targetType, targetId, before, after): void
  +AuditOverride(caller, action, targetType, targetId, before, after): void
}
class AgileNotifier {
  +Notify(actor, recipient, kind, title, linkPath, subject, body): void
  +SendEmailsAsync(): Task
}
interface IAuditLog {
  +Record(actorId, action, targetType, targetId, before, after): void
}
Workspace "1" *-- "*" WorkItem
ArchiveHandler ..> ReassignOwnerCommand : handles
ArchiveHandler --> Workspace : Archive, Restore, ReassignOwner
ArchiveHandler --> WorkItem : Archive, Restore
ArchiveHandler ..> ArchivedItemDto : returns
ArchiveHandler ..> WorkspaceAccessPolicy : AuthorizeAsync, AuditOverride, Audit
WorkspaceAccessPolicy ..> IAuditLog
WorkspacesHandler --> Workspace : lists archived to owner and Admin
ChangeRolesHandler ..> CapabilityLost : reads from Profile.DomainEvents
ChangeRolesHandler ..> CapabilityLostHandler : HandleAsync, SendEmailsAsync
CapabilityLostHandler ..> CapabilityLost : handles OwnWorkspaces
CapabilityLostHandler --> Workspace : live workspaces of the former owner
CapabilityLostHandler ..> AgileNotifier
@enduml
