@startuml
title UML sequence behaviour — Archive and restore a workspace
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace owner\n(or administrator)" as actor
box "Frontend — Community platform web app (agile library)" #E0F2FE
  participant "WorkspaceSettingsPage" as page
  participant "ArchiveWorkspaceDialog" as dlg
  participant "WorkspacesPage" as list
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "WorkspacesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ArchiveHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "Workspace" as ent
  participant "IAuditLog" as audit
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Choose "Archive workspace"
page -> dlg : Open confirmation
actor -> dlg : Confirm
dlg -> svc : archiveWorkspace(id)
svc -> ep : POST /api/workspaces/{id}/archive
ep -> h : ArchiveWorkspaceAsync(id)
h -> pol : AuthorizeAsync(id, manage: true, includeArchived: true)
pol -> ctx : Workspaces.IgnoreQueryFilters().SingleOrDefault(id)
ctx -> db : SELECT
db --> ctx : Row
pol -> pol : Classify: Owner → Admin → Member → Reader → Outsider
alt caller cannot manage (member, Reader or outsider)
pol --> h : Refusal
h --> ep : 404 when the workspace is archived, else 404 or 403
else already archived
pol --> h : workspace, caller
h --> ep : Conflict "This workspace is already archived."
ep --> svc : 409 ProblemDetails
else owner or administrator
pol --> h : workspace, caller
h -> ent : Archive() sets IsArchived only (L2-037 AC1)
opt caller is an AdministerOrganisation override (L2-135 AC5)
h -> pol : AuditOverride("workspace.archived")
pol -> audit : Record
end
h -> ctx : SaveChanges
ctx -> db : UPDATE workspaces SET is_archived = true
db --> ctx : Committed
h --> ep : Ok
ep --> svc : 204 No Content
svc --> dlg : Closed
page --> actor : Toast "<name> archived"; navigate to /workspaces
note over ctx, db : The global query filter (!IsArchived) now hides the workspace and its items:\nmembers and Readers get 404; no needsNewOwner flag or admin notification until restored
end
== Later ==
actor -> list : Open Workspaces
list -> svc : listWorkspaces()
svc -> ep : GET /api/workspaces
ep --> list : WorkspaceSummaryDto[] (archived rows only for the owner and administrators)
list --> actor : Archived section with "Restore"
actor -> list : Choose "Restore"
list -> svc : restoreWorkspace(id)
svc -> ep : POST /api/workspaces/{id}/restore
ep -> h : RestoreWorkspaceAsync(id)
h -> pol : AuthorizeAsync(id, manage: true, includeArchived: true)
pol --> h : workspace, caller (owner or administrator)
h -> ent : Restore() (L2-037 AC1)
opt caller is an AdministerOrganisation override (L2-135 AC5)
h -> pol : AuditOverride("workspace.restored")
pol -> audit : Record
end
h -> ctx : SaveChanges
ctx -> db : UPDATE workspaces SET is_archived = false
h --> ep : Ok
ep --> svc : 204 No Content
list -> svc : listWorkspaces()
svc --> list : Workspace back in the live list
@enduml
