@startuml
title UML sequence behaviour — Vote, reveal and set points
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Participant" as actor
box "Frontend — Community platform web app (agile library)" #E0F2FE
  participant "PlanningPokerPage" as page
  participant "AgileService (AGILE_SERVICE)" as svc
  participant "SignalRAgileLiveService (AGILE_LIVE_SERVICE)" as live
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "WorkItemsEndpoints" as ep
  participant "SignalRAgileNotifier" as bc
  participant "AgileHub" as hub
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "PlanningPokerHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "PokerSession" as ent
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> page : Pick card (1, 2, 3, 5, 8, 13, 21, ?)
page -> svc : vote(sessionId, value)
svc -> ep : PUT /api/poker-sessions/{id}/vote
ep -> h : VoteAsync(sessionId, command)
h -> pol : LoadAsync(workspaceId)
pol --> h : Caller (outsider 404, Reader write 403) (L2-038 AC7)
alt caller is not the facilitator or an invitee
h --> ep : 403 Forbidden (L2-038 AC7)
else votes already revealed
h --> ep : 409 "Votes are already revealed. Wait for a re-vote." (L2-038 AC10)
ep --> svc : ProblemDetails
svc --> page : Restore saved vote, show why under the deck
else voting open
h -> ent : CastVote(profileId, value), or WithdrawVote when value is null
h -> pol : AuditOverride(caller, "poker.voted") for an administrator override (L2-135 AC5)
h -> ctx : SaveChangesAsync
ctx -> db : INSERT or UPDATE poker_vote
h -> bc : PokerChangedAsync(sessionId) via IPokerBroadcaster
bc -> hub : Group poker:{sessionId}
hub -> live : PokerChanged(sessionId) within 2 s (L2-038 AC2)
h --> ep : Ok
ep --> svc : 204 No Content
svc --> page : Re-read session
live --> page : Re-read session
page -> svc : getCurrentPokerSession(workspaceId)
svc -> ep : GET /api/workspaces/{id}/poker-sessions/current
ep -> h : CurrentAsync(workspaceId)
h --> ep : PokerSessionDto: HasVoted per participant, values withheld except the caller's own (L2-038 AC2)
ep --> svc : 200 OK
svc --> page : Mark voters, keep values hidden
end
== Facilitator only ==
alt caller is the facilitator
actor -> page : Reveal votes
page -> svc : revealVotes(sessionId)
svc -> ep : POST /api/poker-sessions/{id}/reveal
ep -> h : RevealAsync(sessionId)
h -> ent : Reveal(by) (L2-038 AC3)
h -> ctx : SaveChangesAsync
h -> bc : PokerChangedAsync(sessionId)
bc -> hub : Group poker:{sessionId}
hub -> live : PokerChanged(sessionId)
live --> page : Re-read: every vote value is now returned (L2-038 AC3)
opt re-vote
page -> svc : revote(sessionId)
svc -> ep : POST /api/poker-sessions/{id}/revote
ep -> h : RevoteAsync(sessionId)
h -> ent : Revote(by): clear votes, Round + 1 (L2-038 AC4)
h -> ctx : SaveChangesAsync
h -> bc : PokerChangedAsync(sessionId)
end
page -> svc : setFinalPoints(sessionId, points)
svc -> ep : POST /api/poker-sessions/{id}/points
ep -> h : SetPointsAsync(sessionId, command)
h -> ent : SetFinalPoints(by, points, story): story points, next story (L2-038 AC5)
h -> ctx : SaveChangesAsync
ctx -> db : UPDATE work_item story_points, poker_session
h -> bc : PokerChangedAsync(sessionId)
bc -> hub : Group poker:{sessionId}
hub -> live : PokerChanged(sessionId)
live --> page : Re-read: last story and points, next story
else caller is not the facilitator
page -> svc : revealVotes, revote, setFinalPoints or endPokerSession
svc -> ep : POST /api/poker-sessions/{id}/reveal | /revote | /points | /end
ep -> h : RevealAsync | RevoteAsync | SetPointsAsync | EndAsync
h --> ep : 403 Forbidden (L2-038 AC6)
ep --> svc : ProblemDetails
svc --> page : Error toast
end
@enduml
