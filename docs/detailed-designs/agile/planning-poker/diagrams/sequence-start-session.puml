@startuml
title UML sequence behaviour — Start a poker session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace member" as actor
box "Frontend — FaithTech Community web app (agile library)" #E0F2FE
  participant "PlanningPokerPage" as page
  participant "StartPokerDialog" as dlg
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "PokerEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "StartPokerSessionHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "PokerSession" as ent
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "NotificationService" as ntf
  participant "CommunityDbContext" as ctx
  database "Community database" as db
end box
actor -> dlg : Choose story and invite members
dlg -> svc : startPokerSession(storyId, inviteeIds)
svc -> ep : POST /items/{id}/poker-sessions
ep -> h : Send StartPokerSessionCommand
h -> pol : EnsureMember(workspaceId)
pol --> h : Allowed (Staff 403, outsider 404)
h -> ent : Create with FacilitatorId = caller (L2-038 AC1)
h -> ctx : SaveChanges
ctx -> db : INSERT poker_session
h -> ntf : Notify invitees in-app and by email (L2-038 AC1)
h --> ep : SessionDto
ep --> svc : 201 Created
svc --> page : Navigate to session
page --> actor : Show session as facilitator
@enduml