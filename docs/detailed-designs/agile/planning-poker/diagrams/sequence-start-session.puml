@startuml
title UML sequence behaviour — Start a poker session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Workspace member" as actor
box "Frontend — Community platform web app (agile library)" #E0F2FE
  participant "PlanningPokerPage" as page
  participant "StartPokerDialog" as dlg
  participant "AgileService (AGILE_SERVICE)" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "WorkItemsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "PlanningPokerHandler" as h
  participant "WorkspaceAccessPolicy" as pol
  participant "PokerSession" as ent
  participant "AgileNotifier" as ntf
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "CommunityDbContext" as ctx
  database "Community database" as db
  participant "IEmailQueue" as mail
end box
actor -> page : Start session
page -> dlg : Open
actor -> dlg : Choose one or more stories and invite members
dlg -> svc : startPokerSession(workspaceId, { storyIds, invitedIds })
svc -> ep : POST /api/workspaces/{id}/poker-sessions
ep -> ep : StartPokerValidator (at least one story)
ep -> h : StartAsync(workspaceId, command)
h -> pol : AuthorizeAsync(workspaceId, manage: false)
pol --> h : Caller (outsider 404, Reader 403; AdministerOrganisation passes as override)
h -> h : Invitees are members; stories belong to the workspace (400 otherwise)
h -> ctx : Open session in this workspace?
alt a session is already running
h --> ep : 409 "A Planning Poker session is already running in this workspace."
ep --> svc : ProblemDetails
svc --> dlg : Show the 409 detail
else no open session
h -> ent : new PokerSession(workspace, stories, caller, invited) (L2-038 AC1)
h -> pol : AuditOverride(caller, "poker.started") when the caller is an administrator override (L2-135 AC5)
h -> ntf : Notify(caller, invitee, PlanningPokerInvite, ...) per invitee (L2-038 AC1)
h -> ntf : QueueEmailsAsync
ntf -> mail : Enqueue invite email per invitee
h -> ctx : SaveChangesAsync
ctx -> db : INSERT poker_session, notifications, outbox in one transaction
h --> ep : PokerSessionDto (caller is facilitator)
ep --> svc : 201 Created
svc --> dlg : Session
dlg --> page : Close with session
page -> page : Show session and watch it live
page --> actor : Facilitator controls
end
@enduml
