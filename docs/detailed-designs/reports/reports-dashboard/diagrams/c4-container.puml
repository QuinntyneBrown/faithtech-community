@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Reports dashboard
Person(staff, "Member with ViewReports", "Reads organisation-wide numbers by chapter")
System_Boundary(community, "Community platform") {
  Container(web, "Web app", "Angular", "Shell, reports feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  Container(cli, "Community Cli", ".NET console", "Applies the JoinedAtUtc migration; seeds the load-test volume")
  ContainerDb(db, "Community database", "PostgreSQL", "Profiles, accounts, events and RSVPs, partners, announcements")
}
Rel(staff, web, "Uses", "HTTPS")
Rel(web, api, "GET /api/reports and /api/reports/export.csv", "JSON or CSV over HTTPS, OAuth2 bearer token")
Rel(api, db, "Reads aggregates only", "EF Core")
Rel(cli, db, "Migrates and seeds", "EF Core")
@enduml
