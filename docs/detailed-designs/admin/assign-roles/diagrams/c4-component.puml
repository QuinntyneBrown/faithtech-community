@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Assign roles
Container_Boundary(web, "Web app") {
  Component(page, "ProfilePage", "Angular page (profiles library)", "Opens the role dialog with grantableRoleIds and a submit callback")
  Component(dlg, "RoleDialogComponent", "Angular CDK Dialog (components library)", "Add or remove mode with an optional chapter picker; invalid, busy and failed states")
  Component(svc, "HttpRolesService", "Angular service (api library)", "Implements RolesService over HTTP")
}
Container_Boundary(api, "Community API") {
  Component(ep, "RolesEndpoints", "ASP.NET Core minimal API", "POST and DELETE /api/profiles/{id}/roles")
  Component(h, "ChangeRolesHandler", "Application handler", "AssignAsync and RemoveAsync")
  Component(pol, "RoleGrantPolicy", "Application permission check", "Applies the grant rules and chapter scope")
  Component(guard, "LastAdministratorGuard", "Application service", "Takes the OrganisationAdminRoster lease and counts administrators")
  Component(prof, "Profile", "Domain entity", "Holds the profile's ProfileRole set; raises CapabilityLost")
  Component(notify, "RoleChangeNotifier", "Application service", "Adds a RoleChanged notification, then emails the owner")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; adds audit entries to the unit of work")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database, filtered by ICurrentOrganisation")
}
System_Ext(email, "Email provider", "SMTP/SendGrid")
Rel(page, dlg, "Opens with DialogService")
Rel(dlg, page, "submit(roleId, chapterId)")
Rel(page, svc, "addRole / removeRole")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "AssignAsync / RemoveAsync")
Rel(h, pol, "Checks L2-138 and L2-143 rules")
Rel(h, guard, "Guards the last administrator (L2-139)")
Rel(h, prof, "Adds or removes ProfileRole")
Rel(h, audit, "Records role.granted or role.removed")
Rel(h, notify, "Notifies owner when caller is not an administrator")
Rel(h, db, "Persists", "EF Core")
Rel(notify, email, "Queues email in the unit of work via", "IEmailQueue")
@enduml
