@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Assign roles
Container_Boundary(web, "Web app") {
  Component(dlg, "AddRoleDialog / RemoveRoleDialog", "Angular CDK Dialog", "Confirms a role change")
  Component(svc, "HttpRolesService", "Angular service", "Implements RolesService over HTTP")
}
Container_Boundary(api, "Community API") {
  Component(ep, "RolesEndpoints", "ASP.NET Core minimal API", "POST and DELETE /api/profiles/{id}/roles")
  Component(h, "AssignRoleHandler / RemoveRoleHandler", "Application handler", "Applies a role change")
  Component(pol, "RoleAssignmentPolicy", "Application permission check", "Decides who may change which role")
  Component(prof, "Profile", "Domain entity", "Holds the profile's ProfileRole set")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; appends immutable audit entries")
  Component(notify, "NotificationDispatcher", "Infrastructure service", "Writes in-app notifications and sends email")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(dlg, svc, "Calls")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "Sends command")
Rel(h, pol, "Checks L2-009 limits")
Rel(h, prof, "Adds or removes ProfileRole")
Rel(h, audit, "Writes audit entry")
Rel(h, notify, "Notifies profile owner")
Rel(h, db, "Persists", "EF Core")
@enduml
