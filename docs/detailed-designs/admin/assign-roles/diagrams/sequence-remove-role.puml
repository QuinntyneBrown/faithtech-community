@startuml
title UML sequence behaviour — Remove a role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Holder of AssignRoles or AdministerOrganisation" as actor
box "Frontend — Community web app (profiles and components libraries)" #E0F2FE
  participant "ProfilePage" as page
  participant "RoleDialogComponent" as dlg
end box
box "Frontend — Community web app (api library)" #E0F2FE
  participant "HttpRolesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "RolesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ChangeRolesHandler" as h
  participant "RoleGrantPolicy" as pol
  participant "LastAdministratorGuard" as guard
  participant "Profile" as prof
  participant "RoleChangeNotifier" as notify
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose "Remove a role"
page -> dlg : Open in remove mode with held, grantable roles
actor -> dlg : Confirm removal
dlg -> page : submit(roleId)
page -> svc : removeRole(profileId, roleId)
svc -> ep : DELETE /api/profiles/{id}/roles/{roleId} (HANDLES_FORBIDDEN)
ep -> h : RemoveAsync(id, roleId)
h -> pol : CanChangeRoles and CanChange(definition, chapterId) per L2-138 and L2-143
alt not permitted
  h --> ep : Forbidden
  ep --> svc : 403 ProblemDetails
  svc --> page : Error
  page --> dlg : Refusal message
  dlg --> actor : Show the refusal
else definition carries AdministerOrganisation and it is the last active holder
  h -> guard : TakeLeaseAsync() on OrganisationAdminRoster (L2-139 AC2)
  h -> guard : WouldLeaveNoneAsync(profile)
  guard -> db : Count active, unsuspended administrators
  h --> ep : Conflict (L2-139 AC1)
  ep --> svc : 409 "There must always be at least one administrator."
  svc --> page : Error
  page --> dlg : Refusal message
  dlg --> actor : Show the message; dialog stays open
else permitted
  h -> db : Load Profile with roles and held definitions
  h -> prof : RemoveRole(roleId, lostCapabilities) raises CapabilityLost (L2-139 AC3)
  h -> audit : Record(actor, "role.removed", "Profile", id, before roles, after roles) (L2-041)
  opt pol.NotifiesOwner and caller is not the owner
    h -> notify : Notify(owner, title)
    h -> notify : QueueEmailAsync(owner, title) queues the email
  end
  h -> db : Save changes in one unit of work; dispatch CapabilityLost
  h -> guard : Release()
  h --> ep : Updated role set
  ep --> svc : 200 OK
  svc --> page : Roles
  page --> dlg : null
  dlg --> actor : Close dialog, badges update without reload
end
@enduml
