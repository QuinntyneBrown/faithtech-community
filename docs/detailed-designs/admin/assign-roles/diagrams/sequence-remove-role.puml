@startuml
title UML sequence behaviour — Remove a role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "City Lead or System Admin" as actor
box "Frontend — FaithTech Community web app (admin library)" #E0F2FE
  participant "RemoveRoleDialog" as dlg
  participant "HttpRolesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "RolesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "RemoveRoleHandler" as h
  participant "RoleAssignmentPolicy" as pol
  participant "Profile" as prof
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  participant "NotificationDispatcher" as notify
  database "Community database" as db
end box
actor -> dlg : Confirm removal
dlg -> svc : removeRole(profileId, role)
svc -> ep : DELETE /api/profiles/{id}/roles/{role}
ep -> h : Send RemoveRoleCommand
h -> pol : CanChange(caller, role) per L2-009
alt not permitted
  h --> ep : Forbidden
  ep --> svc : 403 ProblemDetails
else role is SystemAdmin
  h -> pol : IsLastSystemAdmin(profileId)
  alt last System Admin
    h --> ep : Conflict (L2-009 AC6)
    ep --> svc : 409 ProblemDetails
    svc --> dlg : Error
    dlg --> actor : Show "last System Admin cannot be removed"
  end
end
h -> prof : RemoveRole(role)
h -> audit : Write audit entry (L2-041)
h -> db : Save changes
opt caller is City Lead
  h -> notify : Notify profile owner
end
h --> ep : Updated role set
ep --> svc : 200 OK
svc --> dlg : Roles
dlg --> actor : Badges update without reload
@enduml
