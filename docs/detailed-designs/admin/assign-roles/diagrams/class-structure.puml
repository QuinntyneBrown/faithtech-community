@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Assign roles
class Capability <<static>> {
  +{static} AssignRoles: string
  +{static} AdministerOrganisation: string
  +{static} All: IReadOnlyList<string>
}
class RoleDefinition {
  +Guid Id
  +Guid OrganisationId
  +string Name
  +IReadOnlySet<string> Capabilities
  +bool ChapterScopable
  +bool IsArchived
}
class RoleGrantRule {
  +Guid GrantorRoleId
  +Guid GrantableRoleId
}
class Profile {
  +Guid Id
  +Guid OrganisationId
  +string Name
  +IReadOnlyCollection<ProfileRole> Roles
  +IReadOnlyList<object> DomainEvents
  +AddRole(roleId: Guid, chapterId: Guid?, grantedBy: Guid, nowUtc: DateTime): void
  +RemoveRole(roleId: Guid, lostCapabilities: IEnumerable<string>): void
  +HoldsRole(roleId: Guid): bool
  +ClearDomainEvents(): void
}
class CapabilityLost <<record>> {
  +Guid ProfileId
  +string Capability
}
class ProfileRole {
  +Guid ProfileId
  +Guid RoleId
  +Guid? ChapterId
  +DateTime GrantedAtUtc
  +Guid GrantedBy
}
class OrganisationAdminRoster {
  +Guid OrganisationId
  +uint Version
  +Guid? LeaseHolder
  +DateTime? LeaseExpiresAt
  +TryTake(holder: Guid, now: DateTime): bool
  +Release(): void
}
class AssignRoleCommand <<record>> {
  +Guid? RoleId
  +Guid? ChapterId
}
class RoleGrantPolicy {
  +bool CanChangeRoles
  +bool NotifiesOwner
  +IReadOnlyList<Guid> GrantableRoleIds
  +CanChange(definition: RoleDefinition, chapterId: Guid?): bool
}
class LastAdministratorGuard {
  +TakeLeaseAsync(): Task<Result>
  +WouldLeaveNoneAsync(excludingProfile: Guid?, excludingDefinition: Guid?): Task<bool>
  +Release(): void
}
class CapabilityLossDetector {
  +LostAsync(profileIds: IEnumerable<Guid>, removedCapabilities: IEnumerable<string>): Task<IReadOnlyList<CapabilityLost>>
}
class ChangeRolesHandler {
  +LastAdministratorMessage: string
  +AssignAsync(profileId: Guid, roleId: Guid?, chapterId: Guid?): Task<(Result, IReadOnlyList<HeldRole>?)>
  +RemoveAsync(profileId: Guid, roleId: Guid): Task<(Result, IReadOnlyList<HeldRole>?)>
}
class RoleChangeNotifier {
  +Notify(ownerProfileId: Guid, title: string): void
  +EmailAsync(ownerProfileId: Guid, title: string): Task
}
class ProfileAccess {
  +CallerProfileIdAsync(): Task<Guid?>
}
interface ICurrentOrganisation {
  +Guid Id
  +string Name
}
interface ICurrentUser {
  +Guid? UserId
  +IReadOnlyCollection<HeldRole> Roles
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
interface IEmailQueue {
  +Enqueue(message: EmailMessage): void
}
Profile "1" *-- "*" ProfileRole
ProfileRole --> RoleDefinition : references
RoleDefinition --> Capability : carries
RoleGrantRule --> RoleDefinition : grantor / grantable
Profile ..> CapabilityLost : raises
ChangeRolesHandler ..> AssignRoleCommand : role from body
ChangeRolesHandler --> RoleGrantPolicy
ChangeRolesHandler --> LastAdministratorGuard
ChangeRolesHandler ..> CapabilityLossDetector
ChangeRolesHandler --> Profile : mutates
ChangeRolesHandler ..> ProfileAccess : actor id
ChangeRolesHandler ..> IAuditLog
ChangeRolesHandler ..> RoleChangeNotifier
RoleGrantPolicy ..> ICurrentUser
RoleGrantPolicy ..> RoleGrantRule : reads
RoleGrantPolicy ..> ICurrentOrganisation : scoped by
LastAdministratorGuard --> OrganisationAdminRoster : leases
RoleChangeNotifier ..> IEmailQueue
@enduml
