@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Assign roles
Person(grantor, "Member with AssignRoles", "Grants and removes the roles their grant rules allow")
Person(admin, "Administrator", "Holds AdministerOrganisation; grants any role")
Person(member, "Member", "Signed-in profile holder")
System_Boundary(community, "Community platform") {
  Container(web, "Web app", "Angular", "Shell, profiles feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Profiles, role definitions, grant rules, contacts, partners and audit log")
}
System_Ext(email, "Email provider", "SMTP/SendGrid")
Rel(grantor, web, "Uses", "HTTPS")
Rel(admin, web, "Uses", "HTTPS")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS, OAuth2 bearer token")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, email, "Sends email via", "SMTP/SendGrid")
@enduml
