@startuml
title UML sequence behaviour — Add a role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "City Lead or System Admin" as actor
box "Frontend — FaithTech Community web app (profiles and components libraries)" #E0F2FE
  participant "ProfilePage" as page
  participant "RoleDialogComponent" as dlg
end box
box "Frontend — FaithTech Community web app (api library)" #E0F2FE
  participant "HttpRolesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "RolesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ChangeRolesHandler" as h
  participant "RoleAssignmentPolicy" as pol
  participant "Profile" as prof
  participant "RoleChangeNotifier" as notify
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose "Add a role"
page -> dlg : Open in add mode with assignableRoles options and submit
actor -> dlg : Choose role and confirm
dlg -> page : submit(role)
page -> svc : addRole(profileId, role)
svc -> ep : POST /api/profiles/{id}/roles { role } (HANDLES_FORBIDDEN)
ep -> h : AssignAsync(id, role)
h -> pol : CanChangeRoles and CanChange(role) per L2-009
alt caller not permitted
  pol --> h : false
  h --> ep : Forbidden
  ep --> svc : 403 ProblemDetails
  svc --> page : Error
  page --> dlg : Refusal message
  dlg --> actor : Show the refusal; dialog stays open
else permitted
  pol --> h : true
  h -> db : Load Profile with roles
  db --> h : Profile
  h -> prof : AddRole(role, actor, nowUtc) (L2-008 any combination)
  h -> audit : Record(actor, "role.granted", "Profile", id, before roles, after roles) (L2-041)
  opt pol.NotifiesOwner and caller is not the owner
    h -> notify : Notify(owner, title) adds RoleChanged notification (L2-009 AC1)
  end
  h -> db : Save changes in one unit of work
  opt owner notified
    h -> notify : EmailAsync(owner, title)
  end
  h --> ep : Updated role set
  ep --> svc : 200 OK
  svc --> page : Roles
  page -> page : Replace profile roles (L2-009 AC5)
  page --> dlg : null
  dlg --> actor : Close dialog, badges update without reload
end
@enduml
