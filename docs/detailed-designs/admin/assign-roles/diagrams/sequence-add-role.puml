@startuml
title UML sequence behaviour — Add a role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Holder of AssignRoles or AdministerOrganisation" as actor
box "Frontend — Community web app (profiles and components libraries)" #E0F2FE
  participant "ProfilePage" as page
  participant "RoleDialogComponent" as dlg
end box
box "Frontend — Community web app (api library)" #E0F2FE
  participant "HttpRolesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "RolesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ChangeRolesHandler" as h
  participant "RoleGrantPolicy" as pol
  participant "Profile" as prof
  participant "RoleChangeNotifier" as notify
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose "Add a role"
page -> dlg : Open in add mode with grantableRoleIds options, chapters and submit
actor -> dlg : Choose role, optional chapter, and confirm
dlg -> page : submit(roleId, chapterId)
page -> svc : addRole(profileId, roleId, chapterId)
svc -> ep : POST /api/profiles/{id}/roles { roleId, chapterId } (HANDLES_FORBIDDEN)
ep -> h : AssignAsync(id, roleId, chapterId)
h -> db : Load definition and grant rules (scoped by ICurrentOrganisation)
db --> h : RoleDefinition, rules
h -> pol : CanChangeRoles and CanChange(definition, chapterId) per L2-138 and L2-143
alt caller not permitted
  pol --> h : false
  h --> ep : Forbidden
  ep --> svc : 403 ProblemDetails
  svc --> page : Error
  page --> dlg : Refusal message
  dlg --> actor : Show the refusal; dialog stays open
else permitted
  pol --> h : true
  h -> db : Load Profile with roles
  db --> h : Profile
  h -> prof : AddRole(roleId, chapterId, actor, nowUtc) (L2-008 any combination)
  h -> audit : Record(actor, "role.granted", "Profile", id, before roles, after roles) (L2-041, L2-138 AC5)
  opt pol.NotifiesOwner and caller is not the owner
    h -> notify : Notify(owner, title) adds RoleChanged notification (L2-138 AC1)
    h -> notify : QueueEmailAsync(owner, title) queues the email
  end
  h -> db : Save changes in one unit of work
  h --> ep : Updated role set
  ep --> svc : 200 OK
  svc --> page : Roles
  page -> page : Replace profile roles (L2-009 AC5)
  page --> dlg : null
  dlg --> actor : Close dialog, badges update without reload
end
@enduml
