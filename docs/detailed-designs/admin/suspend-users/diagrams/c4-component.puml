@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Suspend users
Container_Boundary(web, "Web app") {
  Component(page, "AdminUsersPage", "Angular page (admin library)", "Lists users with Suspend and Reinstate actions")
  Component(dlg, "SuspendUserDialog", "Angular CDK Dialog (admin library)", "Collects the reason and confirms")
  Component(svc, "HttpAdminUsersService", "Angular service (api library)", "Implements AdminUsersService; sets HANDLES_FORBIDDEN")
}
Container_Boundary(api, "Community API") {
  Component(ep, "AdminUsersEndpoints", "ASP.NET Core minimal API", "POST and DELETE /api/admin/users/{id}/suspension")
  Component(val, "SuspendUserValidator", "FluentValidation validator", "Reason required, up to 500 characters")
  Component(h, "SuspensionHandler", "Application handler", "SuspendAsync and ReinstateAsync")
  Component(acct, "Profile", "Domain entity", "Holds suspension state")
  Component(rev, "TokenRevocation", "Infrastructure service", "Implements ITokenRevocation over OpenIddict")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; adds audit entries to the unit of work")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, dlg, "Opens")
Rel(page, svc, "reinstate(id)")
Rel(dlg, svc, "suspend(id, reason)")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, val, "Validates SuspendUserCommand")
Rel(ep, h, "SuspendAsync / ReinstateAsync")
Rel(h, acct, "Suspends or reinstates")
Rel(h, audit, "Records user.suspended or user.reinstated")
Rel(h, db, "Persists", "EF Core")
Rel(h, rev, "Revokes sessions after save")
@enduml
