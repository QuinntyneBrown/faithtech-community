@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Suspend users
Container_Boundary(web, "Web app") {
  Component(page, "AdminUsersPage", "Angular page", "Lists users with suspend actions")
  Component(dlg, "SuspendUserDialog", "Angular CDK Dialog", "Collects the reason and confirms")
  Component(svc, "HttpAdminUsersService", "Angular service", "Implements AdminUsersService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "AdminUsersEndpoints", "ASP.NET Core minimal API", "/api/admin/users/{id}/suspension")
  Component(h, "SuspendUserHandler / ReinstateUserHandler", "Application handler", "Changes suspension state")
  Component(acct, "Profile", "Domain entity", "Holds suspension state")
  Component(rev, "TokenRevocation", "Infrastructure service", "Revokes OpenIddict tokens")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; appends immutable audit entries")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, dlg, "Opens")
Rel(dlg, svc, "Calls")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "Sends command")
Rel(h, acct, "Suspends or reinstates")
Rel(h, rev, "Revokes sessions")
Rel(h, audit, "Writes audit entry")
Rel(h, db, "Persists", "EF Core")
@enduml
