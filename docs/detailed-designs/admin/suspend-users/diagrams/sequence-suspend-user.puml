@startuml
title UML sequence behaviour — Suspend a user
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "System Admin" as actor
box "Frontend — FaithTech Community web app (admin library)" #E0F2FE
  participant "AdminUsersPage" as page
  participant "SuspendUserDialog" as dlg
  participant "HttpAdminUsersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AdminUsersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "SuspendUserHandler" as h
  participant "UserAccount" as acct
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "TokenRevocation" as rev
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose Suspend on a user
page -> dlg : Open
actor -> dlg : Enter reason and confirm
dlg -> svc : suspend(userId, reason)
svc -> ep : POST /api/admin/users/{id}/suspension
ep -> h : Send SuspendUserCommand
alt caller is not System Admin
  h --> ep : Forbidden (L2-039 AC3)
  ep --> svc : 403 ProblemDetails
else System Admin
  h -> db : Load UserAccount
  h -> acct : Suspend(reason)
  h -> rev : RevokeAll(userId) (L2-039 AC1)
  h -> audit : Write audit entry (L2-041)
  h -> db : Save changes
  h --> ep : Success
  ep --> svc : 204 No Content
  svc --> dlg : Done
  dlg --> page : Close
  page --> actor : Row shows Suspended status
end
@enduml
