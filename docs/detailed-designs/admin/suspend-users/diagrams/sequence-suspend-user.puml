@startuml
title UML sequence behaviour — Suspend a user
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Administrator" as actor
box "Frontend — Community web app (admin library)" #E0F2FE
  participant "AdminUsersPage" as page
  participant "SuspendUserDialog" as dlg
end box
box "Frontend — Community web app (api library)" #E0F2FE
  participant "HttpAdminUsersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AdminUsersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "SuspensionHandler" as h
  participant "LastAdministratorGuard" as guard
  participant "Profile" as acct
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  participant "TokenRevocation" as rev
  database "Community database" as db
end box
actor -> page : Choose Suspend on a member
page -> dlg : Open with profile id and name
actor -> dlg : Enter reason and confirm
dlg -> dlg : Reason required, up to 500 characters
dlg -> svc : suspend(profileId, reason)
svc -> ep : POST /api/admin/users/{id}/suspension { reason } (HANDLES_FORBIDDEN)
ep -> ep : SuspendUserValidator (400 on a missing or long reason)
ep -> h : SuspendAsync(id, SuspendUserCommand)
alt caller lacks AdministerOrganisation
  h --> ep : Forbidden (L2-039 AC3)
  ep --> svc : 403 ProblemDetails
  svc --> dlg : Error
  dlg --> actor : Show the refusal
else own membership or already suspended
  h --> ep : Conflict
  ep --> svc : 409 ProblemDetails
  svc --> dlg : Error
  dlg --> actor : Show the server's detail
else profile is the last active administrator
  h -> guard : TakeLeaseAsync(); WouldLeaveNoneAsync(profile) (L2-139 AC1, AC2)
  guard -> db : Count active, unsuspended administrators in ICurrentOrganisation
  h --> ep : Conflict
  ep --> svc : 409 "There must always be at least one administrator."
  svc --> dlg : Error
  dlg --> actor : Show the server's detail
else caller holds AdministerOrganisation
  h -> db : Load Profile (scoped by ICurrentOrganisation)
  h -> acct : Suspend(reason, nowUtc)
  h -> audit : Record(actor, "member.suspended", "Profile", id, before, after with reason) (L2-041)
  h -> db : Save changes in one unit of work
  h -> rev : RevokeAllAsync(userId, organisationId) (L2-039 AC1, other memberships untouched)
  h --> ep : Ok
  ep --> svc : 204 No Content
  svc --> dlg : Done
  dlg --> page : Close with true
  page --> actor : Row shows Suspended status
end
@enduml
