@startuml
title UML sequence behaviour — Reinstate a user
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Administrator" as actor
box "Frontend — Community web app (admin library)" #E0F2FE
  participant "AdminUsersPage" as page
end box
box "Frontend — Community web app (api library)" #E0F2FE
  participant "HttpAdminUsersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AdminUsersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "SuspensionHandler" as h
  participant "Profile" as acct
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose Reinstate on a suspended member
page -> svc : reinstate(profileId)
svc -> ep : DELETE /api/admin/users/{id}/suspension (HANDLES_FORBIDDEN)
ep -> h : ReinstateAsync(id)
alt caller lacks AdministerOrganisation
  h --> ep : Forbidden (L2-039 AC3)
  ep --> svc : 403 ProblemDetails
else profile is not suspended
  h -> db : Load Profile
  h --> ep : Conflict
  ep --> svc : 409 "This account isn’t suspended."
else caller holds AdministerOrganisation and profile suspended
  h -> db : Load Profile (scoped by ICurrentOrganisation)
  h -> acct : Reinstate() (L2-039 AC2)
  h -> audit : Record(actor, "member.reinstated", "Profile", id, before, after) (L2-041)
  h -> db : Save changes in one unit of work
  h --> ep : Ok
  ep --> svc : 204 No Content
  svc --> page : Done
  page --> actor : Row shows Active status
end
@enduml
