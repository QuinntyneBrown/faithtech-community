@startuml
title UML sequence behaviour — Reinstate a user
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "System Admin" as actor
box "Frontend — FaithTech Community web app (admin library)" #E0F2FE
  participant "AdminUsersPage" as page
  participant "HttpAdminUsersService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AdminUsersEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ReinstateUserHandler" as h
  participant "Profile" as acct
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Choose Reinstate
page -> svc : reinstate(userId)
svc -> ep : DELETE /api/admin/users/{id}/suspension
ep -> h : Send ReinstateUserCommand
h -> h : Require System Admin (L2-039 AC3)
h -> db : Load Profile
h -> acct : Reinstate() (L2-039 AC2)
h -> audit : Write audit entry (L2-041)
h -> db : Save changes
h --> ep : Success
ep --> svc : 204 No Content
svc --> page : Done
page --> actor : Row shows Active status
@enduml
