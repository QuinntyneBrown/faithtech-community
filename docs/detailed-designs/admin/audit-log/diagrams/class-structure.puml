@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Audit log
class AuditEntry {
  +Guid Id
  +Guid OrganisationId
  +Guid ActorId
  +string Action
  +string TargetType
  +string TargetId
  +string? BeforeJson
  +string? AfterJson
  +DateTime OccurredAtUtc
  +string IpAddress
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
class AuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
class GetAuditEntriesQuery <<record>> {
  +string? Category
  +Guid? Actor
  +DateTime? From
  +DateTime? To
  +int Page
}
class AuditEntryDto <<record>> {
  +Guid Id
  +DateTime OccurredAtUtc
  +Guid ActorId
  +string ActorName
  +string Action
  +string TargetType
  +string TargetId
  +string Summary
  +string? Before
  +string? After
  +string IpAddress
}
class GetAuditEntriesHandler {
  +PageSize: int = 50
  +MaxExportRows: int = 10000
  +DefaultRange: TimeSpan = 90 days
  +ReadableCategories(user: ICurrentUser): IReadOnlySet<string>
  +HandleAsync(query: GetAuditEntriesQuery): Task<PagedResult<AuditEntryDto>?>
  +HandleAllAsync(query: GetAuditEntriesQuery): Task<IReadOnlyList<AuditEntryDto>?>
}
interface ICurrentOrganisation {
  +Guid Id
  +string Name
}
interface ICurrentUser {
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface IApplicationDbContext {
  +DbSet<AuditEntry> AuditEntries
}
class CommunityDbContext {
  +DbSet<AuditEntry> AuditEntries
}
AuditLog ..|> IAuditLog
AuditLog --> CommunityDbContext
AuditLog ..> ICurrentOrganisation : stamps OrganisationId
CommunityDbContext ..|> IApplicationDbContext
CommunityDbContext ..> ICurrentOrganisation : global query filter
GetAuditEntriesHandler ..> GetAuditEntriesQuery : handles
GetAuditEntriesHandler ..> AuditEntryDto : returns
GetAuditEntriesHandler --> IApplicationDbContext
GetAuditEntriesHandler ..> ICurrentUser : AdministerOrganisation, ManageRoles or ManageOrganisationSettings (L2-152 AC3)
CommunityDbContext "1" o-- "*" AuditEntry
@enduml
