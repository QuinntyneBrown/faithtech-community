@startuml
title UML sequence behaviour — Write an audit entry
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "System Admin or City Lead" as actor
box "Frontend — FaithTech Community web app" #E0F2FE
  participant "Page or dialog" as page
  participant "Feature service" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "Feature endpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ChangeRolesHandler, SuspensionHandler\nor profile handler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Perform admin action or role change
page -> svc : Request
svc -> ep : HTTPS request
ep -> h : Call handler
h -> db : Load target and capture before values
h -> h : Apply change and capture after values
h -> audit : Record(actorId, action, targetType, targetId, before, after) (L2-041 AC1)
audit -> audit : Serialize before and after to JSON; stamp UTC time and request IP address
audit -> db : Add AuditEntry to the unit of work
h -> db : SaveChanges: change and entry in one unit of work
db --> h : Commit
h --> ep : Result
ep --> svc : Response
svc --> page : Result
page --> actor : Present outcome
@enduml
