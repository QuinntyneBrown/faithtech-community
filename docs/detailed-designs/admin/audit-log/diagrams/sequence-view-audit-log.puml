@startuml
title UML sequence behaviour — View and export the audit log
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Administrator (or holder of ManageRoles / ManageOrganisationSettings)" as actor
box "Frontend — Community web app (admin library)" #E0F2FE
  participant "AuditLogPage" as page
end box
box "Frontend — Community web app (api library)" #E0F2FE
  participant "HttpAuditLogService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AuditLogEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetAuditEntriesHandler" as q
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Choose a category
page -> svc : getEntries({ category }, page)
svc -> ep : GET /api/admin/audit?category&actor&from&to&page (HANDLES_FORBIDDEN)
ep -> q : HandleAsync(GetAuditEntriesQuery)
alt caller lacks AdministerOrganisation, ManageRoles and ManageOrganisationSettings
  q --> ep : null
  ep --> svc : 403 (L2-041 AC4)
  svc --> page : HttpErrorResponse 403
  page --> actor : Show the page's forbidden state
else caller may read
  q -> q : Limit categories to those the caller may change unless AdministerOrganisation (L2-152 AC3)
  q -> db : Filter from 90 days ago by default, order by OccurredAtUtc desc, take 50 (L2-041 AC2); scoped by ICurrentOrganisation
  db --> q : Entries
  q -> db : Load actor and target profile names
  q --> ep : PagedResult<AuditEntryDto> with summaries
  ep --> svc : 200 OK
  svc --> page : Entries
  page --> actor : Show When, Who, What; Show older entries when more remain
end
opt Export CSV
  actor -> page : Choose Export CSV
  page -> svc : exportCsv({ category })
  svc -> ep : GET /api/admin/audit/export?category
  ep -> q : HandleAllAsync(GetAuditEntriesQuery)
  q -> db : Same filters, up to 10,000 rows
  q --> ep : AuditEntryDto list
  ep --> svc : 200 text/csv audit-log.csv (L2-041 AC5)
  svc --> page : Blob
  page --> actor : Download audit-log.csv
end
@enduml
