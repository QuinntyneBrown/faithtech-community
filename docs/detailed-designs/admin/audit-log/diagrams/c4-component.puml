@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Audit log
Container_Boundary(web, "Web app") {
  Component(page, "AuditLogPage", "Angular page (admin library)", "Filters by category, shows older entries, exports CSV")
  Component(svc, "HttpAuditLogService", "Angular service (api library)", "Implements AuditLogService; sets HANDLES_FORBIDDEN")
}
Container_Boundary(api, "Community API") {
  Component(ep, "AuditLogEndpoints", "ASP.NET Core minimal API", "GET /api/admin/audit and /api/admin/audit/export only")
  Component(q, "GetAuditEntriesHandler", "Application handler", "HandleAsync (50 per page) and HandleAllAsync (CSV)")
  Component(writers, "Role, suspension, invite and profile handlers", "Application handlers", "Call IAuditLog.Record")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; stamps UTC time and IP address")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, svc, "Calls")
Rel(svc, ep, "GET", "JSON or CSV over HTTPS")
Rel(ep, q, "Sends GetAuditEntriesQuery")
Rel(q, db, "Reads AuditEntries", "EF Core")
Rel(writers, audit, "Record(actor, action, target, before, after)")
Rel(audit, db, "Adds AuditEntry to the unit of work", "EF Core")
@enduml
