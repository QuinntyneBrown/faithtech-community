@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Admin users page and override
Container_Boundary(web, "Web app") {
  Component(page, "AdminUsersPage", "Angular page", "Searches users and shows roles and status")
  Component(svc, "HttpAdminUsersService", "Angular service", "Implements AdminUsersService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "AdminUsersEndpoints", "ASP.NET Core minimal API", "GET /api/admin/users")
  Component(h, "SearchUsersHandler", "Application handler", "Searches all users")
  Component(pol, "AdminOverridePolicy", "Application permission check", "Grants System Admin override and requests audit")
  Component(other, "Other feature handlers", "Application handlers", "Contacts, workspaces and others consult the override policy")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; appends immutable audit entries")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, svc, "Calls")
Rel(svc, ep, "GET", "JSON/HTTPS")
Rel(ep, h, "Sends query")
Rel(h, pol, "Requires System Admin")
Rel(h, db, "Queries", "EF Core")
Rel(other, pol, "Checks override")
Rel(other, audit, "Writes override audit entry")
@enduml
