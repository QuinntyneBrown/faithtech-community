@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Admin users page and override
Container_Boundary(web, "Web app") {
  Component(page, "AdminUsersPage", "Angular page (admin library)", "Searches users and shows roles and status")
  Component(svc, "HttpAdminUsersService", "Angular service (api library)", "Implements AdminUsersService; sets HANDLES_FORBIDDEN")
}
Container_Boundary(api, "Community API") {
  Component(ep, "AdminUsersEndpoints", "ASP.NET Core minimal API", "GET /api/admin/users")
  Component(h, "SearchUsersHandler", "Application handler", "Searches all users; AdministerOrganisation only")
  Component(cur, "ICurrentUser", "Application abstraction", "Caller id and capabilities computed from current roles")
  Component(access, "ProfileAccess", "Application access check", "Owner, AdminOverride or Forbidden via AuthorizationRules.IsOverride (ADR 0004, L2-135 AC5)")
  Component(other, "Profile handlers", "Application handlers", "UpdateProfileHandler, UploadPhotoHandler and photo handlers")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; adds audit entries to the unit of work")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, svc, "Calls")
Rel(svc, ep, "GET", "JSON/HTTPS")
Rel(ep, h, "HandleAsync(term, page)")
Rel(h, cur, "Requires AdministerOrganisation")
Rel(h, db, "Queries", "EF Core")
Rel(other, access, "AuthorizeEditAsync")
Rel(access, cur, "Reads capabilities")
Rel(other, audit, "Record() when AdminOverride")
Rel(audit, db, "Adds AuditEntry", "EF Core")
@enduml
