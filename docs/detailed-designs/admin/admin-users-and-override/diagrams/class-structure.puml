@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Admin users page and override
enum UserStatus {
  Active
  Suspended
  Unverified
}
class AdminUserSummary <<record>> {
  +Guid Id
  +string Name
  +string Email
  +IReadOnlyList<HeldRole> Roles
  +string Status
}
class SearchUsersHandler {
  +PageSize: int = 25
  +HandleAsync(term: string?, page: int): Task<PagedResult<AdminUserSummary>?>
}
interface ICurrentOrganisation {
  +Guid Id
  +string Name
}
interface ICurrentUser {
  +Guid? UserId
  +IReadOnlyCollection<HeldRole> Roles
  +IReadOnlySet<string> Capabilities
  +bool IsAuthenticated
  +Has(capability: string): bool
}
class AuthorizationRules <<static>> {
  +{static} IsOverride(actor: ICurrentUser, capability: string): bool
}
enum EditAccess {
  Owner
  AdminOverride
  Forbidden
}
class ProfileAccess {
  +CallerProfileIdAsync(): Task<Guid?>
  +CanEdit(profileId: Guid, callerProfileId: Guid?): bool
  +AuthorizeEditAsync(profileId: Guid): Task<(EditAccess, Guid Actor)>
}
class UpdateProfileHandler {
  +HandleAsync(profileId: Guid, command: UpdateProfileCommand): Task<Result>
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
SearchUsersHandler ..> ICurrentUser : requires AdministerOrganisation
SearchUsersHandler ..> ICurrentOrganisation : scoped by
SearchUsersHandler ..> AdminUserSummary : returns
AdminUserSummary ..> UserStatus : Status name
ProfileAccess ..> ICurrentUser
ProfileAccess ..> AuthorizationRules : IsOverride
ProfileAccess ..> EditAccess : returns
UpdateProfileHandler --> ProfileAccess
UpdateProfileHandler ..> IAuditLog : Record() when AdminOverride
@enduml
