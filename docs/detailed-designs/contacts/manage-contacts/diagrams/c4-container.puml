@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage private contacts
Person(lead, "Member with KeepContacts", "Holder of the KeepContacts capability who keeps private contacts")
Person(admin, "Administrator", "Holder of AdministerOrganisation; overrides are audited")
System_Boundary(community, "Community platform") {
  Container(web, "Web app", "Angular", "Shell, contacts feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Profiles, roles, contacts, partners and audit log")
}
Rel(lead, web, "Uses", "HTTPS")
Rel(admin, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS, OAuth2 bearer token")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
