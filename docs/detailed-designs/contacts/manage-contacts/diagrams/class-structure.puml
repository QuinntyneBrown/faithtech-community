class CreateContactCommand {
  +string Name
  +string Email
  +string Phone
  +string Organization
  +string Notes
}
class ContactValidator {
  +Validate(command: CreateContactCommand): ValidationResult
}
class CreateContactHandler {
  +Handle(command: CreateContactCommand): Task<ContactDto>
}
class ListContactsHandler {
  +Handle(query: ListContactsQuery): Task<IReadOnlyList<ContactSummary>>
}
class GetContactHandler {
  +Handle(query: GetContactQuery): Task<ContactDto>
}
