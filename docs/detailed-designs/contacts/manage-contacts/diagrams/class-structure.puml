title Class structure — Manage private contacts
class Contact {
  +Guid Id
  +Guid OwnerId
  +string Name
  +string Email
  +string Phone
  +string Organization
  +Guid? LinkedProfileId
  +DateTime? ArchivedAtUtc
  +Archive(nowUtc: DateTime): void
  +Restore(): void
  +LinkTo(profileId: Guid): void
}
class ContactNote {
  +Guid Id
  +Guid ContactId
  +string Body
  +DateTime CreatedAtUtc
}
class ContactAccessPolicy {
  +CanAccess(caller: ICurrentUser, contact: Contact): AccessResult
}
interface ICurrentUser {
  +Guid ProfileId
  +bool IsSystemAdmin
  +bool HoldsLeadRole
}
