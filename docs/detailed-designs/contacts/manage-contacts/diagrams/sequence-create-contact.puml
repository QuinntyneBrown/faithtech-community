@startuml
title UML sequence behaviour — Create a contact
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "City Lead" as actor
box "Frontend — FaithTech Community web app (contacts library)" #E0F2FE
  participant "ContactFormPage" as form
  participant "HttpContactsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ContactsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "CreateContactHandler" as h
  participant "ContactValidator" as v
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> form : Fill fields and save
form -> svc : create(contact)
svc -> ep : POST /api/contacts
ep -> h : Send CreateContactCommand
h -> v : Validate name and email (L2-013 AC2)
alt invalid
  v --> h : Errors
  h --> ep : Validation failure
  ep --> svc : 400 ProblemDetails with field errors
  svc --> form : Errors
  form --> actor : Inline errors, focus first invalid field
else valid
  h -> db : Insert Contact with OwnerId = caller (L2-013 AC1)
  h --> ep : ContactDto
  ep --> svc : 201 Created
  svc --> form : Contact
  form --> actor : Navigate to contact list
end
@enduml
