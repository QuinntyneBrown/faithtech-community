@startuml
title UML sequence behaviour — Get a contact
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Any signed-in user" as actor
box "Frontend — Community web app (contacts library)" #E0F2FE
  participant "ContactPage" as page
  participant "HttpContactsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ContactsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ManageContactsHandler" as h
  participant "ContactAccess" as acc
  participant "ContactViews" as views
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Open /contacts/{id}
page -> svc : get(id) and getNotes(id)
svc -> ep : GET /api/contacts/{id}
ep -> h : GetAsync(id)
h -> acc : AuthorizeAsync(id)
acc -> db : Load caller's profile id and the Contact
alt NotFound (unknown id, or any other member, view-only capabilities included)
  acc --> h : NotFound, no contact
  h --> ep : null
  ep --> svc : 404 (L2-012 AC1)
  svc --> page : Error
  page --> actor : Not-found state
else Owner or AdminOverride
  acc --> h : Access kind, Contact, actor
  h -> acc : AuditOverride(kind, actor, contact, "contact.viewed")
  opt AdminOverride
    acc -> audit : Record contact.viewed, target type Contact (L2-012 AC2, L2-135 AC5)
  end
  h -> db : Save changes
  h -> views : ToDtoAsync(contact, isOwn = Owner)
  views -> db : Linked profile name and photo, member match, note count
  h --> ep : ContactDto
  ep --> svc : 200 OK
  svc --> page : Contact
  page --> actor : Contact; "your access is recorded" when isOwn is false
end
@enduml
