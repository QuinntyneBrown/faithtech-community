@startuml
title UML sequence behaviour — Get a contact
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Any signed-in user" as actor
box "Frontend — FaithTech Community web app (contacts library)" #E0F2FE
  participant "ContactPage" as page
  participant "HttpContactsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ContactsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetContactHandler" as h
  participant "ContactAccessPolicy" as pol
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> page : Open contact URL
page -> svc : get(id)
svc -> ep : GET /api/contacts/{id}
ep -> h : Send GetContactQuery
h -> db : Load Contact
h -> pol : CanAccess(caller, contact)
alt Owner
  h --> ep : ContactDto
  ep --> svc : 200 OK
else AdminOverride
  h -> audit : Write audit entry (L2-012 AC2)
  h --> ep : ContactDto
  ep --> svc : 200 OK
else NotFound (any other user, including Staff)
  h --> ep : Not found (L2-012 AC1)
  ep --> svc : 404 ProblemDetails
end
svc --> page : Result
page --> actor : Contact or not-found page
@enduml
