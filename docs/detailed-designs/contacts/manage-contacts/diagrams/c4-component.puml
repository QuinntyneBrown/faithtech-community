@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage private contacts
Container_Boundary(web, "Web app") {
  Component(list, "ContactsPage", "Angular page (contacts library)", "/contacts: own contacts as cards, search, empty and forbidden states")
  Component(page, "ContactPage", "Angular page (contacts library)", "/contacts/:id: one contact, not-found state")
  Component(form, "ContactFormPage", "Angular page (contacts library)", "/contacts/new and /contacts/:id/edit; Save and link")
  Component(svc, "HttpContactsService", "Angular service (api library)", "Implements ContactsService (CONTACTS_SERVICE)")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "GET, POST /api/contacts; GET, PUT /api/contacts/{id}")
  Component(val, "CreateContactValidator / UpdateContactValidator", "FluentValidation", "ContactRules: name, email and field lengths")
  Component(h, "ManageContactsHandler", "Application handler", "CreateAsync, GetAsync, UpdateAsync, ListAsync")
  Component(acc, "ContactAccess", "Application permission check", "CanKeepContacts; AuthorizeAsync: Owner, AdminOverride or NotFound")
  Component(views, "ContactViews", "Application service", "ContactDto with linked profile and member match")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; adds audit entries to the unit of work")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "Contacts and ContactNotes tables")
}
Rel(list, svc, "list(term)")
Rel(page, svc, "get(id)")
Rel(form, svc, "create / update")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, val, "Validates body (400)")
Rel(ep, h, "Calls")
Rel(h, acc, "Checks L2-012 visibility")
Rel(h, views, "Builds ContactDto")
Rel(acc, audit, "Records admin override")
Rel(h, db, "Owner-scoped query and save", "EF Core")
@enduml
