@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage private contacts
Container_Boundary(web, "Web app") {
  Component(list, "ContactsPage", "Angular page", "Lists and filters own contacts")
  Component(form, "ContactFormPage", "Angular page", "Creates and edits a contact")
  Component(svc, "HttpContactsService", "Angular service", "Implements ContactsService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "/api/contacts")
  Component(h, "Contact handlers", "Application handler", "Create, update, get and list")
  Component(pol, "ContactAccessPolicy", "Application permission check", "Owner or System Admin only")
  Component(search, "ContactSearch", "Infrastructure query", "Owner-scoped filter on name, email, organization")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; appends immutable audit entries")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(list, svc, "Calls")
Rel(form, svc, "Calls")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "Sends command or query")
Rel(h, pol, "Checks L2-012 visibility")
Rel(h, search, "Lists and filters")
Rel(h, audit, "Audits admin access")
Rel(h, db, "Persists", "EF Core")
Rel(search, db, "Queries", "SQL")
@enduml
