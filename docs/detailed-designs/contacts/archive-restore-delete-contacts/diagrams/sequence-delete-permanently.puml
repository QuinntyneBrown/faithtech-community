@startuml
title UML sequence behaviour — Delete a contact permanently
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member with KeepContacts" as actor
box "Frontend — Community web app (contacts library)" #E0F2FE
  participant "ArchivedContactsPage" as arch
  participant "DeleteContactDialog" as dlg
  participant "HttpContactsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ContactsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ArchiveContactsHandler" as h
  participant "ContactAccess" as acc
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> arch : Choose Delete permanently
arch -> dlg : Open with {contactId, name}
actor -> dlg : Type confirmation
dlg -> dlg : Enable Delete only when text equals DELETE (L2-016 AC4)
actor -> dlg : Confirm
dlg -> svc : delete(id)
svc -> ep : DELETE /api/contacts/{id}
ep -> h : DeleteAsync(id)
h -> acc : AuthorizeAsync(id, withNotes: true)
alt NotFound
  ep --> svc : 404
  svc --> dlg : Error
  dlg --> actor : Failed alert in the dialog
else not archived (CanBeDeleted is false)
  h --> ep : Conflict "Archive the contact before deleting it."
  ep --> svc : 409 ProblemDetails
  svc --> dlg : Error
  dlg --> actor : Failed alert in the dialog
else archived
  h -> acc : AuditOverride(..., "contact.deleted")
  h -> db : Remove Contact; ContactNote rows deleted by cascade (L2-016 AC3)
  ep --> svc : 204 No Content
  svc --> dlg : Done
  dlg --> arch : Close with true
  arch --> actor : Row removed; "Contact deleted" toast
end
@enduml
