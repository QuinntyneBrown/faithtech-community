@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Archive, restore and delete contacts
class Contact {
  +Guid Id
  +Guid OrganisationId
  +Guid OwnerId
  +string Name
  +string? Email
  +string? Phone
  +string? Organization
  +string? City
  +Guid? LinkedProfileId
  +DateTime? ArchivedAtUtc
  +bool IsArchived
  +bool CanBeDeleted
  +IReadOnlyCollection<ContactNote> Notes
  +Update(name, email, phone, organization, city): void
  +AddNote(body: string, nowUtc: DateTime): ContactNote
  +Archive(nowUtc: DateTime): void
  +Restore(): void
  +LinkTo(profileId: Guid, discardNotes: bool = false): void
}
class ContactNote {
  +Guid Id
  +Guid ContactId
  +string Body
  +DateTime CreatedAtUtc
}
enum ContactAccessKind {
  Owner
  AdminOverride
  NotFound
}
class ContactAccess {
  +bool CanKeepContacts
  +CallerProfileIdAsync(): Task<Guid?>
  +AuthorizeAsync(contactId: Guid, withNotes: bool = false): Task<(ContactAccessKind, Contact?, Guid Actor)>
  +AuditOverride(access: ContactAccessKind, actor: Guid, contact: Contact, action: string, before: object? = null, after: object? = null): void
}
interface ICurrentUser {
  +Guid? UserId
  +IReadOnlySet<string> Capabilities
  +Has(capability: string): bool
}
interface ICurrentOrganisation {
  +Guid Id
}
interface IAuditLog {
  +Record(actorId: Guid, action: string, targetType: string, targetId: string, before: object?, after: object?): void
}
Contact "1" *-- "*" ContactNote
ContactAccess ..> Contact : loads
ContactAccess ..> ContactAccessKind : returns
ContactAccess ..> ICurrentUser
ContactAccess ..> ICurrentOrganisation : scopes
ContactAccess ..> IAuditLog : AdminOverride only

class ArchiveContactsHandler {
  +ArchiveAsync(id: Guid): Task<Result>
  +RestoreAsync(id: Guid): Task<Result>
  +DeleteAsync(id: Guid): Task<Result>
}
class ManageContactsHandler {
  +ListArchivedAsync(): Task<IReadOnlyList<ContactSummaryDto>?>
}
class ContactSummaryDto <<record>> {
  +Guid Id
  +string Name
  +string? Email
  +string? Organization
  +string? City
  +string Status
  +DateTime? ArchivedAtUtc
}
ArchiveContactsHandler --> ContactAccess
ArchiveContactsHandler --> Contact : Archive, Restore, removes
ManageContactsHandler --> ContactAccess
ManageContactsHandler ..> ContactSummaryDto : archived, newest first
@enduml
