@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Archive, restore and delete contacts
Container_Boundary(web, "Web app") {
  Component(page, "ContactPage", "Angular page (contacts library)", "Archive action")
  Component(arch, "ArchivedContactsPage", "Angular page (contacts library)", "/contacts/archived: Restore and Delete permanently")
  Component(adlg, "ArchiveContactDialog", "Angular CDK Dialog (contacts library)", "Confirms archive")
  Component(ddlg, "DeleteContactDialog", "Angular CDK Dialog (contacts library)", "Delete enabled only when DELETE is typed")
  Component(svc, "HttpContactsService", "Angular service (api library)", "archive, restore, listArchived, delete")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "POST {id}/archive, POST {id}/restore, GET archived, DELETE {id}")
  Component(mh, "ManageContactsHandler", "Application handler", "ListArchivedAsync")
  Component(h, "ArchiveContactsHandler", "Application handler", "ArchiveAsync, RestoreAsync, DeleteAsync")
  Component(acc, "ContactAccess", "Application permission check", "AuthorizeAsync and AuditOverride")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "Contacts; ContactNotes deleted by cascade")
}
Rel(page, adlg, "Opens with DialogService")
Rel(arch, ddlg, "Opens with DialogService")
Rel(adlg, svc, "archive(id)")
Rel(ddlg, svc, "delete(id)")
Rel(arch, svc, "listArchived / restore(id)")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, mh, "ListArchivedAsync")
Rel(ep, h, "ArchiveAsync / RestoreAsync / DeleteAsync")
Rel(h, acc, "Checks visibility")
Rel(acc, audit, "Records admin override")
Rel(h, db, "Single save per change", "EF Core")
Rel(mh, db, "Owner's archived contacts", "EF Core")
@enduml
