@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Archive, restore and delete contacts
Container_Boundary(web, "Web app") {
  Component(arch, "ArchivedContactsPage", "Angular page", "Lists archived contacts")
  Component(dlg, "ArchiveContactDialog / DeleteContactDialog", "Angular CDK Dialog", "Confirms archive or typed DELETE")
  Component(svc, "HttpContactsService", "Angular service", "Implements ContactsService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "archive, restore, archived and DELETE routes")
  Component(h, "Archive / Restore / DeleteContactHandler", "Application handler", "Changes contact lifecycle")
  Component(pol, "ContactAccessPolicy", "Application permission check", "Owner or System Admin only")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(arch, dlg, "Opens")
Rel(dlg, svc, "Calls")
Rel(arch, svc, "Calls")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "Sends command")
Rel(h, pol, "Checks visibility")
Rel(h, db, "Persists", "EF Core")
@enduml
