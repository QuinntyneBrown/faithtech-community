@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Contact notes
Container_Boundary(web, "Web app") {
  Component(page, "ContactPage", "Angular page (contacts library)", "Shows notes newest first; Add note button")
  Component(dlg, "AddNoteDialog", "Angular CDK Dialog (contacts library)", "One required note, 1 to 2,000 characters; busy and failed states")
  Component(svc, "HttpContactsService", "Angular service (api library)", "getNotes and addNote")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "GET and POST /api/contacts/{id}/notes")
  Component(val, "AddContactNoteValidator", "FluentValidation", "Body required, at most 2,000 characters")
  Component(h, "ContactNotesHandler", "Application handler", "ListAsync and AddAsync")
  Component(acc, "ContactAccess", "Application permission check", "AuthorizeAsync: Owner, AdminOverride or NotFound")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; adds audit entries to the unit of work")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "ContactNotes table, indexed by contact and time")
}
Rel(page, dlg, "Opens with DialogService")
Rel(dlg, svc, "addNote(contactId, body)")
Rel(page, svc, "getNotes(contactId)")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, val, "Validates body (400)")
Rel(ep, h, "Calls")
Rel(h, acc, "Checks visibility")
Rel(acc, audit, "Records notes-viewed or note-added on admin override")
Rel(h, db, "Reads and inserts notes", "EF Core")
@enduml
