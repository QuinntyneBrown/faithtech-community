@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Contact notes
Container_Boundary(web, "Web app") {
  Component(page, "ContactPage", "Angular page", "Shows notes newest first")
  Component(dlg, "AddNoteDialog", "Angular CDK Dialog", "Captures a note")
  Component(svc, "HttpContactsService", "Angular service", "Implements ContactsService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "/api/contacts/{id}/notes")
  Component(h, "AddContactNoteHandler / GetContactNotesHandler", "Application handler", "Adds and reads notes")
  Component(pol, "ContactAccessPolicy", "Application permission check", "Owner or System Admin only")
  Component(audit, "AuditLog", "Infrastructure service", "Implements IAuditLog; appends immutable audit entries")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "EF Core context over the Community database")
}
Rel(page, dlg, "Opens")
Rel(dlg, svc, "Calls")
Rel(page, svc, "Calls")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "Sends command or query")
Rel(h, pol, "Checks visibility")
Rel(h, audit, "Audits admin access")
Rel(h, db, "Persists", "EF Core")
@enduml
