@startuml
title UML sequence behaviour — Check the email when the field loses focus
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Lead or System Admin" as actor
box "Frontend — FaithTech Community web app (contacts library)" #E0F2FE
  participant "ContactFormPage" as page
  participant "HttpContactsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ContactsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "FindDuplicateContactHandler" as h
  participant "ContactAccess" as acc
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box

actor -> page : Leave the email field
page -> page : Skip when blank, malformed or already checked
page -> svc : findDuplicate(email, excludeId)
svc -> ep : GET /api/contacts/duplicates?email=&excludeId=
ep -> h : Send FindDuplicateContactQuery
h -> acc : CanKeepContacts and CallerProfileIdAsync
alt anonymous or no lead role and not System Admin
  acc --> h : refused
  h --> ep : Forbidden
  ep --> svc : 401 or 403 (L2-116 AC8)
  svc --> page : Error; no warning
else lead or System Admin
  acc --> h : caller profile id
  h -> db : Contacts where OwnerId = caller and lower(Email) = lower(trim(email)) and Id <> excludeId, active or archived (L2-116 AC1, AC6)
  db --> h : Oldest match with note count, or none
  alt own match
    h --> ep : DuplicateContactDto
    ep --> svc : 200 OK
    svc --> page : Match
    page --> actor : Warning alert with Open {name}; save reads "Save as a new contact" (L2-116 AC2)
  else no own match, including another lead's contact
    h --> ep : No match
    ep --> svc : 204 No Content (L2-116 AC5)
    svc --> page : null
    page --> actor : No warning (L2-116 AC4)
  end
end
@enduml
