@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Possible duplicate contact

Container_Boundary(spa, "Web app") {
  Component(page, "ContactFormPage", "Angular page (contacts library)", "Checks the email on blur and before save; shows the warning")
  Component(alert, "ft-alert (warning)", "components library", "role=status alert with Open {name} action")
  Component(svc, "ContactsService / CONTACTS_SERVICE", "TypeScript contract and token (api library)", "findDuplicate(email, excludeId)")
  Component(http, "HttpContactsService", "Angular service (api library)", "Maps 204 to null")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "GET /api/contacts/duplicates; no business logic")
  Component(h, "FindDuplicateContactHandler", "Application query handler", "Own contacts only, active or archived")
  Component(acc, "ContactAccess", "Application service", "CanKeepContacts and caller profile")
  Component(ctx, "CommunityDbContext", "EF Core DbContext", "Contacts and ContactNotes")
}
ContainerDb(db, "Community database", "PostgreSQL", "Contacts and contact notes")
Rel(page, alert, "Renders")
Rel(page, svc, "Calls findDuplicate")
Rel(svc, http, "Implemented by")
Rel(http, ep, "JSON/HTTPS")
Rel(ep, h, "Dispatches FindDuplicateContactQuery")
Rel(h, acc, "Checks caller with")
Rel(h, ctx, "Reads")
Rel(ctx, db, "SQL")
@enduml
