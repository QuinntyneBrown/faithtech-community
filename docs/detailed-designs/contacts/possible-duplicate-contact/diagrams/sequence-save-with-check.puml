@startuml
title UML sequence behaviour — Save with a pre-save check
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member with KeepContacts or Administrator" as actor
box "Frontend — Community web app (contacts library)" #E0F2FE
  participant "ContactFormPage" as page
  participant "HttpContactsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ContactsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "FindDuplicateContactHandler" as dup
  participant "ManageContactsHandler" as save
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box

actor -> page : Save
alt email not yet checked
  page -> svc : findDuplicate(email, excludeId), 2 s timeout
  svc -> ep : GET /api/contacts/duplicates
  ep -> dup : Send FindDuplicateContactQuery
  dup -> db : Own contacts by email
  alt own match
    db --> dup : Match
    dup --> ep : DuplicateContactDto
    ep --> svc : 200 OK
    svc --> page : Match
    page --> actor : Show warning; this save stops (L2-116 AC1)
    actor -> page : Save as a new contact (no second check)
  else no match, error or timeout
    ep --> svc : 204, error or no answer
    svc --> page : null or failure
    page -> page : Continue saving (L2-116 AC7)
  end
end
page -> svc : create(contact) or update(id, contact)
svc -> ep : POST /api/contacts or PUT /api/contacts/{id}
ep -> save : CreateAsync or UpdateAsync
save -> db : Insert or update a separate contact (L2-116 AC3)
db --> save : Committed
save --> ep : ContactDto
ep --> svc : 201 Created or 200 OK
svc --> page : Saved
page --> actor : Open the contact page
@enduml
