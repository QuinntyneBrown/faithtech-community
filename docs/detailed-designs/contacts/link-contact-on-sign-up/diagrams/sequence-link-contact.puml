@startuml
title UML sequence behaviour — Link a contact
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member with KeepContacts" as actor
box "Frontend — Community web app (contacts library)" #E0F2FE
  participant "ContactPage" as page
  participant "LinkContactDialog" as dlg
  participant "HttpContactsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ContactsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "LinkContactHandler" as h
  participant "ContactAccess" as acc
  participant "Contact" as c
  participant "ContactViews" as views
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open /contacts/{id} from the notification, email or list alert
page --> actor : Match prompt for contact.match
alt Not them
  actor -> page : Choose Not them
  page --> actor : Prompt hidden on this visit only; nothing stored (L2-015 AC4)
else Link to their profile
  actor -> page : Choose Link to their profile
  page -> dlg : Open with {contactId, email, noteCount, member}
  actor -> dlg : Keep or discard notes, confirm "Link contact"
  dlg -> svc : link(contactId, profileId, discardNotes)
  svc -> ep : POST /api/contacts/{id}/link
  ep -> h : LinkAsync(id, LinkContactCommand)
  h -> acc : AuthorizeAsync(id, withNotes: discardNotes)
  alt NotFound, or the profile does not exist
    h --> ep : NotFound
    ep --> svc : 404
    svc --> dlg : Error
    dlg --> actor : Failed alert in the dialog
  else already linked
    h --> ep : Conflict "The contact is already linked to a profile."
    ep --> svc : 409 ProblemDetails
  else Owner or AdminOverride
    h -> c : LinkTo(profileId, discardNotes): notes kept (L2-015 AC2) or cleared (AC5)
    h -> acc : AuditOverride(kind, actor, contact, "contact.linked")
    h -> db : Save changes
    h -> views : ToDtoAsync(contact)
    h --> ep : ContactDto with the profile's name and featured photo
    ep --> svc : 200 OK
    svc --> dlg : Contact
    dlg --> page : Close with the linked contact
    page -> svc : getNotes(contactId)
    page --> actor : Contact shows the profile's name and photo
  end
end
@enduml
