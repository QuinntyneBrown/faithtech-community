@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Link a contact on sign-up
Container_Boundary(web, "Web app") {
  Component(verify, "VerifyEmailPage", "Angular page (app shell)", "Confirms the verify-email link")
  Component(page, "ContactPage", "Angular page (contacts library)", "Match prompt: Link to their profile or Not them")
  Component(dlg, "LinkContactDialog", "Angular CDK Dialog (contacts library)", "Keep or discard notes, then link")
  Component(svc, "HttpContactsService", "Angular service (api library)", "link(contactId, profileId, discardNotes)")
}
Container_Boundary(api, "Community API") {
  Component(acct, "AccountEndpoints", "ASP.NET Core minimal API", "POST /api/account/verify-email")
  Component(confirm, "ConfirmEmailHandler / AcceptInviteHandler", "Application handlers (Identity, Invites)", "Verify an email, or create a verified account from an invite")
  Component(evt, "ContactSignedUpHandler", "Application handler", "Connects pending connections, then matches the verified email to active, unlinked contacts")
  Component(conn, "ContactConnector", "Application service", "Creates or links the connecting lead's contact (L2-084)")
  Component(connect, "ConnectHandler / GoogleSignInHandler", "Application handlers (Invites, Identity)", "Connect link sign-up and connect; Google sign-in")
  Component(ep, "ContactsEndpoints", "ASP.NET Core minimal API", "POST /api/contacts/{id}/link")
  Component(h, "LinkContactHandler", "Application handler", "LinkAsync: links the contact to the profile")
  Component(acc, "ContactAccess", "Application permission check", "AuthorizeAsync and AuditOverride")
  Component(views, "ContactViews", "Application service", "Profile name and photo, member match")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "Contacts, ContactNotes and Notifications tables")
}
System_Ext(email, "Email provider", "SMTP/SendGrid")
Rel(verify, acct, "confirmEmail(userId, token)", "JSON/HTTPS")
Rel(acct, confirm, "HandleAsync")
Rel(confirm, evt, "HandleAsync(EmailVerified)")
Rel(evt, conn, "ConnectAsync for each PendingConnection")
Rel(connect, conn, "RequestAsync")
Rel(connect, evt, "HandleAsync(EmailVerified) (Google)")
Rel(conn, db, "Contact, Notification, PendingConnection", "EF Core")
Rel(evt, db, "Finds contacts; adds ContactSignedUp notifications", "EF Core")
Rel(evt, email, "Emails each owning lead via", "IEmailSender")
Rel(page, dlg, "Opens with DialogService")
Rel(dlg, svc, "link(...)")
Rel(svc, ep, "Sends request", "JSON/HTTPS")
Rel(ep, h, "LinkAsync")
Rel(h, acc, "Checks ownership; audits admin override")
Rel(h, views, "Builds ContactDto")
Rel(h, db, "Persists", "EF Core")
@enduml
