@startuml
title UML sequence behaviour — Notify the lead after verification
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "New member" as actor
box "Frontend — FaithTech Community web app (app shell — email verification)" #E0F2FE
  participant "VerifyEmailPage" as page
  participant "HttpAuthService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AccountEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ConfirmEmailHandler" as v
  participant "ContactSignedUpHandler" as evt
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
  participant "IEmailSender" as mail
end box
actor -> page : Open verification link
page -> svc : confirmEmail(userId, token)
svc -> ep : POST /api/account/verify-email
ep -> v : HandleAsync(ConfirmEmailCommand) (L2-002)
v -> db : UserManager.ConfirmEmailAsync
alt bad, used or expired token
  v --> ep : Invalid
  ep --> svc : 400
else verified
  v -> evt : HandleAsync(EmailVerified(profileId, email))
  note right of evt : AcceptInviteHandler makes the same call\nwhen an invite creates a new, verified account
  evt -> db : Active, unlinked contacts where upper(Email) = verified email
  db --> evt : Matching contacts
  opt any match
    loop each matching contact
      evt -> db : Add Notification(owner, ContactSignedUp, "{name} just joined FaithTech", /contacts/{id})
    end
    evt -> db : Save changes
    evt -> db : Owners' email addresses
    loop each matching contact
      evt -> mail : SendAsync(email to the owning lead with the contact link) (L2-015 AC1)
    end
  end
  v --> ep : Ok
  ep --> svc : 200 OK
  svc --> page : Done
  page --> actor : Email verified
end
note over evt : An unverified sign-up never reaches this handler,\nso no lead is told (L2-015 AC3)
@enduml
