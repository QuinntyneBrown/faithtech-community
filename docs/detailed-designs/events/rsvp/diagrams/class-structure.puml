@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — RSVP

enum EventType {
  Gathering
  BuildersNight
  Hackathon
  PrayerAndPlanning
  Panel
}

enum EventFormat {
  InPerson
  Online
}

enum EventVisibility {
  MembersOnly
  Public
}

class Event <<Domain entity>> {
  +Guid Id
  +string Title
  +string Description
  +EventType Type
  +DateTimeOffset StartsAt
  +DateTimeOffset EndsAt
  +string City
  +EventFormat Format
  +string? Venue
  +string? OnlineLink
  +int? Capacity
  +EventVisibility Visibility
  +bool IsCancelled
  +string? CancellationReason
  +int Sequence
  +Guid CreatedById
  +int RsvpCount «excludes walk-ins»
  +bool IsFull «excludes walk-ins»
  +Update(title, description, type, startsAt, endsAt, city, format, venue, onlineLink, capacity, visibility): void
  +Cancel(reason: string): void
  +Rsvp(profileId: Guid, now: DateTimeOffset): Rsvp
  +GuestRsvp(name: string, email: string, now: DateTimeOffset): Rsvp
  +CancelRsvp(profileId: Guid): void
  +CancelGuestRsvp(rsvpId: Guid): void
}
Event --> EventType
Event --> EventFormat
Event --> EventVisibility

class Rsvp <<Domain entity>> {
  +Guid Id
  +Guid EventId
  +Guid? ProfileId
  +string? GuestName
  +string? GuestEmail
  +DateTimeOffset CreatedAt
  +DateTimeOffset? CheckedInAt
  +Guid? CheckedInById
  +bool IsWalkIn
  +bool IsGuest
}
Event "1" *-- "*" Rsvp : rsvps

class EventPermissions <<Application service>> {
  +CanManageEvents(user: ICurrentUser): bool
  +CanSeeRsvpList(user: ICurrentUser): bool
  +CanSeeGuestEmails(user: ICurrentUser): bool
}
interface ICurrentUser {
  +Guid ProfileId
  +IReadOnlySet<Role> Roles
  +bool IsAuthenticated
}
EventPermissions ..> ICurrentUser

class RsvpToEventCommand {
  +Guid EventId
}
class CancelRsvpCommand {
  +Guid EventId
}
class RsvpToEventHandler {
  +Handle(command: RsvpToEventCommand): Task<Result>
}
class CancelRsvpHandler {
  +Handle(command: CancelRsvpCommand): Task<Result>
}
class GetEventHandler {
  +Handle(query: GetEventQuery): Task<EventDetailDto>
}
class EventDetailDto {
  +Guid Id
  +string Title
  +int RsvpCount
  +bool CallerHasRsvp
  +IReadOnlyList<RsvpDto>? Rsvps
}
class RsvpDto {
  +string Name
  +string? GuestEmail
  +bool IsGuest
}
interface IIcsCalendarWriter {
  +Write(event: Event): string
}
interface IEmailSender {
  +SendAsync(message: EmailMessage): Task
}
interface INotificationPublisher {
  +PublishAsync(recipients: IEnumerable<Guid>, notification: Notification): Task
}
RsvpToEventHandler ..> RsvpToEventCommand : handles
CancelRsvpHandler ..> CancelRsvpCommand : handles
RsvpToEventHandler --> Rsvp : creates
CancelRsvpHandler --> Rsvp : removes
RsvpToEventHandler ..> IIcsCalendarWriter
RsvpToEventHandler ..> IEmailSender
RsvpToEventHandler ..> INotificationPublisher
GetEventHandler ..> EventPermissions
GetEventHandler ..> EventDetailDto : returns
EventDetailDto "1" *-- "*" RsvpDto
@enduml
