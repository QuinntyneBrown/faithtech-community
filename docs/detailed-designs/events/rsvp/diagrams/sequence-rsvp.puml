@startuml
title UML sequence behaviour — RSVP to an event
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — FaithTech Community web app (events library)" #E0F2FE
  participant "EventPage" as page
  participant "HttpEventsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "EventsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "RsvpToEventHandler" as h
  participant "Event" as ev
  participant "INotificationPublisher" as notif
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "IcsCalendarWriter" as ics
  participant "EmailSender" as mail
  database "Community database" as db
end box

actor -> page : Select RSVP
page -> svc : rsvp(eventId)
svc -> ep : POST /api/events/{id}/rsvps
ep -> h : Send RsvpToEventCommand
h -> db : Load event and caller RSVP
db --> h : Event
alt event cancelled
  h --> ep : Conflict
  ep --> svc : 409 ProblemDetails
  svc --> page : Error
  page --> actor : RSVPs closed message
else open event
  h -> ev : AddMemberRsvp(profileId) (idempotent)
  h -> notif : Publish RsvpConfirmed (L2-022)
  h -> db : Save RSVP and notification
  db --> h : Committed
  h -> ics : Write(event)
  ics --> h : .ics text
  h -> mail : Send confirmation with .ics attached (L2-022)
  h --> ep : Success
  ep --> svc : 201 Created
  svc --> page : RSVP recorded
  page --> actor : Show RSVP'd state
end
@enduml
