@startuml
title UML sequence behaviour — View RSVP details by role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Signed-in user" as actor
box "Frontend — FaithTech Community web app (events library)" #E0F2FE
  participant "EventPage" as page
  participant "HttpEventsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "EventsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetEventHandler" as h
  participant "EventPermissions" as perm
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box

actor -> page : Open event
page -> svc : getEvent(id)
svc -> ep : GET /api/events/{id}
ep -> h : Send GetEventQuery
h -> db : Load event and RSVPs
db --> h : Event
h -> perm : CanSeeRsvpList(currentUser)
alt attendee
  perm --> h : false
  h -> h : Omit Rsvps; keep RsvpCount (L2-022)
else lead, Staff or System Admin
  perm --> h : true
  h -> perm : CanSeeGuestEmails(currentUser)
  perm --> h : true for leads and System Admin, false for Staff
  h -> h : Include Rsvps; mask guest emails when false (L2-022)
end
h --> ep : EventDetailDto
ep --> svc : 200 OK
svc --> page : Detail
page --> actor : Render count or list
@enduml
