@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — RSVP

Person(member, "Member", "Signed-in user who browses and RSVPs to events")
Person(lead, "Member with ManageAttendance", "Sees the full RSVP list with guest emails and exports it")
Person(staff, "Member with view capabilities", "Holds ViewAttendees: sees the full RSVP list without guest emails")
System_Boundary(ftc, "Community platform") {
  Container(spa, "Web app", "Angular", "Shell, events feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Events, RSVPs, notifications and outbox")
}
System_Ext(email, "Email provider", "SMTP/SendGrid delivery")
Rel(member, spa, "Uses", "HTTPS")
Rel(lead, spa, "Uses", "HTTPS")
Rel(staff, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS, OAuth2 bearer token")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, email, "Sends RSVP confirmation with .ics via", "SMTP")
@enduml
