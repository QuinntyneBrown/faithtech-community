@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Create and edit events

Container_Boundary(spa, "Web app") {
  Component(page, "EventFormPage", "Angular page (events library)", "Create and edit form with inline errors")
  Component(svc, "EventsService / EVENTS_SERVICE", "TypeScript contract and injection token (api library)", "Contract the pages depend on")
  Component(http, "HttpEventsService", "Angular service (api library)", "HTTP implementation of EventsService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "EventsEndpoints", "ASP.NET Core minimal API", "Maps /api/events routes; no business logic")
  Component(val, "EventCommandValidator", "Application validator", "Date order, venue and link rules")
  Component(h, "CreateEventHandler / UpdateEventHandler", "Application handlers", "Authorize, write event, notify RSVPs")
  Component(perm, "EventPermissions", "Application service", "Has(ManageEvents) and the override rule")
  Component(notif, "INotificationPublisher", "Application contract", "Records in-app notifications")
  Component(ctx, "CommunityDbContext", "EF Core DbContext", "Events and RSVPs")
}
ContainerDb(db, "Community database", "PostgreSQL", "Events, RSVPs, notifications and outbox")
Rel(page, svc, "Calls createEvent / updateEvent")
Rel(svc, http, "Implemented by")
Rel(http, ep, "POST/PUT /api/events (JSON/HTTPS)")
Rel(ep, h, "Dispatches command")
Rel(h, val, "Validates with")
Rel(h, perm, "Authorizes with")
Rel(h, notif, "Notifies RSVP'd members via")
Rel(h, ctx, "Reads and writes")
Rel(ctx, db, "SQL")
@enduml
