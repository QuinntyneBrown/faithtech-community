@startuml
title UML sequence behaviour — List and filter events
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Community platform web app (events library)" #E0F2FE
  participant "EventsPage" as page
  participant "HttpEventsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "EventsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ListEventsHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box

actor -> page : Open events, optionally choose a chapter or a type
page -> page : Show loading state
page -> svc : listEvents({ chapter, type })
svc -> ep : GET /api/events?chapter=&type=
ep -> h : Send ListEventsQuery
h -> db : Select upcoming events, chapter and type filters, order by StartsAt (L2-021, L2-142, L2-145)
db --> h : Events with RSVP counts
h --> ep : EventSummaryDto list
ep --> svc : 200 OK
svc --> page : Summaries
alt no events
  page --> actor : Empty state (L2-021)
else events
  page --> actor : Cards with date, chapter or {Organisation}-wide, format, RSVP count; cancelled badge (L2-021)
end
@enduml
