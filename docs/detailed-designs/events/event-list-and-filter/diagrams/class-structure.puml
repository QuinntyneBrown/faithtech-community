@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Event list and filter

enum EventType {
  Standard
  Hackathon
}

enum EventFormat {
  InPerson
  Online
}

enum EventVisibility {
  MembersOnly
  Public
}

class Event <<Domain entity>> {
  +Guid Id
  +string Title
  +string Description
  +EventType Type
  +DateTimeOffset StartsAt
  +DateTimeOffset EndsAt
  +string City
  +EventFormat Format
  +string? Venue
  +string? OnlineLink
  +EventVisibility Visibility
  +bool IsCancelled
  +string? CancellationReason
  +int Sequence
  +Guid CreatedById
}
Event --> EventType
Event --> EventFormat
Event --> EventVisibility

class Rsvp <<Domain entity>> {
  +Guid Id
  +Guid EventId
  +Guid? ProfileId
  +string? GuestName
  +string? GuestEmail
  +DateTimeOffset CreatedAt
  +bool IsGuest
}
Event "1" *-- "*" Rsvp : rsvps

class ListEventsQuery {
  +string? City
}
class ListEventsHandler {
  +Handle(query: ListEventsQuery): Task<IReadOnlyList<EventSummaryDto>>
}
class EventSummaryDto {
  +Guid Id
  +string Title
  +DateTimeOffset StartsAt
  +string City
  +EventFormat Format
  +int RsvpCount
  +bool IsCancelled
}
ListEventsHandler ..> ListEventsQuery : handles
ListEventsHandler ..> Event : reads
ListEventsHandler ..> EventSummaryDto : returns
@enduml
