CheckInHandler ..> IAuditLog
AddWalkInHandler ..> IAuditLog
ExportCheckInsHandler ..> ICsvWriter
ExportCheckInsHandler ..> CsvFile : returns
CheckInHandler ..> CheckInDto : returns
AddWalkInHandler ..> WalkInResultDto : returns

interface CheckInService <<api library>> {
  +getCheckIn(eventId): Observable<CheckInDto>
  +checkIn(eventId, rsvpId): Observable<CheckInAttendeeDto>
  +undoCheckIn(eventId, rsvpId): Observable<void>
  +addWalkIn(eventId, request: WalkInRequest): Observable<WalkInResultDto>
  +exportAttendance(eventId): Observable<Blob>
}
class HttpCheckInService
class EventCheckInPage <<events library>>
class AddWalkInDialog <<events library>>
HttpCheckInService ..|> CheckInService
EventCheckInPage ..> CheckInService : CHECK_IN_SERVICE
AddWalkInDialog ..> CheckInService : CHECK_IN_SERVICE
