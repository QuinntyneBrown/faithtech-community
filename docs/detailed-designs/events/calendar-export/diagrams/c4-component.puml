@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Calendar export

Container_Boundary(spa, "Web app") {
  Component(page, "EventPage / PublicEventPage", "Angular pages (events library)", "Offer .ics download link")
  Component(svc, "EventsService / EVENTS_SERVICE", "TypeScript contract and injection token (api library)", "Contract the pages depend on")
  Component(http, "HttpEventsService", "Angular service (api library)", "HTTP implementation of EventsService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "EventsEndpoints", "ASP.NET Core minimal API", "Authenticated and anonymous calendar.ics routes")
  Component(h, "GetEventCalendarHandler", "Application query handler", "Visibility check, returns .ics")
  Component(ics, "IcsCalendarWriter", "Infrastructure service", "RFC 5545 writer")
  Component(ctx, "CommunityDbContext", "EF Core DbContext", "Events and RSVPs")
}
ContainerDb(db, "Community database", "PostgreSQL", "Events, RSVPs, notifications and outbox")
Rel(page, svc, "Gets calendarUrl")
Rel(svc, http, "Implemented by")
Rel(http, ep, "GET calendar.ics")
Rel(ep, h, "Dispatches GetEventCalendarQuery")
Rel(h, ics, "Writes with")
Rel(h, ctx, "Reads")
Rel(ctx, db, "SQL")
@enduml
