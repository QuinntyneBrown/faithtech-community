@startuml
title UML sequence behaviour — Open a public event share link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Anonymous visitor" as actor
box "Frontend — FaithTech Community web app (events library)" #E0F2FE
  participant "PublicEventPage" as page
  participant "HttpEventsService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "EventsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "GetPublicEventHandler" as h
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box

actor -> page : Open share link
page -> svc : getPublicEvent(id)
svc -> ep : GET /api/public/events/{id} (AllowAnonymous)
ep -> h : Send GetPublicEventQuery
h -> db : Load event
db --> h : Event
alt visibility is Public
  h --> ep : PublicEventDto
  ep --> svc : 200 OK
  svc --> page : Event
  page --> actor : Show event and guest RSVP form (L2-023)
else members-only
  h --> ep : NotPublic
  ep --> svc : 404 ProblemDetails
  svc --> page : Not public
  page --> actor : Redirect to sign in with return URL (L2-023)
end
@enduml
