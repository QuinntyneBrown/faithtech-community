@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Cancel events

Container_Boundary(spa, "Web app") {
  Component(page, "EventPage", "Angular page (events library)", "Offers cancel to event managers")
  Component(dlg, "CancelEventDialog", "CDK Dialog (events library)", "Reason and confirmation")
  Component(svc, "EventsService / EVENTS_SERVICE", "TypeScript contract and injection token (api library)", "Contract the pages depend on")
  Component(http, "HttpEventsService", "Angular service (api library)", "HTTP implementation of EventsService")
}
Container_Boundary(api, "Community API") {
  Component(ep, "EventsEndpoints", "ASP.NET Core minimal API", "Maps /api/events routes; no business logic")
  Component(h, "CancelEventHandler", "Application handler", "Authorize, cancel, notify RSVPs")
  Component(perm, "EventPermissions", "Application service", "Has(ManageEvents) and the override rule")
  Component(notif, "INotificationPublisher", "Application contract", "In-app notifications")
  Component(mail, "EmailSender", "Infrastructure service", "Cancellation emails")
  Component(ctx, "CommunityDbContext", "EF Core DbContext", "Events and RSVPs")
}
ContainerDb(db, "Community database", "PostgreSQL", "Events, RSVPs, notifications and outbox")
System_Ext(email, "Email provider", "SMTP/SendGrid delivery")
Rel(page, dlg, "Opens")
Rel(dlg, svc, "Calls cancelEvent")
Rel(svc, http, "Implemented by")
Rel(http, ep, "POST /api/events/{id}/cancel")
Rel(ep, h, "Dispatches CancelEventCommand")
Rel(h, perm, "Authorizes with")
Rel(h, notif, "Notifies members via")
Rel(h, mail, "Emails RSVPs via")
Rel(h, ctx, "Reads and writes")
Rel(ctx, db, "SQL")
Rel(mail, email, "SMTP")
@enduml
