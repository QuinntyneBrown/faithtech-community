@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Add and edit resources
Container_Boundary(web, "Web app") {
  Component(add, "AddResourceDialog", "CDK dialog (resources library)", "Upload files or Add a link; batch progress, refusals, retry")
  Component(edit, "EditResourceDialog", "CDK dialog (resources library)", "Edit details, visibility, Replace file")
  Component(ui, "ft-file-dropzone, ft-file-row, ft-tag-input", "components library", "Drop zone, file rows with progress, tag combobox")
  Component(svc, "HttpResourcesService", "Angular service (api library)", "add with upload progress events, addLink, update, replaceFile, tags")
}
Container_Boundary(api, "Community API") {
  Component(ep, "ResourcesEndpoints", "ASP.NET Core minimal API", "POST /api/resources, POST /links, PUT /{id}, PUT /{id}/file")
  Component(val, "ResourceFieldRules", "Application", "Title, description, type, tags, visibility, https link")
  Component(addh, "AddResourcesHandler", "Application handler", "1-20 files, Has(AddResources), verified email")
  Component(linkh, "AddLinkHandler", "Application handler", "One https link")
  Component(edith, "EditResourceHandler", "Application handler", "Owner or AdministerOrganisation; Touch; audit override")
  Component(reph, "ReplaceFileHandler", "Application handler", "New blob, delete old, FileReplacedAt")
  Component(types, "ResourceFileTypes", "Application rule", "Extensions, 100 MB, signature, type guess")
  Component(acc, "ResourceAccess", "Application permission rule", "Has(AddResources), CanEdit, IsOverride")
  Component(share, "ShareNotifier", "Application service", "ResourceShared to new recipients (resources/share)")
  Component(retry, "ResourceStorageRetryHandler", "Application handler", "Retries ResourceBlobTask Save and Delete")
  Component(img, "SkiaImageProcessor", "Implements IImageProcessor", "ThumbnailAsync: 480 px PNG")
  Component(store, "AzureBlobFileStorage", "Implements IFileStorage", "resources container")
  Component(audit, "AuditLog", "Implements IAuditLog", "resource.edited, resource.file.replaced")
  ComponentDb(db, "CommunityDbContext", "PostgreSQL", "Resources and ResourceBlobTasks")
}
Rel(add, ui, "Composes")
Rel(edit, ui, "Composes")
Rel(add, svc, "add, addLink, tags")
Rel(edit, svc, "update, replaceFile, tags")
Rel(svc, ep, "Sends request", "multipart or JSON/HTTPS")
Rel(ep, val, "Validates (400)")
Rel(ep, addh, "Calls")
Rel(ep, linkh, "Calls")
Rel(ep, edith, "Calls")
Rel(ep, reph, "Calls")
Rel(addh, types, "Checks each file")
Rel(reph, types, "Checks the file")
Rel(addh, acc, "Has(AddResources)")
Rel(linkh, acc, "Has(AddResources)")
Rel(edith, acc, "CanEdit")
Rel(reph, acc, "CanEdit")
Rel(addh, img, "Thumbnail for images")
Rel(reph, img, "Thumbnail for images")
Rel(addh, store, "SaveAsync")
Rel(reph, store, "SaveAsync, DeleteAsync")
Rel(addh, share, "Notify on Shared")
Rel(edith, share, "Notify new recipients")
Rel(edith, audit, "Override")
Rel(reph, audit, "Override")
Rel(retry, store, "Retries")
Rel(addh, db, "Resource + ResourceBlobTask in one save", "EF Core")
@enduml
