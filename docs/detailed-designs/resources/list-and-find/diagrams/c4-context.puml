@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — List and find resources
Person(member, "Signed-in member", "Any member of the organisation: finds, opens and downloads the resources visible to them")
Person(contrib, "Member with AddResources", "Adds resources and owns them")
Person(admin, "Administrator", "Holds AdministerOrganisation: opens any resource by override, audited")
System(community, "Community platform", "Community site for an organisation's members and partners")
System_Ext(blob, "Azure Blob Storage", "Private resources container: files and image thumbnails")
Rel(member, community, "Browses, filters, searches, opens and downloads resources using")
Rel(contrib, community, "Finds their own and everyone's visible resources using")
Rel(admin, community, "Opens Private and Shared resources by override using")
Rel(community, blob, "Streams files and thumbnails from", "HTTPS")
@enduml
