@startuml
title UML sequence behaviour — Transfer ownership of a resource
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "System Admin" as actor
box "Frontend — FaithTech Community web app (resources library)" #E0F2FE
  participant "TransferOwnershipDialog" as dlg
  participant "HttpResourcesService" as svc
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "ResourcesEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ResourceMembersHandler" as mem
  participant "TransferOwnershipHandler" as h
  participant "INotificationPublisher" as pub
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Community database" as db
end box
actor -> dlg : Transfer ownership on /resources/{id}
dlg --> actor : "Hand {title} to another member…", New owner picker (L2-064 AC3)
actor -> dlg : Type "da"
dlg -> svc : ownerCandidates("da")
svc -> ep : GET /api/resources/owner-candidates?q=da
ep -> mem : OwnerCandidatesAsync("da")
alt not System Admin
  ep --> svc : 403 (AC7)
else System Admin
  mem -> db : Active members holding a contributing role
  ep --> svc : 200 [ResourceMemberDto]
end
dlg --> actor : "Members who can own resources": Daniel Reyes · City Lead · Austin
actor -> dlg : Pick Daniel; Transfer to Daniel Reyes
dlg --> actor : "Transferring…"
dlg -> svc : transfer(id, danielId)
svc -> ep : PUT /api/resources/{id}/owner {ownerId}
ep -> h : TransferAsync(id, command)
alt caller is not System Admin
  ep --> svc : 403 (AC7)
else no owner chosen
  ep --> svc : 400 "Choose who should own it." (AC4)
else target is not an active contributor
  ep --> svc : 400 (AC4)
else resource missing
  ep --> svc : 404
else valid
  h -> h : TransferTo(danielId); Touch (visibility, audience, tags and file unchanged)
  h -> audit : resource.owner.transferred {before: old owner, after: Daniel}
  h -> pub : PublishAsync([Daniel], ResourceOwnershipTransferred,\n"{Admin} made you the owner of {title}", /resources/{id}, admin, email)
  h -> db : One save (L2-064 AC5)
  ep --> svc : 200 ResourceDto
  dlg --> actor : Close; owner row shows Daniel Reyes
end
alt request failed
  dlg --> actor : "Ownership not transferred", "{Owner} is still the owner — try again." (AC6)
end
@enduml
