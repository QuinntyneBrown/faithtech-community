@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send an announcement
Person(comms, "Communications Lead", "Sends announcements")
System_Boundary(ftc, "FaithTech Community") {
  Container(web, "Web app", "Angular", "Shell, announcements feature library, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "FaithTech.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Persistent community data")
}
System_Ext(email, "Email provider", "SMTP/SendGrid")
Rel(comms, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, email, "Sends email via", "SMTP")
@enduml
