@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send an announcement
Container_Boundary(api, "Community API") {
  Component(ep, "AnnouncementsEndpoints", "Minimal API", "Maps /api/announcements routes")
  Component(val, "SendAnnouncementValidator", "Validator", "Subject, body and AudienceRequest")
  Component(send, "SendAnnouncementHandler", "Application handler", "CountAsync and SendAsync: authorizes, stores and fans out")
  Component(access, "AnnouncementAccess", "Application service", "CanSend: Has(SendAnnouncements)")
  Component(aud, "AudienceResolver", "Application service", "Resolves audience to recipient ids within the organisation")
  Component(pub, "INotificationPublisher", "Application service", "In-app notification and email")
  ComponentDb(db, "CommunityDbContext", "EF Core", "announcements, recipients, outbox")
}
Rel(ep, val, "Validates with")
Rel(ep, send, "CountAsync(AudienceRequest) / SendAsync(SendAnnouncementCommand)")
Rel(send, access, "Checks CanSend")
Rel(send, aud, "Resolves recipients")
Rel(aud, db, "Queries members")
Rel(send, pub, "PublishAsync for all recipients")
Rel(send, db, "Stores Announcement")
@enduml
