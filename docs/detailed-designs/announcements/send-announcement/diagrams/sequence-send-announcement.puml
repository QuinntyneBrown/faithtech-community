@startuml
title UML sequence behaviour — Send an announcement
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member with SendAnnouncements" as actor
box "Frontend — Community web app (announcements library)" #E0F2FE
  participant "ComposeAnnouncementPage" as page
  participant "HttpAnnouncementsService" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AnnouncementsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "SendAnnouncementHandler" as h
  participant "AudienceResolver" as aud
  participant "INotificationPublisher" as pub
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Choose audience
page -> client : countRecipients(audience)
client -> ep : POST /api/announcements/recipient-count
ep -> ep : AudienceRequestValidator
ep -> h : CountAsync(AudienceRequest)
h -> h : AnnouncementAccess.CanSend: Has(SendAnnouncements), else 403
h -> aud : FromRequestAsync, RecipientIds
aud -> db : Count active members in audience within the organisation
db --> h : n
h --> ep : Ok, n
ep --> client : 200 { count }
client --> page : Show recipient count (L2-029 #4)
actor -> page : Send
page -> client : send({ subject, body, audience, alsoEmail })
client -> ep : POST /api/announcements
alt empty subject or body (SendAnnouncementValidator)
  ep --> client : 400 ProblemDetails per field
  client --> page : Inline errors (L2-029 #2)
else valid
  ep -> h : SendAsync(SendAnnouncementCommand)
  alt caller lacks SendAnnouncements
    h --> ep : Forbidden
    ep --> client : 403 (L2-029 #3)
  else authorized
    h -> aud : FromRequestAsync, RecipientIds
    aud -> db : Query active members in audience (role definitions resolved live, L2-029 #1)
    db --> h : Recipient ids
    h -> db : Add Announcement with AnnouncementRecipient rows
    h -> pub : PublishAsync(recipients, Announcement, ...) (L2-029 #1)
    pub -> db : Add Notification per recipient;\nenqueue email with unsubscribe link unless opted out
    h -> db : Save changes (one save)
    h --> ep : AnnouncementSent
    ep --> client : 201 { id, recipientCount, emailCount }
    client --> page : Sent confirmation
  end
end
page --> actor : Result
@enduml
