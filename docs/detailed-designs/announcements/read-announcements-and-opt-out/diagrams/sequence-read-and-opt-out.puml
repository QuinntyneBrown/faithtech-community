@startuml
title UML sequence behaviour — Read announcements and opt out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Community web app (announcements and notifications libraries)" #E0F2FE
  participant "AnnouncementsPage / SettingsPage" as page
  participant "HttpAnnouncementsService" as client
end box
box "Backend — FaithTech.Community.Api" #D1FADF
  participant "AnnouncementsEndpoints" as ep
end box
box "Backend — FaithTech.Community.Application and Domain" #ECFDF3
  participant "ListMyAnnouncementsHandler" as list
  participant "AnnouncementEmailOptOutHandler" as opt
end box
box "Backend — FaithTech.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> page : Open announcements
page -> client : list()
client -> ep : GET /api/announcements?page=1
ep -> list : ListAsync(page)
list -> db : Recipients include caller or caller sent it, within the organisation (global filter),\norder by SentAt desc, 25 a page (L2-030 #1)
db --> list : Page
list --> ep : PagedResult<AnnouncementListItem>
ep --> client : 200
client --> page : Render list
actor -> page : Turn off announcement emails in settings
page -> client : setEmailOptOut(true)
client -> ep : PUT /api/me/announcement-email-opt-out
ep -> opt : SetAsync({ optedOut: true })
opt -> db : Update Profile.AnnouncementEmailsOptedOut (L2-030 #2)
db --> opt : Saved
opt --> ep : Ok
ep --> client : 204
client --> page : Preference saved
page --> actor : Toast announced
@enduml
