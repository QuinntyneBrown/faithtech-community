@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Read announcements and opt out
class Profile {
  +Guid Id
  +bool AnnouncementEmailsOptedOut
  +SetAnnouncementEmailOptOut(value: bool): void
}
class Announcement {
  +Guid Id
  +string Subject
  +string Body
  +DateTimeOffset SentAt
}
class AnnouncementRecipient {
  +Guid AnnouncementId
  +Guid ProfileId
}
class ListMyAnnouncementsHandler {
  +ListAsync(page: int): Task<PagedResult<AnnouncementListItem>>
}
class AnnouncementEmailOptOutHandler {
  +GetAsync(): Task<AnnouncementEmailOptOut>
  +SetAsync(c: AnnouncementEmailOptOut): Task<Result>
}
class UnsubscribeCommand <<record>> {
  +string? Token
}
class UnsubscribeHandler {
  +UnsubscribeAsync(c: UnsubscribeCommand): Task<Result>
}
interface IUnsubscribeTokens {
  +Issue(profileId: Guid): string
  +Read(token: string?): Guid?
}
class DataProtectionUnsubscribeTokens
Announcement "1" *-- "*" AnnouncementRecipient
AnnouncementRecipient --> Profile
ListMyAnnouncementsHandler ..> AnnouncementRecipient : queries
AnnouncementEmailOptOutHandler --> Profile : reads / mutates
UnsubscribeHandler ..> UnsubscribeCommand : handles
UnsubscribeHandler --> Profile : mutates
UnsubscribeHandler ..> IUnsubscribeTokens : uses
DataProtectionUnsubscribeTokens ..|> IUnsubscribeTokens
@enduml
